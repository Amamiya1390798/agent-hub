    text = out.strip()
    try:
        d = json.loads(text)
    except ValueError:
        d = None
    if isinstance(d, dict) and "result" in d:
        if d.get("is_error"):
            raise BackendError("claude 出错：%s" % _tail(str(d.get("result") or d.get("subtype") or text)))
        text = str(d.get("result") or "").strip()
        u = d.get("usage") if isinstance(d.get("usage"), dict) else {}
        _ctx.tokens = {"in": int(u.get("input_tokens") or 0) + int(u.get("cache_creation_input_tokens") or 0),  # 写进缓存的也是新算的
                       "out": int(u.get("output_tokens") or 0),
                       "cache": int(u.get("cache_read_input_tokens") or 0)}
        if d.get("session_id"):
            _ctx.session = {"id": str(d["session_id"]), "app": "Claude Code",
                            "resume": "cd %s && %s --resume %s" % (shq(cwd), shq(exe), shq(str(d["session_id"])))}
    not_logged = len(text) < 200 and ("Not logged in" in text or "Please run /login" in text)
    if rc != 0 or not text or not_logged:
        hint = "（未登录：请在终端运行一次 claude 并执行 /login）" if not_logged else ""
        raise BackendError("claude rc=%s%s：%s" % (rc, hint, _tail((err + "\n" + text).strip())))
    return text


