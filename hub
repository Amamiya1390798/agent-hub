_SHELL_PATH = {}


def login_shell_path():
    """用户终端里的 PATH。从 Hub.app、访达或开机启动时进程拿到的 PATH 很短（常常只有 /usr/bin:/bin），
    装在 Homebrew、npm 全局目录等处的命令行就找不到，所以问一次登录 shell 并缓存。"""
    if "v" not in _SHELL_PATH:
        v = ""
        sh = os.environ.get("SHELL") or "/bin/zsh"
        if os.path.isfile(sh) and not os.environ.get("HUB_NO_SHELL_PATH"):
            try:
                out = subprocess.run([sh, "-lic", "printf '__HUBPATH__%s__HUBPATH__' \"$PATH\""], stdin=subprocess.DEVNULL,
                                     capture_output=True, text=True, timeout=8).stdout
                m = re.search(r"__HUBPATH__(.*?)__HUBPATH__", out or "", re.S)
                v = m.group(1).strip() if m else ""
            except (OSError, subprocess.SubprocessError):
                v = ""
        _SHELL_PATH["v"] = v
    return _SHELL_PATH["v"]


