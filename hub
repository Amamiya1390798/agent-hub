        cmd += ["--allowedTools", "WebSearch", "WebFetch"]
    if cfg.get("_resume"):
        cmd += ["--resume", cfg["_resume"]]
    if cfg.get("_images"):
        cmd += ["--add-dir", ATTACH_DIR]
    cmd += ["--output-format", "json"]  # 拿到会话编号，下次追问能续接
    watch = Watchdog(cfg, timeout, streaming=False)
    env = clean_env()
    if int(cfg.get("compact_claude") or 0) > 0:  # 会话到这么长左右就让它自己压缩
        env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(int(cfg["compact_claude"]))
