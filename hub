STOP_MSG = "已手动停止"
DEAD_MSG = "已中断（进程不在了）"


def pid_alive(pid):
    try:
        if int(pid) <= 1:
            return False
        os.kill(int(pid), 0)
        return True
    except (OSError, TypeError, ValueError):
        return False


def load_calls(limit=400):
    try:
        names = [n for n in os.listdir(CALLS_DIR) if n.endswith(".json")]
    except OSError:
        return []
    paths = [os.path.join(CALLS_DIR, n) for n in names]
    paths.sort(key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0, reverse=True)
    out = []
    for p in paths[:limit]:
        c = read_json(p)
        if not isinstance(c, dict) or "id" not in c:
            continue
        if c.get("status") == "running" and not pid_alive(c.get("pid")):
            c.update(status="fail", error=DEAD_MSG, end=c.get("end") or os.path.getmtime(p))
            write_json(p, c)  # 落盘，免得日后 PID 被别的进程复用时“复活”
        out.append(c)
    out.sort(key=lambda c: c.get("start") or 0, reverse=True)
    return out


def load_runs(limit=40):
    try:
        ids = sorted(os.listdir(RUNS_DIR), reverse=True)
    except OSError:
        return []
    out = []
    for rid in ids:
        r = read_json(os.path.join(RUNS_DIR, rid, "run.json"))
        if not isinstance(r, dict):
            continue
        if r.get("status") in ("planning", "running", "synthesizing") and not pid_alive(r.get("pid")):
            r.update(status="failed", error=r.get("error") or DEAD_MSG, end=r.get("end") or r.get("start"))
            for t in r.get("tasks") or []:
                if t.get("status") in ("pending", "running"):
                    t["status"] = "fail" if t["status"] == "running" else "skipped"
            write_json(os.path.join(RUNS_DIR, rid, "run.json"), r)
            write_board_md(os.path.join(RUNS_DIR, rid), r)
        out.append(r)
        if len(out) >= limit:
            break
    return out


def _preview(s, n=200):
