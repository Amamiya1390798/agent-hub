def _fail_tasks(rec):
    for t in rec.get("tasks") or []:
        if t.get("status") in ("pending", "running"):
            t["status"] = "fail" if t["status"] == "running" else "skipped"


@contextmanager
def _record_guard(get_record, save, failure):
    """异常继续抛给调用方，同时把已创建的记录收尾。"""
    try:
        yield
    except BaseException as e:
        rec = get_record()
        if (rec.get("status") in ("planning", "running", "synthesizing")
                or (failure == "failed" and rec.get("status") == "failed")):
            if failure == "failed":
                _fail_tasks(rec)
            error = STOP_MSG if isinstance(e, KeyboardInterrupt) else str(e) or type(e).__name__
            save(status=failure, error=rec.get("error") or error, end=time.time())
        raise


