def auto_title_one(cfg, key):
    """叫一位成员给一个项目组起名。直接调后端，不写调用记录，免得名字本身又变成一条记录。"""
    who = cfg.get("auto_title") or ""
    chain = cfg["agents"].get(who) or []
    kind, _, rid = key.partition(":")
    r = ui_record(kind, rid) or {}
    q = r.get("display") or r.get("goal") or r.get("prompt") or ""
    a = r.get("final") or r.get("answer") or ""
    if not q or not chain:
        return
    prompt = TITLE_PROMPT % (q[:1500], a[:1500])
    for spec in chain[:2]:
        bk, _, mdl = spec.partition(":")
        fn = BACKENDS.get(bk)
        if not fn:
            continue
        try:
            t = clean_title(fn(dict(cfg, _effort=""), mdl, prompt, tempfile.gettempdir(), False, 180))
        except (BackendError, OSError):
            continue
        if t:
            set_name(key, t, auto=True)
            return
    with _names_lock:
        d = load_names_raw()
        d["failed"][key] = d["failed"].get(key, 0) + 1
        write_json(NAMES_PATH, d)


def start_auto_titles(cfg, calls, runs):
    if not cfg.get("auto_title") or _names_running.is_set() or os.environ.get("HUB_NO_AUTOTITLE") == "1":  # 离线测试里不真的叫模型
        return
    keys = title_candidates(calls, runs)[:20]
    if not keys:
        return
    _names_running.set()

    def work():
        try:
            for k in keys:
                auto_title_one(cfg, k)
        finally:
            _names_running.clear()
    threading.Thread(target=work, daemon=True).start()


ARCHIVE_PATH = os.path.join(HUB_HOME, "archived.json")
