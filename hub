def _iso_to_epoch(sv):
    from datetime import datetime, timezone
    try:
        dt = datetime.fromisoformat(sv.strip().replace("Z", "+00:00"))
        return (dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)).timestamp()
    except (ValueError, TypeError, AttributeError):
        return None


def quota_agy(cfg):
    """Antigravity 自带的额度查询（不消耗模型额度）。"""
    exe = find_bin(cfg, "agy")
    if not exe:
        return None
    try:
        rc, out, err = _run([exe, "--print=/usage", "--print-timeout", "40s"], tempfile.gettempdir(), clean_env(), 60)
    except BackendError:
        return None
    if rc != 0:
        return None
    wins = []
    for line in out.splitlines():
        p = [x.strip() for x in line.split("\t")]
        if len(p) >= 4 and p[0].lower().startswith("gemini") and p[2].endswith("%"):
            try:
                pct = float(p[2].rstrip("%"))
                if not 0 <= pct <= 100:
                    continue
            except ValueError:
                continue
            wins.append({"label": "5 小时" if "five" in p[1].lower() else "本周" if "week" in p[1].lower() else p[1],
                         "remaining": pct, "resets": _iso_to_epoch(p[3])})
    wins.sort(key=lambda w: 0 if w["label"] == "5 小时" else 1)
    return {"windows": wins, "ts": time.time()} if wins else None


def quota_codex():
    """读最近会话里的真实限额事件，忽略空限额和坏行。"""
    files = glob.glob(os.path.join(HOME, ".codex/sessions/*/*/*/*.jsonl"))
    files.sort(key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0, reverse=True)
    latest = None
    for p in files[:8]:
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                lines = f.readlines()
            mtime = os.path.getmtime(p)
        except OSError:
            continue
        for line in reversed(lines):
            if '"rate_limits"' not in line:
                continue
            try:
                event = json.loads(line)
                payload = event.get("payload") or event
                rl = payload.get("rate_limits")
                if not isinstance(rl, dict):
                    continue
                ts = _iso_to_epoch(event.get("timestamp")) or mtime
                wins, now = [], time.time()
                for key in ("primary", "secondary"):
                    w = rl.get(key)
                    if not isinstance(w, dict) or w.get("used_percent") is None:
                        continue
                    used = float(w["used_percent"])
                    if not 0 <= used <= 100:
                        continue
                    mins = int(w.get("window_minutes") or 0)
                    resets = float(w["resets_at"]) if w.get("resets_at") else None
                    remaining = 100.0 if resets and resets < now else 100.0 - used
                    wins.append({"label": "5 小时" if mins == 300 else "本周" if mins == 10080 else "%d 分钟" % mins,
                                 "remaining": remaining, "resets": resets if resets and resets > now else None})
                if wins:
                    if latest is None or ts > latest["ts"]:
                        latest = {"windows": wins, "ts": ts}
                    break
            except (ValueError, TypeError, AttributeError, OverflowError):
                continue
    return latest


def quota_ds():
    """DeepSeek 官方余额接口。密钥只在本机读取、只发给 api.deepseek.com。"""
    import urllib.error
    import urllib.request
    key = os.environ.get("DEEPSEEK_API_KEY")
    for p in (os.path.join(HUB_HOME, ".env"), os.path.join(HOME, ".dsh", ".env")):
        if key:
            break
        try:
            with open(p, encoding="utf-8") as f:
                for line in f:
                    if line.strip().startswith("DEEPSEEK_API_KEY="):
                        key = line.split("=", 1)[1].strip().strip('"').strip("'")
        except OSError:
            pass
    if not key:
        return {"note": "按量付费。想在这里看余额：把 DEEPSEEK_API_KEY=你的密钥 写进 ~/.agent-hub/.env"}
    try:
        req = urllib.request.Request("https://api.deepseek.com/user/balance",
                                     headers={"Authorization": "Bearer " + key, "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=20) as r:
            d = json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        if e.code == 401:
            return {"note": "余额读不到：现有的 DeepSeek 密钥已失效。把新的写进 ~/.agent-hub/.env 即可。"}
        return {"note": "余额读不到（HTTP %s）" % e.code}
    except (OSError, ValueError) as e:
        return {"note": "余额读不到：%s" % str(e)[:80]}
    infos = d.get("balance_infos") or []
    sym = {"CNY": "¥", "USD": "$"}
    bal = "  ".join("%s%s" % (sym.get(i.get("currency"), (i.get("currency") or "") + " "), i.get("total_balance"))
                    for i in infos if isinstance(i, dict))
    return {"balance": bal or "0", "available": bool(d.get("is_available")), "ts": time.time()}


