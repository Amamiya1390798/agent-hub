_SECRET_NAME = re.compile(r"(secret|token|passw|credential|private|id_rsa|id_ed25519|\.pem$|\.p12$|\.key$|api[_-]?key|\.env)", re.I)


def file_target(path, rec=None):
    """把回答里提到的文件（file:// 链接、绝对路径、~ 开头或相对路径）落到本机真实路径。
    只认家目录里的、不在隐藏目录里的、名字不像密钥的；找不到就返回 None。"""
    if not isinstance(path, str) or not path.strip() or len(path) > 2000:
        return None
    p = path.strip()
    if p.lower().startswith("file://"):
        p = unquote(urlparse(p).path)
    p = p.split("#")[0]
    p = os.path.expanduser(p)
    if not os.path.isabs(p):
        bases = [b for b in ((rec or {}).get("cwd"), UI_WORKSPACE) if isinstance(b, str) and b]
        p = next((os.path.join(b, p) for b in bases if os.path.exists(os.path.join(b, p))), os.path.join(bases[0] if bases else UI_WORKSPACE, p))
    p = os.path.realpath(p)
    home, hub_home = os.path.realpath(HOME), os.path.realpath(HUB_HOME)
    if not os.path.exists(p) or not (p == home or p.startswith(home + os.sep)):
        return None
    inside_hub = p.startswith(os.path.join(hub_home, "workspace") + os.sep) or p.startswith(os.path.realpath(RUNS_DIR) + os.sep)
    rel = os.path.relpath(p, home)
    if not inside_hub and any(part.startswith(".") for part in rel.split(os.sep)):
        return None
    if p.startswith(hub_home + os.sep) and not inside_hub:
        return None
    if os.path.isfile(p) and _SECRET_NAME.search(os.path.basename(p)):
        return None
    return p


def file_view(path, rec=None):
    """给面板里的查看窗用：文字文件返回内容，图片只说明是图片。"""
    p = file_target(path, rec)
    if not p:
        raise ValueError("找不到这个文件，或者它不在能看的范围里")
    name = os.path.basename(p) or p
    if os.path.isdir(p):
        items = sorted(x for x in os.listdir(p) if not x.startswith("."))[:300]
        return {"ok": True, "kind": "dir", "name": name, "path": p, "items": [x + ("/" if os.path.isdir(os.path.join(p, x)) else "") for x in items]}
    ext = os.path.splitext(p)[1].lower()
    if ext in FILE_IMG_EXT:
        return {"ok": True, "kind": "image", "name": name, "path": p}
    if ext in FILE_TEXT_EXT:
        if os.path.getsize(p) > 2 * 1024 * 1024:
            return {"ok": True, "kind": "big", "name": name, "path": p}
        with open(p, "rb") as f:
            text = f.read().decode("utf-8", "replace")
        return {"ok": True, "kind": "md" if ext in (".md", ".markdown") else "text", "name": name, "path": p, "text": text}
    return {"ok": True, "kind": "other", "name": name, "path": p}


def ui_record(kind, rid):
    return ui_run(rid) if kind == "run" else ui_call(rid) if kind == "call" else None


def conversation_ref(kind, rid):
    if kind == "run" and isinstance(rid, str) and re.fullmatch(r"[0-9]{8}-[0-9]{6}x*", rid):
        parent = (read_json(os.path.join(RUNS_DIR, rid, "run.json")) or {}).get("parent_call")
        if parent:
            return "call", parent
    return kind, rid


def follow_context(kind, rid, depth=8, *, labelled=True):
    """保留最近多轮问答，按时间顺序提供；旧记录无需迁移。depth=1 时只带这一条。"""
    turns, seen = [], set()
    for _ in range(max(1, min(8, depth))):
        kind, rid = conversation_ref(kind, rid)
        if (kind, rid) in seen:
            break
        seen.add((kind, rid))
        r = ui_record(kind, rid)
        if not r:
            break
        q = r.get("display") or r.get("goal") or r.get("prompt") or ""
        a = r.get("final") or r.get("answer") or ""
        if not a and kind == "run":
            a = "\n\n".join("【%s】%s" % (t.get("title"), t.get("answer") or "") for t in r.get("tasks") or [])
        hand = r.get("kind") == "handoff"
        if turns and len(a) > 1500 and not hand:  # 只有最近一轮带全文；更早的只留开头（交接/压缩说明除外，它们本来就是精简过的）
            a = a[:1500].rstrip() + "\n…（较早的内容已省略）"
        turns.append("【用户当时的要求】\n%s\n\n【当时得到的结果】\n%s" % (q[:6000] if not turns else q[:1500], a[:20000 if hand else 12000]))
        if hand and (r.get("handoff") or {}).get("compact"):
            break  # 压缩点：更早的都已经压进这份说明里了
        follows = r.get("follows") or {}
        kind, rid = follows.get("type"), follows.get("id")
        if not rid:
            break
    if not turns:
        return ""
    body = "\n\n".join(reversed(turns))
    return "===== 之前的对话（背景）=====\n" + body + "\n\n===== 用户现在的追问 =====\n" if labelled else body.strip()


DIGEST_PROMPT = """把以下项目组往来整理成一份交接说明，让接手的人知道目标、当前进度、已定事项、成果在哪里、试过哪些办法、接下来要做什么。保留会影响后续工作的用户偏好、数字、路径和链接。有冲突时以较新的决定为准。篇幅以便于接手为准，约 3000 字以内。

=====
{body}"""


def handoff_digest_text(keys):
    """把一组里每一轮的要求和结果按顺序拼起来，给压缩用。太长时只留最近的部分。"""
    parts = []
    for i, k in enumerate(keys, 1):
        kind, _, rid = k.partition(":")
        r = ui_record(kind, rid) or {}
        if kind == "run":
            q, a = r.get("display") or r.get("goal") or "", r.get("final") or ""
            if not a and r.get("tasks"):
                a = "\n".join("- %s：%s" % (t.get("title") or t.get("id"), _preview(t.get("answer") or "", 400)) for t in r["tasks"])
        elif r.get("kind") == "handoff":
            q, a = "（从别的项目组交接进来的内容）", r.get("answer") or ""
        else:
            q, a = r.get("display") or r.get("prompt") or "", r.get("answer") or ""
        if q or a:
            parts.append("【第 %d 轮】\n用户：%s\n结果：%s" % (i, q[:3000], a[:8000]))
    text = "\n\n".join(parts)
    if len(text) > 400000:
        text = "（太早的内容已省略）\n\n" + text[-400000:]
    return text


def _digest_handoff(cfg, cid, keys):
    """后台把整组压缩成交接说明，写回那条交接记录；失败就保留原来的最近几轮内容。"""
    path = os.path.join(CALLS_DIR, cid + ".json")
    who = cfg.get("handoff_by") if cfg.get("handoff_by") in cfg["agents"] else ("gemini" if "gemini" in cfg["agents"] else cfg.get("synthesizer"))
    chain, eff = tier_chain(cfg, who, "digest")
    chain = chain[:3]
    prompt = DIGEST_PROMPT.format(body=handoff_digest_text(keys))
    out, used, err = None, None, ""
    for spec in chain:
        bk, _, mdl = spec.partition(":")
        fn = BACKENDS.get(bk)
        if not fn:
            continue
        try:
            out = (fn(dict(cfg, _effort=eff if eff in effort_levels(spec) else ""), mdl, prompt, tempfile.gettempdir(), False, 900) or "").strip()
            used = spec
            if out:
                break
        except (BackendError, OSError) as e:
            err = str(e)
    rec = read_json(path)
    if not rec:
        return
    if out:
        name = (rec.get("handoff") or {}).get("name") or ""
        rec["answer"] = (("以下是本组前面 %d 轮的压缩说明，后面接着做时以它为准：\n\n%s" % (len(keys), out)) if rec["handoff"].get("compact") else
                         "以下是从另一个项目组「%s」交接过来的说明（整组 %d 轮压缩而成），供后面参考：\n\n%s" % (name, len(keys), out))
        rec["handoff"]["digest"] = "ok"
        rec["handoff"]["digest_by"] = used
    else:
        rec["handoff"]["digest"] = "fail"
        rec["handoff"]["digest_error"] = explain_error(err)[0] if err else "没有可用的成员"
    write_json(path, rec)


def make_handoff(src, dst, title="", keys=None, cfg=None):
    """把一个项目组做出来的东西交接到另一个项目组：在目标那条线后面加一条「交接」记录，
    内容是来源那组最近几轮的要求和结果（不调用模型）。之后在目标组接着问，就会带上它。"""
    for ref in (src, dst):
        if not isinstance(ref, dict) or ref.get("type") not in ("call", "run") or not _ARCHIVE_KEY.match("%s:%s" % (ref.get("type"), ref.get("id"))):
            raise ValueError("记录不对")
    if (src["type"], src["id"]) == (dst["type"], dst["id"]):
        raise ValueError("不能交接给自己")
    s, d = ui_record(src["type"], src["id"]), ui_record(dst["type"], dst["id"])
    if not s or not d:
        raise ValueError("找不到要交接的记录")
    if s.get("status") in RUN_ACTIVE:
        raise ValueError("来源那组还没做完，做完再交接")
    body = follow_context(src["type"], src["id"], labelled=False)
    if not body:
        raise ValueError("来源那组还没有可交接的内容")
    name = re.sub(r"[\x00-\x1f\x7f]", "", str(title or ""))[:60] or (s.get("display") or s.get("goal") or "")[:40]
    keys = [k for k in keys if isinstance(k, str) and _ARCHIVE_KEY.match(k)][:600] if isinstance(keys, list) and cfg else []
    return _save_transfer(dst, d, "交接：" + name, "交接：把「%s」的结果交到这里" % name,
                          "以下是从另一个项目组「%s」交接过来的要求和结果，供后面参考：\n\n%s" % (name, body),
                          {"from": {"type": src["type"], "id": src["id"]}, "name": name}, cfg, keys)


def make_compact(at, keys, cfg, title=""):
    """在最后一轮后加一条压缩记录，之后追问从这份说明开始。"""
    if not isinstance(at, dict) or at.get("type") not in ("call", "run") or not _ARCHIVE_KEY.match("%s:%s" % (at.get("type"), at.get("id"))):
        raise ValueError("记录不对")
    r = ui_record(at["type"], at["id"])
    if not r:
        raise ValueError("找不到这条记录")
    if r.get("status") in RUN_ACTIVE:
        raise ValueError("最后一轮还在做，做完再压缩")
    keys = [k for k in (keys or []) if isinstance(k, str) and _ARCHIVE_KEY.match(k)][:600]
    if len(keys) < 2:
        raise ValueError("这一组才一两轮，不用压缩")
    body = follow_context(at["type"], at["id"], labelled=False)
    name = re.sub(r"[\x00-\x1f\x7f]", "", str(title or ""))[:60]
    return _save_transfer(at, r, "压缩：" + (name or "前面的来往"), "压缩：把前面 %d 轮压成一份说明" % len(keys),
                          "以下是本组最近几轮的要求和结果（整组压缩还没完成时先用它）：\n\n%s" % body,
                          {"from": None, "name": name, "compact": True}, cfg, keys)


def _save_transfer(target, record, title, display, answer, handoff, cfg, keys):
    cid = "c_" + uuid.uuid4().hex[:10]
    now = time.time()
    if keys:
        handoff.update(digest="running", rounds=len(keys))
    write_json(os.path.join(CALLS_DIR, cid + ".json"), {
        "id": cid, "parent": None, "run": None, "task": None, "kind": "handoff", "title": title,
        "agent": "-", "backend": "-", "preferred_backend": "-", "status": "ok", "start": now, "end": now, "secs": 0,
        "write": False, "cwd": record.get("cwd") or UI_WORKSPACE, "prompt": "", "error": None, "attempts": [], "pid": None,
        "display": display, "answer": answer, "follows": {"type": target["type"], "id": target["id"]},
        "handoff": handoff})
    if keys:
        threading.Thread(target=_digest_handoff, args=(cfg, cid, keys), daemon=True).start()
    return cid


def undo_handoff(cid):
    """撤销一次交接：把那条「交接」记录挪走（改名留底，不真删），两组重新分开。
    交接之后已经接着问过的，改成直接接在交接之前那一轮后面。"""
    if not re.fullmatch(r"c_[0-9a-f]+", str(cid or "")):
        raise ValueError("记录不对")
    path = os.path.join(CALLS_DIR, cid + ".json")
    rec = read_json(path)
    if not rec or rec.get("kind") != "handoff":
        raise ValueError("这不是一条交接记录")
    up = rec.get("follows")
    paths = [os.path.join(CALLS_DIR, n) for n in os.listdir(CALLS_DIR) if n.endswith(".json") and n != cid + ".json"]
    if os.path.isdir(RUNS_DIR):
        paths += [os.path.join(RUNS_DIR, n, "run.json") for n in os.listdir(RUNS_DIR)]
    for cp in paths:
        c = read_json(cp)
        f = c.get("follows") if isinstance(c, dict) else None
        if isinstance(f, dict) and f.get("type") == "call" and f.get("id") == cid:
            c["follows"] = up
            write_json(cp, c)
    os.replace(path, path + ".undone")
    with _root_lock:
        _ROOT_CACHE.clear()
    return up


_ROOT_CACHE = {}
_root_lock = threading.RLock()


def _rec_prev(key):
    """(这条记录在追问链上的上一条, 这条记录在不在)。分叉、新对话的上一条是 None。"""
    kind, _, rid = key.partition(":")
    if kind == "run" and re.fullmatch(r"[0-9]{8}-[0-9]{6}x*", rid):
        r = _run_records.read(os.path.join(RUNS_DIR, rid, "run.json"), shared=True)
        if isinstance(r, dict) and r.get("parent_call"):
            return "call:%s" % r["parent_call"], True
    elif kind == "call" and re.fullmatch(r"c_[0-9a-f]+", rid):
        r = _call_records.read(os.path.join(CALLS_DIR, rid + ".json"), shared=True)
    else:
        return None, False
    if not isinstance(r, dict):
        return None, False
    f = r.get("follows")
    if r.get("fork") or not isinstance(f, dict) or f.get("type") not in ("call", "run") or not f.get("id"):
        return None, True
    return "%s:%s" % (f["type"], f["id"]), True


def group_root(key):
    """项目组的开头一轮（顺着追问链往前找到头）。名字、文件夹都记在它上面：
    面板只加载最近几百条记录，长对话的开头会掉出去，不能按「面板里看得到的最早一条」来记。"""
    if not isinstance(key, str):
        return key
    with _root_lock:
        if key in _ROOT_CACHE:
            return _ROOT_CACHE[key]
        path, cur, root = [], key, key
        while True:
            if cur in _ROOT_CACHE:
                root = _ROOT_CACHE[cur]
                break
            prev, ok = _rec_prev(cur)
            if not ok:  # 这一条找不到了：开头就是它后面那一条
                root = path[-1] if path else key
                break
            path.append(cur)
            if not prev or prev in path or len(path) > 5000:
                root = cur
                break
            cur = prev
        for k in path:
            _ROOT_CACHE[k] = root
        return root


_rekeyed = []


def rekey_to_roots():
    """早先的名字和文件夹可能记在长对话中间的某一轮上（那时它是面板里看得到的最早一条），挪到开头那一轮。
    同一组有好几个名字时：手动改的优先，都是手动的取最新的。"""
    with _names_lock:
        d = load_names_raw()
        moved = False
        for k in list(d["names"]):
            v, r = d["names"][k], group_root(k)
            if r == k or not isinstance(v, dict):
                continue
            cur = d["names"].get(r)
            if (not isinstance(cur, dict) or (cur.get("auto") and not v.get("auto"))
                    or (bool(cur.get("auto")) == bool(v.get("auto")) and (v.get("ts") or 0) > (cur.get("ts") or 0))):
                d["names"][r] = v
            del d["names"][k]
            moved = True
        if moved:
            write_json(NAMES_PATH, d)
    with _folders_lock:
        f = load_folders()
        moved = False
        for k in list(f["of"]):
            r = group_root(k)
            if r != k:
                f["of"][r] = f["of"].pop(k)
                moved = True
        if moved:
            write_json(FOLDERS_PATH, f)


