_ATT_NAME = re.compile(r"^att-[0-9]{8}-[0-9]{6}-[0-9a-f]{8}\.(png|jpg|webp|gif)$")
_IMG_SIGS = ((b"\x89PNG\r\n\x1a\n", "png"), (b"\xff\xd8\xff", "jpg"), (b"GIF87a", "gif"), (b"GIF89a", "gif"))
MAX_IMAGES = 6


def image_kind(data):
    for sig, ext in _IMG_SIGS:
        if data.startswith(sig):
            return ext
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "webp"
    return None


def save_attachment(data):
    """保存一张用户贴进来的图片，只认 PNG/JPEG/WebP/GIF；返回文件名。"""
    if not isinstance(data, bytes) or not data:
        raise ValueError("图片是空的")
    if len(data) > 10 * 1024 * 1024:
        raise ValueError("图片太大了（超过 10MB），请缩小后再贴")
    ext = image_kind(data)
    if not ext:
        raise ValueError("只支持 PNG、JPEG、WebP、GIF 图片")
    os.makedirs(ATTACH_DIR, exist_ok=True)
    name = "att-%s-%s.%s" % (time.strftime("%Y%m%d-%H%M%S"), uuid.uuid4().hex[:8], ext)
    with open(os.path.join(ATTACH_DIR, name), "wb") as f:
        f.write(data)
    return name


def attachment_path(name):
    if not isinstance(name, str) or not _ATT_NAME.match(name):
        return None
    p = os.path.join(ATTACH_DIR, name)
    return p if os.path.isfile(p) else None


def image_note(paths):
    """告诉模型图片在哪、怎么看。GPT 另外直接附图；DeepSeek 用 read_image；Gemini、Claude 用各自的看图/读文件工具。"""
