def agent_effort(cfg, agent, spec):
    """这位成员用这个模型时的思考档位；""=不指定。卡片上设过（哪怕设成默认）就以卡片为准，否则 GPT 沿用旧的 codex_effort。
    模型不支持这一档（比如换成了备用模型）就不传，让它用自己的默认。"""
    eff = cfg.get("effort") if isinstance(cfg.get("effort"), dict) else {}
    kind = (spec or "").partition(":")[0]
    if agent in eff:
        e = eff.get(agent) or ""
    else:
        e = (cfg.get("codex_effort") or "") if kind == "codex" else ""
    return e if e and e in effort_levels(spec) else ""


