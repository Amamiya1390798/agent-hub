def _dsh_parse_yaml_scalar(raw):
    s = raw.strip()
    if s == "true":
        return True
    if s == "false":
        return False
    if re.fullmatch(r"-?\d+", s):
        return int(s)
    if (len(s) >= 2) and ((s[0] == '"' and s[-1] == '"') or (s[0] == "'" and s[-1] == "'")):
        return s[1:-1]
    return s


def _dsh_read_patch_configs(path):
    """读取 cordis.patch.yml 中每个 `- id: <id>` 条目的顶层 config 标量值。"""
    out = {}
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.readlines()
    except OSError:
        return out
    cur_id, in_cfg, cfg_indent = None, False, 0
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        m_id = re.match(r"^-\s+id:\s*([^\s#]+)", line)
        if m_id:
            cur_id = _dsh_parse_yaml_scalar(m_id.group(1))
            in_cfg = False
            out.setdefault(cur_id, {})
            continue
        if line.startswith("-"):
            cur_id, in_cfg = None, False
            continue
        if cur_id is None:
            continue
        indent = len(line) - len(line.lstrip(" "))
        if re.match(r"^\s+config:\s*$", line):
            in_cfg = True
            cfg_indent = indent
            continue
        if in_cfg:
            if indent <= cfg_indent:
                in_cfg = False
                continue
            m_kv = re.match(r"^\s+([A-Za-z0-9_-]+):\s*(.+?)\s*$", line)
            if m_kv:
                val = m_kv.group(2).split(" #", 1)[0].strip()
                out[cur_id][m_kv.group(1)] = _dsh_parse_yaml_scalar(val)
    return out


def _dsh_write_patch_block(path, target_id, pkg_name, cfg_dict):
    """只更新 cordis.patch.yml 中指定 id 的块，保留文件里其他注释和用户手写条目。"""
    header = []
    blocks = []  # [(id_or_None, [lines])]
    try:
        with open(path, encoding="utf-8") as f:
            raw_lines = f.readlines()
    except OSError:
        raw_lines = []
    for line in raw_lines:
        if line.startswith("-"):
            match = re.match(r"^-\s+id:\s*([^\s#]+)", line)
            block_id = _dsh_parse_yaml_scalar(match.group(1)) if match else None
            blocks.append((block_id, [line]))
        elif blocks:
            blocks[-1][1].append(line)
        elif line.strip() != "[]":
            header.append(line)
    new_blk = None
    if cfg_dict:
        lines = ["- id: %s\n" % target_id, "  name: %s\n" % pkg_name, "  config:\n"]
        for k, v in cfg_dict.items():
            if isinstance(v, bool):
                sv = "true" if v else "false"
            elif isinstance(v, int):
                sv = str(v)
            else:
                sv = json.dumps(str(v), ensure_ascii=False)
            lines.append("    %s: %s\n" % (k, sv))
        new_blk = (target_id, lines)
    out_blocks = []
    for block_id, lines in blocks:
        if block_id != target_id:
            out_blocks.append((block_id, lines))
        elif new_blk is not None:
            out_blocks.append(new_blk)
    if new_blk is not None and not any(block_id == target_id for block_id, _ in blocks):
        out_blocks.append(new_blk)
    if not header:
        header = ["# Your patch layer for this dsh profile, applied after every bundle layer:\n"]
    text = "".join(header)
    if not text.endswith("\n"):
        text += "\n"
    text += "".join(line for _, block in out_blocks for line in block) if out_blocks else "[]\n"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def _dsh_atomic_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def dsh_plugins_state():
    """读取 DeepSeek (dsh headless) 插件同步状态与各插件二级开关。"""
    ps = _dsh_paths()
    h_pkg = read_json(ps["headless_pkg"]) or {}
    d_pkg = read_json(ps["desktop_pkg"]) or {}
    bundles = list(((h_pkg.get("dsh") or {}).get("profile") or {}).get("bundles") or [])
    patch_cfgs = _dsh_read_patch_configs(ps["headless_patch"])
    ft = read_json(ps["full_throttle"]) or {}

    def installed_in_desktop(name):
        return os.path.exists(os.path.join(ps["desktop_nm"], name))

    plugins = []
    for meta in DSH_KNOWN_PLUGINS:
        name = meta["name"]
        in_desk = installed_in_desktop(name)
        enabled = name in bundles
        opts = []
        for o in meta["options"]:
            if meta["kind"] == "full_throttle":
                val = ft.get(o["key"], o["default"])
            else:
                val = patch_cfgs.get(meta["cordis_id"], {}).get(o["key"], o["default"])
            opts.append(dict(o, value=val))
        plugins.append({
            "name": name,
            "title": meta["title"],
            "desc": meta["desc"],
            "installed": in_desk,
            "enabled": enabled,
            "options": opts,
        })

    deps = list((d_pkg.get("dependencies") or {}).keys())
    others = []
    for name in sorted(deps):
        if name in _DSH_KNOWN_MAP:
            continue
        others.append({
            "name": name,
            "installed": installed_in_desktop(name),
            "enabled": name in bundles,
            "ui_only": name in DSH_UI_ONLY_PLUGINS,
        })
    return {"ok": True, "plugins": plugins, "others": others}


def dsh_plugins_update(body):
    """同步/开关 headless 插件，或修改某个插件的二级开关/参数。"""
    with _dsh_plugins_lock:
        ps = _dsh_paths()
        action = body.get("action")
        if action == "toggle_bundle":
            name = str(body.get("name") or "").strip()
            on = body.get("on")
            if not _DSH_PKG_RE.match(name) or not isinstance(on, bool):
                raise ValueError("插件名或开关格式不对")
            if name in ("@deepseek-ai/dsh-base", "@deepseek-ai/dsh-headless"):
                raise ValueError("基础组件不能关闭")
            h_pkg = read_json(ps["headless_pkg"])
            if not isinstance(h_pkg, dict):
                raise ValueError("找不到 headless 的 package.json")
            bak = ps["headless_pkg"] + ".bak-hub"
            if not os.path.exists(bak):
                shutil.copy2(ps["headless_pkg"], bak)
            prof = h_pkg.setdefault("dsh", {}).setdefault("profile", {})
            bundles = list(prof.get("bundles") or [])
            if on:
                desk_target = os.path.join(ps["desktop_nm"], name)
                if not os.path.exists(desk_target):
                    raise ValueError("桌面版尚未安装 %s" % name)
                os.makedirs(ps["headless_nm"], exist_ok=True)
                link_path = os.path.join(ps["headless_nm"], name)
                rel_target = os.path.join("..", "..", "desktop", "node_modules", name)
                if os.path.lexists(link_path):
                    if os.path.islink(link_path):
                        os.unlink(link_path)
                if not os.path.exists(link_path):
                    os.symlink(rel_target, link_path)
                if name not in bundles:
                    bundles.append(name)
            else:
                bundles = [b for b in bundles if b != name]
            prof["bundles"] = bundles
            _dsh_atomic_json(ps["headless_pkg"], h_pkg)
            return dsh_plugins_state()

        if action == "set_option":
            plugin = str(body.get("plugin") or "").strip()
            key = str(body.get("key") or "").strip()
            val = body.get("value")
            meta = _DSH_KNOWN_MAP.get(plugin)
            if not meta:
                raise ValueError("不支持的插件")
            opt = next((o for o in meta["options"] if o["key"] == key), None)
            if not opt:
                raise ValueError("不支持的开关项")
            if opt["type"] == "bool":
                if not isinstance(val, bool):
                    raise ValueError("开关值必须是布尔值")
            elif opt["type"] == "int":
                if isinstance(val, bool) or not isinstance(val, int):
                    raise ValueError("参数值必须是整数")
                val = max(opt.get("min", 1), min(opt.get("max", 100), val))
            if meta["kind"] == "full_throttle":
                cur = read_json(ps["full_throttle"]) or {}
                if not isinstance(cur, dict):
                    cur = {}
                cur.setdefault("enabled", False)
                cur.setdefault("subagents", False)
                cur[key] = val
                _dsh_atomic_json(ps["full_throttle"], cur)
            else:
                patch_cfgs = _dsh_read_patch_configs(ps["headless_patch"])
                cfg = dict(patch_cfgs.get(meta["cordis_id"]) or {})
                cfg[key] = val
