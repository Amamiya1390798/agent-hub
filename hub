def eprint(*a):
    with _print_lock:
        print(*a, file=sys.stderr, flush=True)


def deep_merge(base, over):
    out = dict(base)
    for k, v in over.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def load_config():
    os.makedirs(HUB_HOME, exist_ok=True)
    if not os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_CONFIG, f, ensure_ascii=False, indent=2)
    if not os.path.exists(DSH_PATCH):
        with open(DSH_PATCH, "w", encoding="utf-8") as f:
            f.write(DSH_PATCH_CONTENT)
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            cfg = deep_merge(DEFAULT_CONFIG, json.load(f))
        for k, v in OLD_PROFILES.items():  # 旧版自动写进配置、用户没改过的角色说明，换成新的分工原则
            if cfg.get("profiles", {}).get(k) == v:
                cfg["profiles"][k] = DEFAULT_CONFIG["profiles"][k]
        return cfg
    except Exception as e:  # 配置坏了也别挂
        eprint("[hub] 配置文件读取失败，使用默认配置：%s" % e)
        return DEFAULT_CONFIG


