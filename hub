def gate(ip, host, sock_ip, port, path, cookie, lan_on):
    """每个请求先过这道门。返回 None 表示放行，否则返回 (状态码, 原因)。"""
    kind = ip_kind(ip)
    local_hosts = ("127.0.0.1:%d" % port, "localhost:%d" % port)
    lan_host = "%s:%d" % (sock_ip, port) if lan_on and ip_kind(sock_ip) == "private" else None
    if host not in local_hosts and host != lan_host:  # 防 DNS 重绑定：只认本机和本机局域网地址
        return 403, "地址不对"
    if kind == "local":
        return None
    if not lan_on or kind != "private":
        return 403, "只接受同一局域网里的设备"
    if path == "/pair":
        return None
    if not cookie_ok(cookie):
        return 401, "这台设备还没配对"
    return None


