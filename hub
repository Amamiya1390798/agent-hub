def codex_defaults():
    """读 Codex 自己配置里的默认模型和思考强度。"""
    model = effort = ""
    try:
        with open(os.path.join(HOME, ".codex", "config.toml"), encoding="utf-8") as f:
            for line in f:
                if line.startswith("["):
                    break
                m = re.match(r'^\s*(model|model_reasoning_effort)\s*=\s*"([^"]*)"', line)
                if m and m.group(1) == "model":
                    model = m.group(2)
                elif m:
                    effort = m.group(2)
    except OSError:
        pass
    return model, effort


