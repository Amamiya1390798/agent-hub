def agy_label(m):
    """Antigravity 模型的显示名；Claude 加「· Antigravity」，和本机 Claude 命令行区分开。档位括号留在最后，面板靠它分档。"""
    name = m.get("name") or m["id"]
    if not m["id"].startswith("claude-"):
        return name
    lv = re.match(r"^(.*?)\s*(\([^)]*\))\s*$", name)
    return (lv.group(1) + " · Antigravity " + lv.group(2)) if lv else name + " · Antigravity"


def backend_choices(cfg):
    """面板里可选的后端：[{spec, label}]。"""
    d = read_json(MODELS_PATH) or {}
    if time.time() - (d.get("ts") or 0) > 86400:
        refresh_models()
    out = [{"spec": "agy:" + m["id"], "label": agy_label(m)} for m in d.get("agy") or []]
    cdef, _ = codex_defaults()
    out.append({"spec": "codex", "label": "GPT · 跟随 Codex 设置" + ("（现为 %s）" % cdef if cdef else "")})
    cm = _model_records.read(os.path.join(HOME, ".codex", "models_cache.json"), shared=True) or {}
    for m in cm.get("models") or []:
        if isinstance(m, dict) and m.get("slug") and m.get("visibility") == "list":
            out.append({"spec": "codex:" + m["slug"], "label": m.get("display_name") or m["slug"]})
    out += [
            {"spec": "dsh", "label": "DeepSeek（dsh）"},
            {"spec": "claude:opus", "label": "Claude Opus（需登录）"},
            {"spec": "claude:sonnet", "label": "Claude Sonnet（需登录）"},
            {"spec": "claude:haiku", "label": "Claude Haiku（需登录）"}]
    for o in out:
        kind, _, mdl = o["spec"].partition(":")
        if kind == "codex":
            o["efforts"] = [{"id": e, "desc": d} for e, d in codex_model_efforts(mdl)]
        elif kind == "claude":
            o["efforts"] = [{"id": e, "desc": ""} for e in CLAUDE_EFFORTS]
    off = set(cfg.get("disabled_models") or [])
    for o in out:
        if o["spec"] in off:
            o["off"] = True
    known = set(o["spec"] for o in out)
    for chain in cfg["agents"].values():
        for sp in chain:
            if sp not in known:
                known.add(sp)
                out.append({"spec": sp, "label": sp})
    return out


