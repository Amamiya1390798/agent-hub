def backend_agy(cfg, model, prompt, cwd, write, timeout):
    exe = find_bin(cfg, "agy")
    if not exe:
        raise BackendError("未安装 agy（Antigravity CLI）")
    tmp = None
    if len(prompt.encode("utf-8")) > 60000:  # 太长就落盘到工作目录，让它自己读
        try:
            fd, tmp = tempfile.mkstemp(suffix=".md", prefix=".hub-prompt-", dir=cwd)
        except OSError:  # 工作目录不可写就放到系统临时目录
            fd, tmp = tempfile.mkstemp(suffix=".md", prefix="hub-prompt-")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(prompt)
        prompt = "完整任务说明在文件 %s 中，请先完整阅读该文件，再严格按其中要求完成任务（不要修改或删除该文件）。" % tmp
    cmd = [exe, "--print=" + prompt, "--output-format", "stream-json", "--print-timeout", "%ds" % timeout]
    if model:
        cmd += ["--model", model]
    if cfg.get("_resume"):  # 续接上一轮的会话，只发这一轮的话
        cmd += ["--conversation", cfg["_resume"]]
    if cfg.get("_images"):  # 让它能打开放图片的目录
        cmd += ["--add-dir", ATTACH_DIR]
    if write:
        cmd += ["--mode", "accept-edits", "--dangerously-skip-permissions"]
    live = Live()
    box = {"data": None, "step": None, "tok": {"in": 0, "out": 0, "cache": 0}}

    def on_line(line):
        line = line.strip()
        if not line.startswith("{"):
            return
        try:
            ev = json.loads(line)
        except ValueError:
            return
        if ev.get("event") == "result" and isinstance(ev.get("result"), dict):
            box["data"] = ev["result"]
            return
        su = ev.get("step_update")
        if not isinstance(su, dict):
            return
        u = su.get("usage")
        if isinstance(u, dict):
            box["tok"]["in"] += int(u.get("input_tokens") or 0)
            box["tok"]["out"] += int(u.get("output_tokens") or 0)
            box["tok"]["cache"] += int(u.get("cache_read_tokens") or 0)
        if su.get("step_type") == "agent_response" and su.get("text_delta"):
            if box["step"] is not None and box["step"] != su.get("step_index") and live.text:
                live.add("\n\n")
            box["step"] = su.get("step_index")
            live.add(su["text_delta"])
        elif su.get("step_type") == "tool" and su.get("state") == "ACTIVE":
            params = (su.get("tool_info") or {}).get("parameters") or {}
            arg = next((str(v) for v in params.values() if isinstance(v, (str, int, float)) and str(v).strip()), "")
            live.step("%s %s" % (su.get("tool_name") or "tool", arg))

    try:
        rc, out, err = _run(cmd, cwd, clean_env(), timeout + 30, on_line=on_line)
    finally:
        live.close()
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    data = box["data"]
    if not isinstance(data, dict):
        raise BackendError("agy 没有给出结果 rc=%s：%s" % (rc, _tail(err or out)))
    if data.get("status") != "SUCCESS" or not (data.get("response") or "").strip():
        raise BackendError("agy 状态 %s：%s" % (data.get("status"), _tail(json.dumps(data, ensure_ascii=False))))
    _ctx.tokens = box["tok"]
    if data.get("conversation_id"):
        _ctx.session = {"id": data["conversation_id"], "app": "Antigravity 命令行",
                        "resume": "cd %s && agy --conversation %s" % (shq(cwd), shq(data["conversation_id"]))}
    return data["response"].strip()


def backend_codex(cfg, model, prompt, cwd, write, timeout):
    exe = find_bin(cfg, "codex")
    if not exe:
        raise BackendError("未找到 codex CLI")
    fd, outfile = tempfile.mkstemp(suffix=".txt", prefix="hub-codex-")
    os.close(fd)
    sandbox = ("danger-full-access" if cfg.get("gpt_full_access") else "workspace-write") if write else "read-only"
    if cfg.get("_resume"):  # 续接上一轮的会话；resume 不认 -s/-C，用配置项指定沙箱，目录靠进程的当前目录
        cmd = [exe, "exec", "resume", "--skip-git-repo-check", "-c", 'sandbox_mode="%s"' % sandbox, "-o", outfile]
    else:
        cmd = [exe, "exec", "--skip-git-repo-check", "-C", cwd, "-s", sandbox, "-o", outfile]
    if model:
        cmd += ["-m", model]
    for img in cfg.get("_images") or []:  # GPT 直接收图
        cmd += ["--image=" + img]
    if cfg.get("_effort") and _EFFORT_ID.match(cfg["_effort"]):
        cmd += ["-c", 'model_reasoning_effort="%s"' % cfg["_effort"]]
    if cfg.get("_web"):  # 打开 GPT 自带的实时网页搜索
        cmd += ["-c", 'web_search="live"']
    cmd += ["--json"] + ([cfg["_resume"]] if cfg.get("_resume") else []) + ["-"]
    live = Live()
    box = {}

    def on_line(line):  # 事件流只用于实时显示；最终回答仍读 -o 文件
        try:
            ev = json.loads(line)
        except ValueError:
            return
        if isinstance(ev, dict) and (ev.get("thread_id") or ev.get("session_id")) and not box.get("sid"):
            box["sid"] = str(ev.get("thread_id") or ev.get("session_id"))
        item = ev.get("item") if isinstance(ev, dict) else None
        if not isinstance(item, dict):
            return
        typ, kind = str(ev.get("type") or ""), str(item.get("type") or item.get("item_type") or "")
        if kind == "agent_message" and typ.endswith("completed") and item.get("text"):
            live.add(str(item["text"]) + "\n\n")
        elif kind == "command_execution" and typ.endswith("started"):
            live.step(str(item.get("command") or "运行命令"))
        elif kind not in ("agent_message", "reasoning", "command_execution") and typ.endswith("started"):
            live.step(kind)

    try:
        try:
            rc, out, err = _run(cmd, cwd, clean_env(), timeout, stdin_text=prompt, on_line=on_line)
        finally:
            live.close()
        with open(outfile, encoding="utf-8", errors="replace") as f:
            answer = f.read().strip()
    finally:
        try:
            os.unlink(outfile)
        except OSError:
            pass
    if rc != 0 or not answer:
        raise BackendError("codex rc=%s：%s" % (rc, _tail(err or out)))
    if box.get("sid"):
        _ctx.session = {"id": box["sid"], "app": "Codex 命令行",
                        "resume": "cd %s && %s resume %s" % (shq(cwd), shq(exe), shq(box["sid"]))}
    return answer


def backend_dsh(cfg, model, prompt, cwd, write, timeout):
    exe = find_bin(cfg, "dsh")
    if not exe:
        raise BackendError("未安装 dsh")
    env = clean_env({"DSH_PERMISSION_MODE": "danger-full-access" if write else "read-only"})
    cmd = [exe, "--patch", DSH_PATCH, "--profile", "headless", "--json"] + \
        (["--session-id", cfg["_resume"]] if cfg.get("_resume") else []) + ["-"]
    live = Live()

    def on_line(line):
        try:
            ev = json.loads(line)
        except ValueError:
            return
        if not isinstance(ev, dict):
            return
        typ = str(ev.get("type") or "")
        if typ == "text" and isinstance(ev.get("text"), str):
            live.add(ev["text"])
        elif "tool" in typ:
            live.step("%s %s" % (ev.get("name") or ev.get("tool") or typ,
                                  json.dumps(ev.get("input") or ev.get("args") or "", ensure_ascii=False)[:120]))

    try:
        rc, out, err = _run(cmd, cwd, env, timeout, stdin_text=prompt, on_line=on_line)
    finally:
        live.close()
    final, tok, sid = None, {"in": 0, "out": 0, "cache": 0}, None
    for line in out.splitlines():
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if not isinstance(ev, dict):
            continue
        if ev.get("type") == "session" and ev.get("sessionId"):
            sid = str(ev["sessionId"])
        if ev.get("type") == "final" and isinstance(ev.get("text"), str):
            final = ev["text"]
        u = ev.get("usage")
        if isinstance(u, dict):
            tok["in"] += int(u.get("inputTokens") or 0)
            tok["out"] += int(u.get("outputTokens") or 0)
            tok["cache"] += int(u.get("cacheReadTokens") or 0)
    if rc != 0 or not (final or "").strip():
        raise BackendError("dsh rc=%s：%s" % (rc, _tail(err or out)))
    _ctx.tokens = tok
    if sid:
        _ctx.session = {"id": sid, "app": "DeepSeek Harness 命令行",
                        "resume": "cd %s && dsh --patch %s tui --resume %s" % (shq(cwd), shq(DSH_PATCH), shq(sid))}
    return final.strip()


def backend_claude(cfg, model, prompt, cwd, write, timeout):
    exe = find_bin(cfg, "claude")
    if not exe:
        raise BackendError("未找到 claude CLI")
    cmd = [exe, "-p", "--model", model or "opus",
           "--permission-mode", "acceptEdits" if write else "plan"]
    if cfg.get("_effort") in CLAUDE_EFFORTS:
        cmd += ["--effort", cfg["_effort"]]
    if cfg.get("_web"):  # 只读模式下也放行 Claude 自带的网页搜索和读网页
        cmd += ["--allowedTools", "WebSearch", "WebFetch"]
    if cfg.get("_resume"):
        cmd += ["--resume", cfg["_resume"]]
    if cfg.get("_images"):
        cmd += ["--add-dir", ATTACH_DIR]
    cmd += ["--output-format", "json"]  # 拿到会话编号，下次追问能续接
    rc, out, err = _run(cmd, cwd, clean_env(), timeout, stdin_text=prompt)
    text = out.strip()
    try:
        d = json.loads(text)
    except ValueError:
        d = None
    if isinstance(d, dict) and "result" in d:
        if d.get("is_error"):
            raise BackendError("claude 出错：%s" % _tail(str(d.get("result") or d.get("subtype") or text)))
        text = str(d.get("result") or "").strip()
        u = d.get("usage") if isinstance(d.get("usage"), dict) else {}
        _ctx.tokens = {"in": int(u.get("input_tokens") or 0), "out": int(u.get("output_tokens") or 0),
                       "cache": int(u.get("cache_read_input_tokens") or 0)}
        if d.get("session_id"):
            _ctx.session = {"id": str(d["session_id"]), "app": "Claude Code",
                            "resume": "cd %s && %s --resume %s" % (shq(cwd), shq(exe), shq(str(d["session_id"])))}
    not_logged = len(text) < 200 and ("Not logged in" in text or "Please run /login" in text)
    if rc != 0 or not text or not_logged:
        hint = "（未登录：请在终端运行一次 claude 并执行 /login）" if not_logged else ""
        raise BackendError("claude rc=%s%s：%s" % (rc, hint, _tail((err + "\n" + text).strip())))
    return text


