_ARCHIVE_KEY = re.compile(r"^(run|call):[A-Za-z0-9._-]{1,80}$")


def load_archived():
    """已归档的记录，形如 ["run:2026...", "call:abc"]。只是不在左栏常规列表里显示，记录本身不删。"""
    d = read_json(ARCHIVE_PATH)
