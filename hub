def load_names_raw():
    d = read_json(NAMES_PATH)
    if not isinstance(d, dict):
        d = {}
    if not isinstance(d.get("names"), dict):
        d["names"] = {}
    if not isinstance(d.get("failed"), dict):
        d["failed"] = {}
    return d


def load_names():
    """{记录键: 名字}；手动起的名字优先于自动的。"""
    return {k: v["name"] for k, v in load_names_raw()["names"].items()
            if isinstance(v, dict) and isinstance(v.get("name"), str) and v["name"]}


FOLDERS_PATH = os.path.join(HUB_HOME, "folders.json")
_folders_lock = threading.Lock()


def load_folders():
    """左栏的文件夹：{"folders": [{id, name}], "of": {项目组键: 文件夹 id}}。"""
    d = read_json(FOLDERS_PATH)
    d = d if isinstance(d, dict) else {}
    fs = [f for f in d.get("folders") or [] if isinstance(f, dict) and isinstance(f.get("id"), str) and isinstance(f.get("name"), str)]
    ids = set(f["id"] for f in fs)
    of = {k: v for k, v in (d.get("of") or {}).items() if isinstance(k, str) and v in ids}
    return {"folders": fs, "of": of}


def folder_op(body):
    """建 / 改名 / 删文件夹，或把项目组放进某个文件夹（folder 为空=拿出来）。删文件夹不删里面的记录。"""
    op = body.get("op")

    def clean(n):
        if not isinstance(n, str) or not n.strip() or len(n) > 40:
            raise ValueError("文件夹名字要 1～40 个字")
        return re.sub(r"[\x00-\x1f\x7f]", "", n).strip()
    with _folders_lock:
        d = load_folders()
        ids = set(f["id"] for f in d["folders"])
        if op == "create":
            fid = "f_" + uuid.uuid4().hex[:8]
            d["folders"].append({"id": fid, "name": clean(body.get("name"))})
            keys = body.get("keys") or []
        elif op in ("rename", "delete"):
            fid = body.get("id")
            if fid not in ids:
                raise ValueError("没有这个文件夹")
            if op == "rename":
                next(f for f in d["folders"] if f["id"] == fid)["name"] = clean(body.get("name"))
            else:
                d["folders"] = [f for f in d["folders"] if f["id"] != fid]
                d["of"] = {k: v for k, v in d["of"].items() if v != fid}
            keys = []
        elif op == "move":
            fid = body.get("folder") or ""
            if fid and fid not in ids:
                raise ValueError("没有这个文件夹")
            keys = body.get("keys") or []
        else:
            raise ValueError("不认识的操作")
        if not isinstance(keys, list) or len(keys) > 500:
            raise ValueError("记录不对")
        for k in keys:
            if not isinstance(k, str) or not _ARCHIVE_KEY.match(k):
                raise ValueError("记录不对")
            k = group_root(k)
            if fid:
                d["of"][k] = fid
            else:
                d["of"].pop(k, None)
        write_json(FOLDERS_PATH, d)
        return fid


def clean_title(t):
    t = (t or "").strip().splitlines()[0] if (t or "").strip() else ""
    t = re.sub(r"[\x00-\x1f\x7f]", "", t).strip(" \t\"'“”‘’「」『』《》【】。，、：:；;！!？?.#*`")
    return t[:24]


def set_name(key, name, auto=False, rounds=None):
    if not isinstance(key, str) or not _ARCHIVE_KEY.match(key):
        raise ValueError("记录不对")
    key = group_root(key)
    if not isinstance(name, str) or len(name) > 60:
        raise ValueError("名字最多 60 个字")
    name = re.sub(r"[\x00-\x1f\x7f]", "", name).strip()
    with _names_lock:
        d = load_names_raw()
        cur = d["names"].get(key) if isinstance(d["names"].get(key), dict) else None
        if auto and cur and not cur.get("auto"):
            return  # 自动起名不覆盖你手动改的
        if name:
            d["names"][key] = {"name": name, "auto": bool(auto), "ts": time.time()}
            if rounds:
                d["names"][key]["rounds"] = rounds
        else:
            d["names"].pop(key, None)
        d.setdefault("since", time.time())
        write_json(NAMES_PATH, d)


def _top_level(kind, r):
    """左栏里算一轮的记录（团队内部调用、旁问、子调用不算）。"""
    if kind == "run":
        return True
    return not (r.get("parent") or r.get("run") or r.get("kind") == "side")


def group_members(calls, runs):
    """{开头一轮的键: [(开始时间, 键, 记录), ...]}，只算加载到的记录。"""
    groups = {}
    for kind, recs in (("call", calls), ("run", runs)):
        for r in recs:
            if not isinstance(r, dict) or not r.get("id") or not _top_level(kind, r):
                continue
            key = "%s:%s" % (kind, r["id"])
            groups.setdefault(group_root(key), []).append((r.get("start") or 0, key, r))
    for v in groups.values():
        v.sort(key=lambda x: x[0])
    return groups


def title_candidates(calls, runs):
    """要起名的项目组：还没名字的；或者自动起的名字之后组里又长了不少（重起一次）。
    手动改过的、归档的、还在做的不起。返回 [(开头的键, 组里的键按时间排)]，最新的在前。"""
    d = load_names_raw()
    since = d.get("since")
    if since is None:  # 第一次：只给以后的新项目组起名，旧的要在设置里点「给已有的起名」
        set_name_since(time.time())
        return []
    archived = set(load_archived())
    out = []
    for root, mem in group_members(calls, runs).items():
        cur = d["names"].get(root) if isinstance(d["names"].get(root), dict) else None
        if (cur and not cur.get("auto")) or d["failed"].get(root, 0) >= 2 or root in archived:
            continue
        if any(m[2].get("status") in ("running", "planning", "synthesizing", None) for m in mem[-2:]):
            continue
        kind, _, rid = root.partition(":")
        head = ui_record(kind, rid) or {}
        if (head.get("start") or 0) < since:
            continue
        if kind == "call" and head.get("kind") not in ("ask", "chat"):
            continue
        n = len(mem)
        if cur:
            was = cur.get("rounds") or 1
            if n < was + RETITLE_GROWTH or n < was * 2:
                continue
        out.append((mem[-1][0], root, [m[1] for m in mem]))
    return [(k, keys) for _, k, keys in sorted(out, key=lambda x: x[0], reverse=True)]


def title_context(keys):
    """给起名看的内容：开头两轮和最近三轮，每轮的要求和结果各截一段。"""
    pick = keys if len(keys) <= 5 else keys[:2] + keys[-3:]
    parts = []
    for k in pick:
        kind, _, rid = k.partition(":")
        r = ui_record(kind, rid) or {}
        if kind == "run":
            q, a = r.get("display") or r.get("goal") or "", r.get("final") or ""
        elif r.get("kind") == "handoff":
            q, a = "（压缩或交接进来的说明）", r.get("answer") or ""
        else:
            q, a = r.get("display") or r.get("prompt") or "", r.get("answer") or ""
        if q or a:
            parts.append("【第 %d 轮】\n用户：%s\n回答：%s" % (keys.index(k) + 1, q[:500], a[:500]))
    return "\n\n".join(parts)


def set_name_since(ts):
    with _names_lock:
        d = load_names_raw()
        d["since"] = ts
        write_json(NAMES_PATH, d)


def auto_title_one(cfg, key, keys=None):
    """叫一位成员给一个项目组起名。直接调后端，不写调用记录，免得名字本身又变成一条记录。"""
    who = cfg.get("auto_title") or ""
    chain = cfg["agents"].get(who) or []
    keys = keys or [key]
    body = title_context(keys)
    if not body or not chain:
        return
    prompt = TITLE_PROMPT % body
    for spec in chain[:2]:
        bk, _, mdl = spec.partition(":")
        fn = BACKENDS.get(bk)
        if not fn:
            continue
        try:
            t = clean_title(fn(dict(cfg, _effort=""), mdl, prompt, tempfile.gettempdir(), False, 180))
        except (BackendError, OSError):
            continue
        if t:
            set_name(key, t, auto=True, rounds=len(keys))
            return
    with _names_lock:
        d = load_names_raw()
        d["failed"][key] = d["failed"].get(key, 0) + 1
        write_json(NAMES_PATH, d)


def start_auto_titles(cfg, calls, runs):
    if not cfg.get("auto_title") or _names_running.is_set() or os.environ.get("HUB_NO_AUTOTITLE") == "1":  # 离线测试里不真的叫模型
        return
    todo = title_candidates(calls, runs)[:20]
    if not todo:
        return
    _names_running.set()

    def work():
        try:
            for k, keys in todo:
                auto_title_one(cfg, k, keys)
        finally:
            _names_running.clear()
    threading.Thread(target=work, daemon=True).start()


ARCHIVE_PATH = os.path.join(HUB_HOME, "archived.json")
_archive_lock = threading.Lock()
_ARCHIVE_KEY = re.compile(r"^(run|call):[A-Za-z0-9._-]{1,80}$")


def load_archived():
    """已归档的记录，形如 ["run:2026...", "call:abc"]。只是不在左栏常规列表里显示，记录本身不删。"""
    d = read_json(ARCHIVE_PATH)
    keys = d.get("keys") if isinstance(d, dict) else None
    return [k for k in keys if isinstance(k, str) and _ARCHIVE_KEY.match(k)] if isinstance(keys, list) else []


def set_archived(keys, on):
    if not isinstance(keys, list) or not keys or len(keys) > 500 or not isinstance(on, bool):
        raise ValueError("归档请求格式不对")
    for k in keys:
        if not isinstance(k, str) or not _ARCHIVE_KEY.match(k):
            raise ValueError("归档请求格式不对")
    with _archive_lock:
        cur = load_archived()
        if on:
            cur = cur + [k for k in keys if k not in cur]
        else:
            drop = set(keys)
            cur = [k for k in cur if k not in drop]
        write_json(ARCHIVE_PATH, {"keys": cur[-5000:]})


def stop_record(kind, rid):
    r = ui_record(kind, rid)
    if not r:
        return "没有这条记录"
    pid = r.get("pid")
    if r.get("status") not in RUN_ACTIVE or not pid_alive(pid):
        return "它已经不在运行了"
    if int(pid) == os.getpid():
        return "不能停止面板自己"
    try:
        cmdline = subprocess.check_output(["ps", "-o", "command=", "-p", str(pid)], text=True)
    except (OSError, subprocess.CalledProcessError):
        cmdline = ""
    if not re.search(r"(^|/)hub (run|ask|image|council|chat)\b", cmdline):
        return "进程对不上，为安全起见没有停止"
    try:
        os.kill(int(pid), signal.SIGTERM)
    except OSError as e:
        return "停止失败：%s" % e
    for _ in range(50):
        if not pid_alive(pid):
            break
        time.sleep(0.1)
    else:
        try:
            os.kill(int(pid), signal.SIGKILL)
        except OSError:
            pass
        time.sleep(0.3)
    now = time.time()
    if kind == "run":
        p = os.path.join(RUNS_DIR, rid, "run.json")
        d = read_json(p)
        if d:
            _fail_tasks(d)
            d.update(status="failed", error=STOP_MSG, end=now)
            write_json(p, d)
            write_board_md(os.path.join(RUNS_DIR, rid), d)
    else:  # 停止对话时，它派出的项目组（同一个进程）也标成「已停止」
        try:
            names = os.listdir(RUNS_DIR)
        except OSError:
            names = []
        for name in names:
            p = os.path.join(RUNS_DIR, name, "run.json")
            d = read_json(p)
            if (isinstance(d, dict) and d.get("pid") == pid
                    and (d.get("status") in RUN_ACTIVE or d.get("error") == DEAD_MSG)):
                _fail_tasks(d)
                d.update(status="failed", error=STOP_MSG, end=now)
                write_json(p, d)
                write_board_md(os.path.join(RUNS_DIR, name), d)
    for c in load_calls():
        if c.get("pid") == pid and c.get("status") == "fail" and c.get("error") == DEAD_MSG:
            d = read_json(os.path.join(CALLS_DIR, c["id"] + ".json"))
            if d and d.get("status") == "fail" and d.get("error") == DEAD_MSG:
                d.update(status="fail", error=STOP_MSG, end=now, secs=round(now - (d.get("start") or now), 1))
                write_json(os.path.join(CALLS_DIR, c["id"] + ".json"), d)
    return None


