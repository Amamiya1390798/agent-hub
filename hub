SYS_BIN_DIRS = ("/opt/homebrew/bin", "/usr/local/bin", "/opt/local/bin")
APP_BINS = {
    "codex": ["/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex", "/Applications/Codex.app/Contents/Resources/codex"],
    "dsh": ["/Applications/DeepSeek Harness.app/Contents/Resources/bin/dsh", "/Applications/DeepSeek Harness.app/Contents/MacOS/dsh"],
