def find_bin(cfg, name):
    p = (cfg.get("bins") or {}).get(name) or ""
    ok = lambda x: bool(x) and os.path.isfile(x) and os.access(x, os.X_OK)
    if p and os.path.sep in p:
        p = os.path.expanduser(p)
        if ok(p):
            return p
        p = ""  # 填的路径在这台电脑上不存在（比如照搬了别人的配置）：照常按名字找
    base = os.path.basename(p) if p else name
    extra = os.pathsep.join([os.path.join(HOME, d) for d in BIN_DIRS] + list(SYS_BIN_DIRS))
    found = shutil.which(base) or shutil.which(base, path=extra)
    if found:
        return found
    for c in APP_BINS.get(name, []):
        if ok(c):
            return c
    if name == "claude":
        cands = sorted(glob.glob(os.path.join(
            HOME, "Library/Application Support/Claude/claude-code/*/*/claude.app/Contents/MacOS/claude")))
        if cands:
            return cands[-1]
    sp = login_shell_path()
    return (shutil.which(base, path=sp) if sp else None) or None


