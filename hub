HEALTH_PATH = os.path.join(HUB_HOME, "health.json")
UI_PID = os.path.join(HUB_HOME, "ui.pid")
STOP_MSG = "已手动停止"
DEAD_MSG = "已中断（进程不在了）"


def pid_alive(pid):
    try:
        if int(pid) <= 1:
            return False
        os.kill(int(pid), 0)
        return True
    except (OSError, TypeError, ValueError):
        return False


class _RecordCache:
    """只解析变化的历史文件；有界缓存，返回副本供详情页补充字段。"""

    def __init__(self, limit):
        self.limit = limit
        self.records = OrderedDict()
        self.lock = threading.Lock()

    def read(self, path, st=None):
        with self.lock:
            try:
                st = st or os.stat(path)
            except OSError:
                self.records.pop(path, None)
                return None
            sig = (st.st_dev, st.st_ino, st.st_mtime_ns, st.st_ctime_ns, st.st_size)
            cached = self.records.get(path)
            if cached is None or cached[0] != sig:
                cached = (sig, read_json(path))
                self.records[path] = cached
                if len(self.records) > self.limit:
                    self.records.popitem(last=False)
            self.records.move_to_end(path)
            return copy.deepcopy(cached[1])


_call_records = _RecordCache(1024)  # 最近 400 次调用，加上项目里的旧任务和当前详情
_run_records = _RecordCache(64)


def _load_call(path, st=None):
    try:
        st = st or os.stat(path)
    except OSError:
        return None
    c = _call_records.read(path, st)
    if not isinstance(c, dict) or "id" not in c:
        return None
    if c.get("status") == "running" and not pid_alive(c.get("pid")):
        pid = c.get("pid")
        c = _call_records.read(path)  # 进程退出前可能刚写好最终结果，不能用扫描时的旧状态覆盖
        if not isinstance(c, dict) or "id" not in c:
            return None
        if c.get("status") != "running" or c.get("pid") != pid:
            return c
        c.update(status="fail", error=DEAD_MSG, end=c.get("end") or st.st_mtime)
        write_json(path, c)  # 落盘，免得日后 PID 被别的进程复用时“复活”
    return c


def _load_run(path):
    r = _run_records.read(path)
    if not isinstance(r, dict):
        return None
    if r.get("status") in ("planning", "running", "synthesizing") and not pid_alive(r.get("pid")):
        pid = r.get("pid")
        r = _run_records.read(path)
        if not isinstance(r, dict):
            return None
        if r.get("status") not in ("planning", "running", "synthesizing") or r.get("pid") != pid:
            return r
        r.update(status="failed", error=r.get("error") or DEAD_MSG, end=r.get("end") or r.get("start"))
        _fail_tasks(r)
        write_json(path, r)
        write_board_md(os.path.dirname(path), r)
    return r


def load_calls(limit=400):
    try:
        paths = []
        with os.scandir(CALLS_DIR) as entries:
            for entry in entries:
                if entry.name.endswith(".json"):
                    try:
                        paths.append((entry.path, entry.stat()))
                    except OSError:  # 另一个进程可能刚删掉/替换了记录
                        continue
    except OSError:
        return []
    key = lambda item: item[1].st_mtime
    paths = (heapq.nlargest(limit, paths, key=key) if limit is not None and limit >= 0
             else sorted(paths, key=key, reverse=True)[:limit])
    out = []
    for p, st in paths:
        c = _load_call(p, st)
        if c is not None:
            out.append(c)
    out.sort(key=lambda c: c.get("start") or 0, reverse=True)
    return out


def load_runs(limit=40):
    try:
        ids = sorted(os.listdir(RUNS_DIR), reverse=True)
    except OSError:
        return []
    out = []
    for rid in ids:
        r = _load_run(os.path.join(RUNS_DIR, rid, "run.json"))
        if r is None:
            continue
        out.append(r)
        if len(out) >= limit:
            break
    return out


def _preview(s, n=200):
    return (s or "").strip()[:n]


def check_specs(cfg, names=None):
    """对每个后端做一次真实的小调用。返回 {后端: {ok, msg}}。"""
    names = names or list(cfg["agents"])

    def check(spec):
        kind, _, mdl = spec.partition(":")
        t0 = time.time()
        if kind not in BACKENDS:
            return spec, {"ok": False, "msg": "未知后端"}
        try:
            BACKENDS[kind](cfg, mdl, "只回复两个字：收到", tempfile.gettempdir(), False, 120)
            return spec, {"ok": True, "msg": "%.0fs" % (time.time() - t0)}
        except BackendError as e:
            return spec, {"ok": False, "msg": str(e).replace("\n", " ")[:160]}

    specs = []
    for n in names:
        for sp in cfg["agents"][n]:
            if sp not in specs:
                specs.append(sp)
    with ThreadPoolExecutor(max_workers=6) as pool:
        return dict(pool.map(check, specs))


def call_preferred(c):
    """旧记录从失败尝试恢复当时的首选，不能拿今天的设置判断历史。"""
    attempts = c.get("attempts") or []
    return c.get("preferred_backend") or (attempts[0].get("backend") if attempts else c.get("backend"))


