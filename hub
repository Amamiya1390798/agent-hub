def explain_error(raw):
    """原始报错（常是英文 JSON）→ (一句中文原因, 一句建议)。原文另外保留，不丢。"""
    low = (raw or "").lower()
    for keys, reason, advice in ERROR_KINDS:
        if any(k.lower() in low for k in keys):
            if "{t}" in reason:
                mm = re.search(r"after (\d+)m(\d+)s|after (\d+)s|超时（(\d+)s）", raw or "")
                secs = None
                if mm:
                    secs = int(mm.group(1)) * 60 + int(mm.group(2)) if mm.group(1) else int(mm.group(3) or mm.group(4))
                reason = reason.replace("{t}", "%d 分钟" % max(1, round(secs / 60)) if secs else "规定时间")
            return reason, advice
    return "出错了（原因见技术细节）", "可以重新执行一次；反复出现的话把技术细节发给我们看看"


def failure_text(agent, tries):
    """tries：[(后端, 原始报错)] → 说清楚先用谁、又换谁、各自为什么没成功。"""
    if not tries:
        return "%s 没有可用的模型" % agent
    parts = []
    for i, (spec, raw) in enumerate(tries):
        reason = explain_error(raw)[0]
        lead = "先用" if i == 0 else "又换"
        parts.append("%s %s 试了，%s" % (lead, spec_label(spec), reason) if len(tries) > 1
                     else "用 %s 试了，%s" % (spec_label(spec), reason))
    tail = "都没成功" if len(tries) > 1 else "没成功"
    return "%s 没能完成：%s。%s。建议：%s。" % (agent, "；".join(parts), tail, explain_error(tries[-1][1])[1])


def _tail(s, n=400):
    s = s.strip()
    return s[-n:] if len(s) > n else s


