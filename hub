# ---- 二维码（QR Code Model 2，字节模式，纠错等级 M）：纯标准库，给手机扫码配对用。
# 初稿由 Gemini 写成，Claude 用 macOS 自带识别器验证了版本 1～10 的多种长度。

# GF(256) 指数表与对数表（本原多项式 x^8 + x^4 + x^3 + x^2 + 1 = 0x11D）
_qr_EXP = [0] * 512
_qr_LOG = [0] * 256
_qr_x = 1
for _qr_i in range(255):
    _qr_EXP[_qr_i] = _qr_EXP[_qr_i + 255] = _qr_x
    _qr_LOG[_qr_x] = _qr_i
    _qr_x = (_qr_x << 1) ^ (0x11D if _qr_x & 0x80 else 0)

# 版本 1～15 纠错等级 M 参数表：(总码字数, RS 总块数, 每块纠错码字数)
_qr_VERSION_M = [
    (26, 1, 10),   (44, 1, 16),   (70, 1, 26),   (100, 2, 18),  (134, 2, 24),
    (172, 4, 16),  (196, 4, 18),  (242, 4, 22),  (292, 5, 22),  (346, 5, 26),
    (404, 5, 30),  (466, 8, 22),  (532, 9, 22),  (581, 9, 24),  (655, 10, 24),
]

_qr_MASK_FUNCS = (
    lambda r, c: (r + c) % 2 == 0,
    lambda r, c: r % 2 == 0,
    lambda r, c: c % 3 == 0,
    lambda r, c: (r + c) % 3 == 0,
    lambda r, c: (r // 2 + c // 3) % 2 == 0,
    lambda r, c: (r * c) % 2 + (r * c) % 3 == 0,
    lambda r, c: ((r * c) % 2 + (r * c) % 3) % 2 == 0,
    lambda r, c: ((r + c) % 2 + (r * c) % 3) % 2 == 0,
)

_qr_FINDER_PAT_1 = [True, False, True, True, True, False, True, False, False, False, False]
_qr_FINDER_PAT_2 = [False, False, False, False, True, False, True, True, True, False, True]


def _qr_gf_mul(a: int, b: int) -> int:
    return _qr_EXP[_qr_LOG[a] + _qr_LOG[b]] if a and b else 0


def _qr_rs_generator_poly(nsym: int) -> list[int]:
    g = [1]
    for i in range(nsym):
        nxt = [0] * (len(g) + 1)
        for j, c in enumerate(g):
            nxt[j] ^= c
            nxt[j + 1] ^= _qr_gf_mul(c, _qr_EXP[i])
        g = nxt
    return g


def _qr_rs_encode(data: list[int], nsym: int) -> list[int]:
    gen = _qr_rs_generator_poly(nsym)
    res = list(data) + [0] * nsym
    for i in range(len(data)):
        coef = res[i]
        if coef:
            for j in range(1, nsym + 1):
                res[i + j] ^= _qr_gf_mul(gen[j], coef)
    return res[len(data):]


def _qr_format_bits(ec_bits: int, mask: int) -> int:
    d = (ec_bits << 3) | mask
    rem = d << 10
    for i in range(14, 9, -1):
        if (rem >> i) & 1:
            rem ^= 0x537 << (i - 10)
    return ((d << 10) | rem) ^ 0x5412


def _qr_version_bits(ver: int) -> int:
    rem = ver << 12
    for i in range(17, 11, -1):
        if (rem >> i) & 1:
            rem ^= 0x1F25 << (i - 12)
    return (ver << 12) | rem


def _qr_alignment_coords(ver: int) -> list[int]:
    if ver < 2:
        return []
    n = 17 + 4 * ver
    divs = ver // 7 + 1
    step = ((n - 13 + 2 * divs - 1) // (2 * divs)) * 2
    return [6] + [n - 7 - i * step for i in range(divs - 1, -1, -1)]


def _qr_encode_codewords(payload: bytes) -> tuple[int, list[int]]:
    for idx, (total_cw, num_blocks, ec_cw) in enumerate(_qr_VERSION_M):
        ver = idx + 1
        cc_bits = 8 if ver <= 9 else 16
        data_cw = total_cw - num_blocks * ec_cw
        cap_bits = data_cw * 8
        if 4 + cc_bits + len(payload) * 8 <= cap_bits:
            break
    else:
        raise ValueError(f"UTF-8 数据过长（{len(payload)} 字节），超出版本 1～{len(_qr_VERSION_M)} 容量")

    fields = [(0b0100, 4), (len(payload), cc_bits)] + [(b, 8) for b in payload]
    bits = [(val >> s) & 1 for val, w in fields for s in range(w - 1, -1, -1)]
    bits.extend([0] * min(4, cap_bits - len(bits)))
    bits.extend([0] * ((8 - len(bits) % 8) % 8))

    data = [sum(bits[i + k] << (7 - k) for k in range(8)) for i in range(0, len(bits), 8)]
    data.extend(0xEC if p % 2 == 0 else 0x11 for p in range(data_cw - len(data)))

    # RS 分块与码字交织（Group 1: g1 块每块 k1 字节；Group 2: g2 块每块 k1+1 字节）
    k1, g2 = divmod(data_cw, num_blocks)
    g1 = num_blocks - g2
    data_blocks, ec_blocks, pos = [], [], 0
    for b in range(num_blocks):
        blk = data[pos : pos + k1 + (b >= g1)]
        pos += len(blk)
        data_blocks.append(blk)
        ec_blocks.append(_qr_rs_encode(blk, ec_cw))

    out = [blk[c] for c in range(k1 + (g2 > 0)) for blk in data_blocks if c < len(blk)]
    out.extend(ec[c] for c in range(ec_cw) for ec in ec_blocks)
    return ver, out


def _qr_place_format(grid: list[list[bool]], is_func: list[list[bool]], fmt: int) -> None:
    n = len(grid)
    pos1 = [
        (0, 8), (1, 8), (2, 8), (3, 8), (4, 8), (5, 8), (7, 8), (8, 8),
        (8, 7), (8, 5), (8, 4), (8, 3), (8, 2), (8, 1), (8, 0),
    ]
    pos2 = [(8, n - 1 - i) for i in range(8)] + [(n - 15 + i, 8) for i in range(8, 15)]
    for i in range(15):
        bit = bool((fmt >> i) & 1)
        (r1, c1), (r2, c2) = pos1[i], pos2[i]
        grid[r1][c1] = grid[r2][c2] = bit
        is_func[r1][c1] = is_func[r2][c2] = True


def _qr_penalty(grid: list[list[bool]]) -> int:
    n = len(grid)
    score = 0
    for line in list(grid) + [[grid[r][c] for r in range(n)] for c in range(n)]:
        run = 1
        for i in range(1, n):
            if line[i] == line[i - 1]:
                run += 1
            else:
                score += run - 2 if run >= 5 else 0
                run = 1
        score += run - 2 if run >= 5 else 0
        for i in range(n - 10):
            seg = line[i : i + 11]
            if seg == _qr_FINDER_PAT_1 or seg == _qr_FINDER_PAT_2:
                score += 40

    for r in range(n - 1):
        r0, r1 = grid[r], grid[r + 1]
        for c in range(n - 1):
            if r0[c] == r0[c + 1] == r1[c] == r1[c + 1]:
                score += 3

    dark = sum(sum(row) for row in grid)
    total = n * n
    return score + (abs(dark * 20 - total * 10) // total) * 10


def qr_matrix(text: str) -> list[list[bool]]:
    """生成不含静区的 QR Code Model 2 布尔矩阵（True 为黑块）。"""
    ver, codewords = _qr_encode_codewords(text.encode("utf-8"))
    n = 17 + 4 * ver
    grid = [[False] * n for _ in range(n)]
    is_func = [[False] * n for _ in range(n)]

    # 定位图案（7x7）与白色分隔符（外扩 1 格）
    for cr, cc in ((3, 3), (3, n - 4), (n - 4, 3)):
        for dr in range(-4, 5):
            for dc in range(-4, 5):
                r, c = cr + dr, cc + dc
                if 0 <= r < n and 0 <= c < n:
                    is_func[r][c] = True
                    grid[r][c] = max(abs(dr), abs(dc)) in (0, 1, 3)

    # 校正图案（版本 >= 2，避开三个定位角）
    coords = _qr_alignment_coords(ver)
    for cr in coords:
        for cc in coords:
            if (cr, cc) not in ((6, 6), (6, n - 7), (n - 7, 6)):
                for dr in range(-2, 3):
                    for dc in range(-2, 3):
                        is_func[cr + dr][cc + dc] = True
                        grid[cr + dr][cc + dc] = max(abs(dr), abs(dc)) in (0, 2)

    # 定时图案、暗模块、格式预留位、版本信息（版本 >= 7）
    for i in range(8, n - 8):
        for r, c in ((6, i), (i, 6)):
            if not is_func[r][c]:
                is_func[r][c] = True
                grid[r][c] = i % 2 == 0
    is_func[n - 8][8] = grid[n - 8][8] = True
    _qr_place_format(grid, is_func, 0)
    if ver >= 7:
        vbits = _qr_version_bits(ver)
        for i in range(18):
            bit = bool((vbits >> i) & 1)
            r, c = n - 11 + i % 3, i // 3
            grid[r][c] = grid[c][r] = bit
            is_func[r][c] = is_func[c][r] = True

    # 之字形填入数据与纠错比特，剩余位补 0
    bit_stream = [bool((b >> s) & 1) for b in codewords for s in range(7, -1, -1)]
    idx, col, up = 0, n - 1, True
    while col > 0:
        col -= 1 if col == 6 else 0
        for r in (range(n - 1, -1, -1) if up else range(n)):
            for c in (col, col - 1):
                if not is_func[r][c]:
                    grid[r][c] = bit_stream[idx] if idx < len(bit_stream) else False
                    idx += 1
        col, up = col - 2, not up

    # 遍历 8 种掩码（M 级指示符为 0b00），按 4 条惩罚规则选最低分
    best_grid, best_score = [], 1 << 30
    for mask_id, fn in enumerate(_qr_MASK_FUNCS):
        cand = [
            [grid[r][c] ^ fn(r, c) if not is_func[r][c] else grid[r][c] for c in range(n)]
            for r in range(n)
        ]
        _qr_place_format(cand, is_func, _qr_format_bits(0b00, mask_id))
        sc = _qr_penalty(cand)
        if sc < best_score:
            best_score, best_grid = sc, cand
    return best_grid


def qr_svg(text: str, scale: int = 6, border: int = 4) -> str:
    """生成完整 SVG 字符串（白底黑块，单个 path，默认 4 模块静区）。"""
    if scale < 1 or border < 0:
        raise ValueError("scale 须 >= 1 且 border 须 >= 0")
    mat = qr_matrix(text)
    full = len(mat) + 2 * border
    px = full * scale
    d = "".join(
        f"M{c + border} {r + border}h1v1h-1z"
        for r, row in enumerate(mat) for c, v in enumerate(row) if v
    )
    return (
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{px}" height="{px}" '
        f'viewBox="0 0 {full} {full}" shape-rendering="crispEdges">'
        f'<rect width="{full}" height="{full}" fill="#fff"/>'
        f'<path d="{d}" fill="#000"/></svg>'
    )


def png_bytes(rows):
    """rows：每行是 (r, g, b) 元组列表。只用 zlib + struct 写一个 PNG。"""
    import struct
    import zlib
    h, w = len(rows), len(rows[0])
    raw = b"".join(b"\x00" + bytes(c for px in row for c in px) for row in rows)

    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) +
            chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))


_icon_cache = []


def app_icon_png(size=180):
    """主屏图标：深色底上四个彩色圆点（四位成员）。"""
    if _icon_cache:
        return _icon_cache[0]
    bg, cols = (29, 28, 25), [(59, 124, 240), (210, 113, 79), (18, 163, 127), (123, 92, 245)]
    r, centers = size * 0.16, [(size * 0.33, size * 0.33), (size * 0.67, size * 0.33),
                              (size * 0.33, size * 0.67), (size * 0.67, size * 0.67)]
    rows = []
    for y in range(size):
        row = []
        for x in range(size):
            px = bg
            for (cx, cy), c in zip(centers, cols):
                if (x - cx) ** 2 + (y - cy) ** 2 <= r * r:
                    px = c
            row.append(px)
        rows.append(row)
    _icon_cache.append(png_bytes(rows))
    return _icon_cache[0]


_awake = {"p": None}


def awake_on():
    p = _awake["p"]
    return bool(p and p.poll() is None)


def set_awake(on):
    """不休眠：开着时跑一个 caffeinate -i -m，面板服务退出它也跟着退出。返回现在是否开着。"""
    if on:
        if awake_on():
            return True
        exe = shutil.which("caffeinate") or "/usr/bin/caffeinate"
        if not os.path.exists(exe):
            raise ValueError("这台电脑上没有 caffeinate，开不了不休眠")
        _awake["p"] = subprocess.Popen([exe, "-i", "-m", "-w", str(os.getpid())], stdin=subprocess.DEVNULL,
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    p, _awake["p"] = _awake["p"], None
    if p and p.poll() is None:
        p.terminate()
        try:
            p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            p.kill()
    return False


def _reexec_ui(port, me):
    """局域网开关改动后，面板服务换一个监听地址重新启动（进程号不变）。"""
    set_awake(False)  # 进程号不变，caffeinate 不会自己退；重启后按配置再开
    os.execv(sys.executable, [sys.executable, me, "ui", "--serve", "--port", str(port)])



def history_patch(before, after):
    old = {r.get("id"): r for r in before}
    new = {r.get("id"): r for r in after}
    patch = {"upsert": [r for k, r in new.items() if old.get(k) != r],
             "remove": [k for k in old if k not in new]}
    if list(old) != list(new):
        patch["order"] = list(new)
    return patch


def accepts_gzip(header):
    qualities = {}
    for part in header.lower().split(","):
        coding, *params = part.split(";")
        quality = 1
        for param in params:
            key, _, value = param.strip().partition("=")
            if key.strip() == "q":
                try:
                    quality = float(value)
                except ValueError:
                    quality = 0
        qualities[coding.strip()] = quality
    return 0 < qualities.get("gzip", qualities.get("*", 0)) <= 1


def save_panel_config(raw):
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(raw, f, ensure_ascii=False, indent=2)
    os.replace(tmp, CONFIG_PATH)


def update_panel_config(body):
    c = load_config()
    raw = read_json(CONFIG_PATH)
    if not isinstance(raw, dict):
        raise ValueError("配置文件 %s 读不出来（可能被改坏了），为免覆盖没有保存" % CONFIG_PATH)
    for k in ("planner", "synthesizer", "default_worker", "handoff_by"):
        if k in body:
            if body[k] not in c["agents"]:
                raise ValueError("没有这个 agent：%s" % body[k])
            raw[k] = body[k]
    if "council_agents" in body:
        ca = body["council_agents"]
        if not isinstance(ca, list) or not all(isinstance(x, str) and x in c["agents"] for x in ca):
            raise ValueError("会审成员设置不对")
        members = list(dict.fromkeys(ca))
        if len(members) < 2:
            raise ValueError("会审至少要选两位成员")
        raw["council_agents"] = members
    if "pressure_prompt" in body:
        pp = body["pressure_prompt"]
        if not isinstance(pp, str) or len(pp) > 20000:
            raise ValueError("高压模式提示词必须是文字，最多 2 万字")
        raw["pressure_prompt"] = pp
    ae = body.get("agent_enabled")
    if "agent_enabled" in body:
        if not isinstance(ae, dict) or ae.get("agent") not in c["agents"] or not isinstance(ae.get("on"), bool):
            raise ValueError("成员开关格式不对")
        dis = [x for x in (raw.get("disabled_agents") or []) if x in c["agents"] and x != ae["agent"]]
        if not ae["on"]:
            dis.append(ae["agent"])
            if len(dis) >= len(c["agents"]):
                raise ValueError("至少要留一位成员启用")
        raw["disabled_agents"] = dis
    me = body.get("model_enabled")
    if "model_enabled" in body:
        if not isinstance(me, dict) or not isinstance(me.get("on"), bool) or me.get("spec") not in set(o["spec"] for o in backend_choices(c)):
            raise ValueError("模型开关格式不对")
        dis = [x for x in (raw.get("disabled_models") or []) if isinstance(x, str) and x != me["spec"]]
        if not me["on"]:
            dis.append(me["spec"])
        raw["disabled_models"] = dis
    if "auto_title" in body:
        if body["auto_title"] != "" and body["auto_title"] not in c["agents"]:
            raise ValueError("没有这位成员")
        raw["auto_title"] = body["auto_title"]
    if "quota_guard" in body:
        if not isinstance(body["quota_guard"], bool):
            raise ValueError("开关格式不对")
        raw["quota_guard"] = body["quota_guard"]
    if "codex_effort" in body:
        if body["codex_effort"] != "" and body["codex_effort"] not in effort_levels("codex"):
            raise ValueError("思考强度不对")
        raw["codex_effort"] = body["codex_effort"]
    ef = body.get("effort")
    if "effort" in body:
        if not isinstance(ef, dict) or ef.get("agent") not in c["agents"]:
            raise ValueError("思考等级设置不对")
        if ef.get("level") != "" and ef.get("level") not in effort_levels((c["agents"][ef["agent"]] or [""])[0]):
            raise ValueError("这个模型没有「%s」这一档" % ef.get("level"))
        cur = raw.get("effort") if isinstance(raw.get("effort"), dict) else {}
        cur[ef["agent"]] = ef["level"]
        raw["effort"] = cur
    tr_key = next((k for k in TIERS if k in body), None)
    if tr_key:
        th = body.get(tr_key)
        if not isinstance(th, dict) or th.get("agent") not in c["agents"]:
            raise ValueError("%s模型设置不对" % TIER_NAMES[tr_key])
        cur = raw.get(tr_key) if isinstance(raw.get(tr_key), dict) else {}
        one = dict(cur.get(th["agent"]) if isinstance(cur.get(th["agent"]), dict) else {})
        if "spec" in th:
            sp = th["spec"]
            if sp != "" and sp not in set(o["spec"] for o in backend_choices(c)):
                raise ValueError("不认识这个模型：%s" % sp)
            if sp and sp in (c.get("disabled_models") or []):
                raise ValueError("这个模型已停用，先在设置的「可用模型」里勾回来")
            if sp != one.get("spec"):
                one["effort"] = ""  # 换了模型，原来的档位不一定还有
            one["spec"] = sp
        if "effort" in th:
            tsp = one.get("spec") or (c["agents"][th["agent"]] or [""])[0]
            if th["effort"] != "" and th["effort"] not in effort_levels(tsp):
                raise ValueError("这个模型没有「%s」这一档" % th["effort"])
            one["effort"] = th["effort"]
        cur[th["agent"]] = one
        raw[tr_key] = cur
    ch = body.get("chain")
    if "chain" in body and not isinstance(ch, dict):
        raise ValueError("模型设置格式不对")
    if isinstance(ch, dict):
        name, spec = ch.get("agent"), ch.get("spec")
        if name not in c["agents"]:
            raise ValueError("没有这个 agent：%s" % name)
        if spec not in set(o["spec"] for o in backend_choices(c)):
            raise ValueError("不认识这个模型：%s" % spec)
        if spec in (c.get("disabled_models") or []):
            raise ValueError("这个模型已停用，先在设置的「可用模型」里勾回来")
        chain = list(c["agents"][name])
        idx = ch.get("index", 0)
        if type(idx) is not int:
            raise ValueError("位置必须是整数")
        if not 0 <= idx < len(chain):
            raise ValueError("位置不对")
        chain[idx] = spec
        raw.setdefault("agents", {})[name] = chain
    for k, lo, hi in (("max_parallel", 1, 8), ("timeout", 60, 7200),
                      ("idle_timeout", 60, 1800), ("hard_timeout", 300, 14400),
                      ("compact_gemini", 0, 2000000), ("compact_gpt", 0, 2000000), ("compact_claude", 0, 2000000)):
        if k in body:
            v = body[k]
            if type(v) is not int:
                raise ValueError("%s 必须是整数" % k)
            if not lo <= v <= hi:
                raise ValueError("%s 需在 %d~%d 之间" % (k, lo, hi))
            raw[k] = v
    save_panel_config(raw)

def serve_ui(port, me):
    import mimetypes
    import secrets
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import parse_qs, urlparse

    token = secrets.token_hex(16)
    os.makedirs(os.path.join(UI_WORKSPACE, "images"), exist_ok=True)
    lan_on = bool(load_config().get("lan_access"))  # 打开了才监听局域网；否则只有本机能连
    limiter = PairLimiter()
    restart = {"on": False}
    clients = {}  # 页面 id -> 最近一次来取数据的时间
    clients_lock = threading.Lock()
    state_lock = threading.Lock()
    snapshots = {False: OrderedDict(), True: OrderedDict()}
    html_lock = threading.Lock()
    html_cache = {}

    def dashboard_html():
        path = UI_HTML if os.path.exists(UI_HTML) else os.path.join(os.path.dirname(os.path.realpath(me)), "ui.html")
        with html_lock:
            sig = record_version(path)
            if not sig or html_cache.get("version") != sig:
                with open(path, encoding="utf-8") as f:
                    body = f.read().replace("__HUB_TOKEN__", token).encode("utf-8")
                html_cache.update(version=sig, body=body, gzipped=gzip.compress(body, compresslevel=1, mtime=0))
            return html_cache["body"], html_cache["gzipped"]

    def get_state(remote, compact, version):
        cfg = load_config()
        st = ui_state(cfg, compact)
        st["client"] = {"remote": remote}
        st["lan"] = {"enabled": bool(cfg.get("lan_access")), "listening": lan_on}
        if not compact:
            return st
        recent = snapshots[remote]
        latest = next(reversed(recent), None)
        if latest is None or st != recent[latest]:
            if latest is not None:
                # 复用未变化的部分，多个窗口可以从各自上一版追上。
                st = {k: recent[latest][k] if v == recent[latest][k] else v for k, v in st.items()}
            latest = secrets.token_hex(8)
            recent[latest] = st
            if len(recent) > 8:
                recent.popitem(last=False)
        if version == latest:
            return {"version": latest}
        if version not in recent:
            return {"version": latest, **st}
        before = recent[version]
        changed = {k: v for k, v in st.items() if v != before[k]}
        for key in ("calls", "runs"):
            if key in changed:
                changed[key] = history_patch(before[key], st[key])
        return {"version": latest, "changes": changed}

    def launch(cmd, cwd, text, meta):
        env = {k: v for k, v in os.environ.items() if not k.startswith("HUB_") or k == "HUB_HOME"}
        env["HUB_META"] = json.dumps(meta, ensure_ascii=False)
        if meta.get("full"):
            env["HUB_FULL"] = "1"
        with open(os.path.join(HUB_HOME, "ui-submits.log"), "a", encoding="utf-8") as logf:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=logf, stderr=logf, cwd=cwd, env=env,
                                 start_new_session=True)
        try:
            p.stdin.write(text.encode("utf-8"))
        finally:
            p.stdin.close()
            threading.Thread(target=p.wait, daemon=True).start()

    def do_submit(body, remote=False):
        if remote and (body.get("write") or body.get("mode") == "image") and body.get("confirm_write") is not True:
            raise ValueError("在手机上允许改文件（画图也会存文件），需要再确认一次")
        if remote:  # 手机上不能指定电脑上的目录，一律用 Hub 自己的工作目录，也不回显电脑上的路径
            body = dict(body, cwd="")
        if not isinstance(body.get("text"), str):
            raise ValueError("内容必须是文字")
        if "cwd" in body and not isinstance(body["cwd"], str):
            raise ValueError("工作目录格式不对")
        if "write" in body and not isinstance(body["write"], bool):
            raise ValueError("允许改文件必须是开或关")
        text = body["text"].strip()
        mode, agent = body.get("mode"), body.get("agent")
        cwd = os.path.expanduser(str(body.get("cwd") or "").strip()) or UI_WORKSPACE
        c = load_config()
        if not text:
            raise ValueError("内容是空的")
        if mode not in ("run", "pressure", "ask", "image", "council", "chat", "side"):
            raise ValueError("方式不对")
        if mode in ("ask", "side") and agent not in c["agents"]:
            raise ValueError("没有这个 agent")
        live = active_cfg(c)
        if mode in ("ask", "side", "chat") and agent in c["agents"] and agent not in live["agents"]:
            raise ValueError(disabled_reason(c, agent))
        if mode == "pressure" and "ds" not in live["agents"]:
            raise ValueError("高压模式需要 ds（DeepSeek），它现在停用了")
        if mode == "image" and "gpt" not in live["agents"]:
            raise ValueError("画图要用 gpt，它现在停用了")
        side = []
        if mode == "side":  # 旁问：只读，可指定模型、档位、联网
            if body.get("write"):
                raise ValueError("旁问只读，不能允许改文件")
            sp, ef = body.get("spec") or "", body.get("effort")
            if sp:
                if sp not in enabled_specs(c):
                    raise ValueError("这个模型不认识或已停用：%s" % sp)
                side += ["--spec", sp]
            if ef not in (None, ""):
                if ef not in effort_levels(sp or (c["agents"][agent] or [""])[0]):
                    raise ValueError("这个模型没有「%s」这一档" % ef)
                side += ["--effort", ef]
            if "web" in body and not isinstance(body["web"], bool):
                raise ValueError("联网搜索必须是开或关")
            if body.get("web"):
                side.append("--web")
        if mode == "chat" and agent not in list(c["agents"]) + ["auto"]:
            raise ValueError("没有这个联络人")
        if not ensure_cwd(cwd):
            raise ValueError("工作目录不存在，也没法自动建（只会在你的个人文件夹里自动建）：%s" % (body.get("cwd") or cwd))
        cwd = os.path.abspath(cwd)
        meta = {"display": text, "submission_id": uuid.uuid4().hex}
        imgs = body.get("images") or []
        if not isinstance(imgs, list) or len(imgs) > MAX_IMAGES or not all(attachment_path(n) for n in imgs):
            raise ValueError("图片不对或已经不在了（最多 %d 张），请重新贴" % MAX_IMAGES)
        if imgs and mode == "image":
            raise ValueError("画图暂时不支持参考图")
        if imgs:
            meta["images"] = list(dict.fromkeys(imgs))
        ctx = body.get("context", {})
        if not isinstance(ctx, dict):
            raise ValueError("追问记录格式不对")
        full = text
        if ctx:
            if ctx.get("type") not in ("call", "run") or not isinstance(ctx.get("id"), str):
                raise ValueError("追问记录格式不对")
            kind, rid = conversation_ref(ctx["type"], ctx["id"])
            scope = body.get("context_scope", "full")
            if scope not in ("full", "one"):
                raise ValueError("上下文范围不对")
            pre = follow_context(kind, rid, 1 if scope == "one" else 8)
            meta["scope"] = scope
            if not pre:
                raise ValueError("找不到要追问的记录")
            full = pre + text
            meta["follows"] = {"type": kind, "id": rid}
            if "fork" in body and not isinstance(body["fork"], bool):
                raise ValueError("分叉必须是开或关")
            if body.get("fork"):  # 从这里分出一条新线：带上到这里为止的上下文，之后各走各的
                if mode == "side":
                    raise ValueError("旁问不用分叉")
                meta["fork"] = True
        if meta.get("images"):
            full += image_note([attachment_path(n) for n in meta["images"]])
        if mode == "image":
            out = os.path.join(UI_WORKSPACE, "images", "img-%s-%s.png" % (time.strftime("%Y%m%d-%H%M%S"),
                                                                           uuid.uuid4().hex[:4]))
            cmd = ["image", "-o", out]
            cwd = UI_WORKSPACE
        elif mode == "council":
            cmd = ["council", "-w", cwd]
            ag, sy = body.get("agents"), body.get("synthesizer")
            if ag is not None:  # 重新执行时沿用当时的成员和综合者
                if not isinstance(ag, list) or not ag or not all(isinstance(x, str) and x in c["agents"] for x in ag):
                    raise ValueError("会审成员不对")
                ag = [x for x in ag if x in live["agents"]]  # 重新执行时，现在停用的成员不再叫
                if not ag:
                    raise ValueError("当时参加会审的成员现在都停用了")
                cmd += ["--agents", ",".join(ag)]
            if sy is not None:
                if sy not in c["agents"]:
                    raise ValueError("综合者不对")
                cmd += ["--synthesizer", sy]
        else:
            if mode in ("pressure", "chat"):
                cmd = ["chat", "--contact", "ds", "--pressure"] if mode == "pressure" else ["chat", "--contact", agent]
            elif mode == "side":
                cmd = ["ask", agent, "--side"] + side
            else:
                cmd = ["ask", agent] if mode == "ask" else ["run"]
            cmd += ["-w", cwd]
            if body.get("write"):
                cmd.append("--write")
        if body.get("write") and mode != "image":
            meta["full"] = True
        launch([sys.executable, me, *cmd, "-"], cwd, full, meta)
        return meta["submission_id"]

    cfg_lock = threading.Lock()

    class H(BaseHTTPRequestHandler):
        timeout = 15  # 只连不发的连接 15 秒后断开，免得把服务拖死

        def log_message(self, *a):
            pass

        def send(self, code, body, ctype="application/json; charset=utf-8", gzipped=None):
            if not isinstance(body, bytes):
                body = json.dumps(body, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
            compressible = ctype.startswith(("text/html", "application/json"))
            compressed = None
            if compressible and len(body) >= 512 and accepts_gzip(",".join(self.headers.get_all("Accept-Encoding", []))):
                compressed = gzipped if gzipped is not None else gzip.compress(body, compresslevel=1, mtime=0)
                if len(compressed) < len(body):
                    body = compressed
                else:
                    compressed = None
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            if compressible:
                self.send_header("Vary", "Accept-Encoding")
            if compressed is not None:
                self.send_header("Content-Encoding", "gzip")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Frame-Options", "DENY")
            if not ctype.startswith("text/html"):
                self.send_header("Content-Security-Policy", "default-src 'none'; sandbox")
            self.end_headers()
            try:
                self.wfile.write(body)
            except OSError:
                pass

        def check(self, path):  # 本机直接放行；局域网设备必须已配对；其它一律拒绝
            try:
                sock_ip = self.connection.getsockname()[0]
            except OSError:
                sock_ip = ""
            return gate(self.client_address[0], self.headers.get("Host", ""), sock_ip, port, path,
                        self.headers.get("Cookie", ""), lan_on)

        def remote(self):
            return ip_kind(self.client_address[0]) != "local"

        def do_pair(self, q):
            import hmac
            ip = self.client_address[0]
            html = "text/html; charset=utf-8"
            code = q.get("code") or ""
            if not code:  # 只是打开配对页，不算试错
                return self.send(200, phone_page("和电脑配对", "请在电脑上打开 Hub → 设置 → 用手机控制，扫那里的二维码；或把配对码填在下面。"), html)
            d = pair_load(create=False)  # 未配对的请求绝不触发生成或重置配对码
            if not d:
                return self.send(403, phone_page("还不能配对", "请先在电脑上打开「手机访问」。"), html)
            r = limiter.attempt(ip, lambda: hmac.compare_digest(code.encode("utf-8", "replace"), d["code"].encode("utf-8")))
            if r == "blocked":
                return self.send(429, phone_page("试错太多次了", "为了安全，请 10 分钟后再试；或在电脑上重置配对码。"), html)
            if r == "bad":
                return self.send(403, phone_page("配对码不对", "请在电脑上打开 Hub → 设置 → 用手机控制，重新扫码或核对配对码。"), html)
            self.send_response(303)
            self.send_header("Location", "/")
            self.send_header("Set-Cookie", "%s=%s; HttpOnly; SameSite=Lax; Path=/; Max-Age=31536000"
                             % (PAIR_COOKIE, pair_cookie_value(d["code"])))
            self.send_header("Content-Length", "0")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Referrer-Policy", "no-referrer")
            self.end_headers()

        def do_GET(self):
            u = urlparse(self.path)
            q = {k: v[0] for k, v in parse_qs(u.query).items()}
            err = self.check(u.path)
            if err:
                if err[0] == 401 and u.path in ("/", "/index.html"):
                    return self.send(401, phone_page("这台手机还没配对", "请在电脑上打开 Hub → 设置 → 用手机控制，用手机扫那里的二维码；"
                                                     "也可以把电脑上显示的配对码填在下面。"), "text/html; charset=utf-8")
                return self.send(err[0], {"ok": False, "error": err[1]})
            if u.path == "/pair":
                return self.do_pair(q)
            if u.path == "/api/pair":
                if self.remote():
                    return self.send(403, {"ok": False, "error": "配对信息只能在电脑上看"})
                d, ips = pair_load(), lan_ips()
                urls = ["http://%s:%d/pair?code=%s" % (ip, port, d["code"]) for ip in ips]
                return self.send(200, {"enabled": bool(load_config().get("lan_access")), "listening": lan_on,
                                       "code": d["code"], "urls": urls, "qr": qr_svg(urls[0]) if urls else None})
            if u.path == "/api/dsh/plugins":
                if self.remote():
                    return self.send(403, {"ok": False, "error": "插件设置只能在电脑上看"})
                return self.send(200, dsh_plugins_state())
            if u.path == "/icon.png":
                return self.send(200, app_icon_png(), "image/png")
            if u.path == "/":
                try:
                    html, gzipped = dashboard_html()
                except OSError:
                    return self.send(500, "找不到界面文件 %s" % UI_HTML, "text/plain; charset=utf-8")
                return self.send(200, html, "text/html; charset=utf-8", gzipped)
            if u.path == "/api/state":
                # 没带编号的是旧版页面，也算一个窗口
                with clients_lock:
                    clients[q["c"] if re.fullmatch(r"[a-z0-9]{4,20}", q.get("c") or "") else "old"] = time.time()
                with state_lock:
                    st = get_state(self.remote(), q.get("compact") == "1", q.get("v"))
                return self.send(200, st)
            if u.path == "/api/clients":
                now = time.time()
                with clients_lock:
                    for k in [k for k, v in clients.items() if now - v > 75]:
                        clients.pop(k, None)
                    count = len(clients)
                return self.send(200, {"n": count})
            if u.path in ("/api/call", "/api/run"):
                r = ui_record(u.path.rsplit("/", 1)[1], q.get("id"))
                return self.send(200 if r else 404, r or {"ok": False, "error": "没有这条记录"})
            if u.path == "/api/attachment":
                p = attachment_path(q.get("id"))
                if not p:
                    return self.send(404, {"ok": False, "error": "没有图片"})
                ctype = {"png": "image/png", "jpg": "image/jpeg", "webp": "image/webp", "gif": "image/gif"}[p.rsplit(".", 1)[1]]
                with open(p, "rb") as f:
                    return self.send(200, f.read(), ctype)
            if u.path == "/api/file":
                rec = ui_record(q.get("type"), q.get("id")) if q.get("id") else None
                try:
                    v = file_view(q.get("path"), rec)
                except (ValueError, OSError) as e:
                    return self.send(404, {"ok": False, "error": str(e)})
                if q.get("raw"):
                    ctype = FILE_IMG_EXT.get(os.path.splitext(v["path"])[1].lower())
                    if v["kind"] != "image" or not ctype:
                        return self.send(404, {"ok": False, "error": "不是图片"})
                    with open(v["path"], "rb") as f:
                        return self.send(200, f.read(), ctype)
                return self.send(200, v)
            if u.path == "/api/image":
                c = ui_call(q.get("id"))
                p = (c or {}).get("image")
                ctype = mimetypes.guess_type(p or "")[0] or ""
                if not p or not os.path.isfile(p) or ctype not in ("image/png", "image/jpeg", "image/webp", "image/gif"):
                    return self.send(404, {"ok": False, "error": "没有图片"})
                with open(p, "rb") as f:
                    return self.send(200, f.read(), ctype)
            return self.send(404, {"ok": False, "error": "not found"})

        def do_POST(self):
            u = urlparse(self.path)
            err = self.check(u.path)
            if err:
                return self.send(err[0], {"ok": False, "error": err[1] if err[0] == 401 else "页面已过期，请刷新"})
            remote = self.remote()
            if remote and u.path not in REMOTE_POSTS:
                return self.send(403, {"ok": False, "error": "这个操作只能在电脑上做"})
            if u.path == "/api/bye":  # 页面关闭时的告别，不需要令牌
                cid = parse_qs(u.query).get("c", [""])[0]
                with clients_lock:
                    clients.pop(cid, None)
                return self.send(200, {"ok": True})
            if not secrets.compare_digest((self.headers.get("X-Hub-Token") or "").encode("utf-8", "replace"), token.encode()):
                return self.send(403, {"ok": False, "error": "页面已过期，请刷新"})
            try:
                length = int(self.headers.get("Content-Length") or 0)
                if not 0 <= length <= (16 if u.path == "/api/upload" else 1) * 1024 * 1024:
                    raise ValueError("请求内容过长")
                body = json.loads(self.rfile.read(length).decode("utf-8") or "{}")
                if not isinstance(body, dict):
                    raise ValueError("请求格式不对")
                if self.path == "/api/submit":
                    submission_id = do_submit(body, remote)
                    return self.send(200, {"ok": True, "submission_id": submission_id})
                elif self.path == "/api/stop":
                    err = stop_record(body.get("type"), body.get("id"))
                    if err:
                        raise ValueError(err)
                elif self.path == "/api/upload":  # 粘贴/拖进来的图片：{data: base64}
                    try:
                        raw = base64.b64decode(str(body.get("data") or "").split(",")[-1], validate=True)
                    except (ValueError, binascii.Error):
                        raise ValueError("图片数据坏了，请重新贴")
                    return self.send(200, {"ok": True, "id": save_attachment(raw)})
                elif self.path == "/api/handoff":  # 把一组的结果交接到另一组
                    return self.send(200, {"ok": True, "id": make_handoff(body.get("from"), body.get("to"), body.get("title"),
                                                                       keys=body.get("keys"), cfg=active_cfg(load_config()))})
                elif self.path == "/api/compact":  # 原地压缩这一组
                    return self.send(200, {"ok": True, "id": make_compact(body.get("at"), body.get("keys"), active_cfg(load_config()), body.get("title"))})
                elif self.path == "/api/handoff/undo":  # 撤销交接
                    return self.send(200, {"ok": True, "back": undo_handoff(body.get("id"))})
                elif self.path == "/api/awake":  # 不休眠开关；记进配置，下次打开面板照旧
                    if not isinstance(body.get("on"), bool):
                        raise ValueError("开关格式不对")
                    with cfg_lock:
                        raw = read_json(CONFIG_PATH) or {}
                        raw["keep_awake"] = body["on"]
                        save_panel_config(raw)
                    return self.send(200, {"ok": True, "on": set_awake(body["on"])})
                elif self.path == "/api/keep/close":  # 关掉开着的 Gemini 会话（"all" = 全部）
                    ids = [d["id"] for d in keep_list()] if body.get("id") == "all" else [body.get("id")]
                    return self.send(200, {"ok": True, "closed": sum(1 for k in ids if keep_close(k))})
                elif self.path == "/api/rename":
                    set_name(body.get("key"), body.get("name"))
                elif self.path == "/api/folders":
                    return self.send(200, {"ok": True, "id": folder_op(body)})
                elif self.path == "/api/title/backfill":  # 给开启自动起名之前的项目组也起名（归档的不起）
                    set_name_since(0)
                elif self.path == "/api/archive":
                    set_archived(body.get("keys"), body.get("on"))
                elif self.path == "/api/health":
                    run_health()
                elif self.path == "/api/quota":
                    refresh_quota()
                elif self.path == "/api/login":
                    c = load_config()
                    chain = c["agents"].get(body.get("agent")) or []
                    if not chain:
                        raise ValueError("没有这个 agent")
                    open_login(c, chain[0].partition(":")[0])
                elif self.path == "/api/notify":  # 原生窗口里没有网页通知，改由系统通知中心发
                    subprocess.Popen(["osascript", "-e", "on run argv", "-e",
                                      "display notification (item 2 of argv) with title (item 1 of argv)",
                                      "-e", "end run", str(body.get("title") or "Hub")[:80],
                                      str(body.get("body") or "")[:200]],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                elif self.path == "/api/config":
                    with cfg_lock:
                        update_panel_config(body)
                elif self.path == "/api/dsh/plugins":
                    return self.send(200, dsh_plugins_update(body))
                elif self.path == "/api/lan":  # 只能在电脑上开关（上面已拒绝手机）
                    if not isinstance(body.get("enable"), bool):
                        raise ValueError("开关格式不对")
                    with cfg_lock:
                        raw = read_json(CONFIG_PATH)
                        if not isinstance(raw, dict):
                            raise ValueError("配置文件读不出来，没有保存")
                        raw["lan_access"] = body["enable"]
                        save_panel_config(raw)
                    if body["enable"]:
                        pair_load()
                    if body["enable"] != lan_on:  # 换监听地址需要重启面板服务，页面会自动重连
                        restart["on"] = True
                        threading.Timer(0.5, srv.shutdown).start()
                    return self.send(200, {"ok": True, "restarting": restart["on"]})
                elif self.path == "/api/pair/reset":
                    pair_reset()
                    limiter.clear()  # 重置后给新配对码一个干净的开始
                elif self.path == "/api/open":
                    r = ui_record(body.get("type"), body.get("id")) if body.get("id") else None
                    if body.get("what") == "file":
                        p = file_target(body.get("path"), r)
                        if not p:
                            raise ValueError("找不到这个文件，或者它不在能打开的范围里")
                        reveal = body.get("reveal") or not (os.path.isdir(p) or os.path.splitext(p)[1].lower() in FILE_OPEN_EXT)
                        subprocess.call(["open", "-R", p] if reveal else ["open", p])  # 不认识的类型（比如程序）只在访达里标出来，不直接运行
                        return self.send(200, {"ok": True, "revealed": bool(reveal)})
                    if not r:
                        raise ValueError("没有这条记录")
                    if body.get("what") == "image" and r.get("image") and os.path.isfile(r["image"]):
                        subprocess.call(["open", "-R", r["image"]])
                    elif r.get("cwd") and os.path.isdir(r["cwd"]):
                        subprocess.call(["open", r["cwd"]])
                    else:
                        raise ValueError("目录不存在")
                else:
                    return self.send(404, {"ok": False, "error": "not found"})
                return self.send(200, {"ok": True})
            except (ValueError, OSError, TypeError) as e:
                return self.send(400, {"ok": False, "error": str(e)})

    class Server(ThreadingHTTPServer):
        daemon_threads = True

        def verify_request(self, request, client_address):  # 不是本机或家里局域网的连接，不开线程直接关
            return ip_kind(client_address[0]) in (("local", "private") if lan_on else ("local",))

    srv = Server(("0.0.0.0" if lan_on else "127.0.0.1", port), H)
    guard = None
    if lan_on:
        # 只占 0.0.0.0 时，macOS 上别的程序还能单独占住 127.0.0.1 的同一个端口，
        # Hub 窗口（连的是 127.0.0.1）就会被它的网页顶掉。把本机地址也占上，别人就绑不上了。
        try:
            guard = Server(("127.0.0.1", port), H)
            threading.Thread(target=guard.serve_forever, daemon=True).start()
        except OSError:
            guard = None
    write_json(UI_PID, {"pid": os.getpid(), "port": port})
    if load_config().get("keep_awake") and not os.environ.get("HUB_NO_AWAKE"):
        try:
            set_awake(True)
        except (ValueError, OSError) as e:
            eprint("[hub] 不休眠没开成：%s" % e)
    eprint("[hub] 面板服务已启动：http://127.0.0.1:%d/%s" % (port, "（手机局域网访问已打开）" if lan_on else ""))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    srv.server_close()
    if guard:
        guard.shutdown()
        guard.server_close()
    set_awake(False)
    if restart["on"]:
        _reexec_ui(port, me)
    return 0


# ---------------------------------------------------------------- 命令行

def read_prompt(parts):
    text = " ".join(parts).strip()
    if text in ("", "-"):
        text = sys.stdin.read().strip()
    if not text:
        raise SystemExit("缺少内容")
    return text


def cmd_agents(cfg, args):
    names = [args.agent] if args.agent else list(cfg["agents"])
    status = check_specs(cfg, names)
    for n in names:
        print("%s —— %s" % (n, cfg["profiles"].get(n, "")))
        for i, sp in enumerate(cfg["agents"][n]):
            st = status[sp]
            print("   %s %-28s %s %s" % ("首选" if i == 0 else "后备", sp, "✔" if st["ok"] else "✘", st["msg"]))
    return 0


def cmd_log(args):
    if not os.path.exists(LOG_PATH):
        print("还没有调用记录")
        return 0
    with open(LOG_PATH, encoding="utf-8") as f:
        lines = f.readlines()[-args.n:]
    for ln in lines:
        try:
            r = json.loads(ln)
        except ValueError:
            continue
        print("%s %s %-7s %-26s %6ss  %s" % (r.get("ts"), "✔" if r.get("ok") else "✘", r.get("agent"),
                                             r.get("backend"), r.get("secs"),
                                             (r.get("error") or r.get("prompt") or "").replace("\n", " ")[:70]))
    return 0


def main():
    full_cfg = load_config()
    cfg = active_cfg(full_cfg)  # 停用的成员和模型不参与干活
    ap = argparse.ArgumentParser(prog="hub", description="本机多 Agent 调度器")
    sub = ap.add_subparsers(dest="cmd")

    a = sub.add_parser("ask", help="让某个 agent 回答/干活")
    a.add_argument("agent", choices=list(full_cfg["agents"]))
    a.add_argument("prompt", nargs="+", help="内容；写 - 则从标准输入读")
    a.add_argument("-w", "--cwd", help="工作目录（默认当前目录）")
    a.add_argument("--write", action="store_true", help="允许它创建/修改工作目录里的文件")
    a.add_argument("--model", help="指定首选后端的模型")
    a.add_argument("--timeout", type=int)
    a.add_argument("--spec", help="这次先用哪个模型（如 codex:gpt-6-astra、agy:gemini-4-carbon-high）")
    a.add_argument("--effort", help="这次用的思考档位（这个模型自己的档位名）")
    a.add_argument("--web", action="store_true", help="允许联网搜索")
    a.add_argument("--side", action="store_true", help="作为旁问记录（不进主线）")

    r = sub.add_parser("run", help="规划 -> 并行分工 -> 汇总")
    r.add_argument("goal", nargs="+", help="目标；写 - 则从标准输入读")
    r.add_argument("-w", "--cwd")
    r.add_argument("--write", action="store_true", help="允许队员创建/修改文件")
    r.add_argument("--planner", default=cfg["planner"], choices=list(cfg["agents"]))
    r.add_argument("--synthesizer", default=cfg["synthesizer"], choices=list(cfg["agents"]))
    r.add_argument("--max-parallel", type=int, default=cfg["max_parallel"])
    r.add_argument("--max-tasks", type=int, default=6)
    r.add_argument("--dry", action="store_true", help="只出方案不执行")
    r.add_argument("--pressure", action="store_true",
                   help="高压模式：由 ds 拆任务和汇总，拆任务前先注入设置里的「高压模式提示词」")

    co = sub.add_parser("council", help="会审：几位各自独立作答，再比较共同点和分歧（只读）")
    co.add_argument("question", nargs="+", help="问题；写 - 则从标准输入读")
    co.add_argument("-w", "--cwd")
    co.add_argument("--agents", help="参加的成员，用逗号分隔（默认看配置 council_agents）")
    co.add_argument("--synthesizer", choices=list(cfg["agents"]), help="负责比较意见的成员（默认看配置 synthesizer）")

    ch = sub.add_parser("chat", help="跟联络人说话：它自己答，或替你派活给团队")
    ch.add_argument("message", nargs="+", help="内容；写 - 则从标准输入读")
    ch.add_argument("--contact", default="auto", help="联络人：auto（按阶段自动选）或成员名")
    ch.add_argument("-w", "--cwd")
    ch.add_argument("--write", action="store_true", help="派给团队的活允许改文件")
    ch.add_argument("--pressure", action="store_true",
                    help="高压模式：由 ds 主导对接，首轮注入「高压模式提示词」，派活时由 ds 排工与汇总")

    im = sub.add_parser("image", help="让 GPT 画图")
    im.add_argument("prompt", nargs="+")
    im.add_argument("-o", "--out", default="hub-image.png")

    g = sub.add_parser("agents", help="体检各 agent")
    g.add_argument("agent", nargs="?", choices=list(cfg["agents"]))
    ui = sub.add_parser("ui", help="打开网页面板：看谁在干什么、协作过程与内容")
    ui.add_argument("--port", type=int, default=8765)
    ui.add_argument("--serve", action="store_true", help="在前台运行面板服务（一般不需要）")
    ui.add_argument("--stop", action="store_true", help="停止后台的面板服务")
    ui.add_argument("--browser", action="store_true", help="用默认浏览器打开，而不是独立窗口")
    ui.add_argument("--no-window", action="store_true", help="只确保面板服务在运行，不打开窗口")
    sub.add_parser("quota", help="查看各 agent 的剩余额度")
    lg = sub.add_parser("log", help="最近调用记录")
    lg.add_argument("-n", type=int, default=20)

    args = ap.parse_args()
    signal.signal(signal.SIGTERM, _on_stop)
    signal.signal(signal.SIGINT, _on_stop)
    try:
        if args.cmd == "ask":
            warn = timeout_warning(args.timeout or cfg["timeout"])
            if warn:
                eprint("[hub] 提醒：" + warn)
            if args.spec and args.spec not in enabled_specs(full_cfg):
                raise BackendError("这个模型不认识或已停用：%s" % args.spec)
            text, _ = ask(cfg, args.agent, read_prompt(args.prompt), cwd=args.cwd, write=args.write,
                          timeout=args.timeout, model=args.model, spec=args.spec, effort=args.effort,
                          web=args.web, meta={"kind": "side"} if args.side else None)
            print(text)
            return 0
        if args.cmd == "run":
            planner, synth = args.planner, args.synthesizer
            if args.pressure:
                if "ds" not in cfg["agents"]:
                    raise BackendError("高压模式需要 ds（DeepSeek）这位成员，配置里没有")
                planner = synth = "ds"
            return run_goal(cfg, read_prompt(args.goal), args.cwd, args.write, planner,
                            synth, args.max_parallel, args.max_tasks, args.dry, pressure=args.pressure)
        if args.cmd == "council":
            members = [x.strip() for x in args.agents.split(",") if x.strip()] if args.agents else None
            if members and any(m not in cfg["agents"] for m in members):
                raise BackendError("不认识的成员：%s（可选：%s）" % (args.agents, ", ".join(cfg["agents"])))
            return run_council(cfg, read_prompt(args.question), args.cwd, members, args.synthesizer)
        if args.cmd == "chat":
            return run_chat(cfg, read_prompt(args.message), args.cwd, args.write, args.contact, pressure=args.pressure)
        if args.cmd == "image":
            out = os.path.abspath(args.out)
            os.makedirs(os.path.dirname(out), exist_ok=True)
            before = os.stat(out).st_mtime_ns if os.path.exists(out) else None
            desc = read_prompt(args.prompt)
            image_call = []
            text, _ = ask(cfg, "gpt",
                          "用你的图片生成能力生成一张图片，并把最终图片文件保存（复制）到 %s 。"
                          "图片要求：%s\n完成后只回复保存路径。" % (out, desc),
                          cwd=os.path.dirname(out), write=True, note=False,
                          meta={"kind": "image", "title": "画图：" + desc[:40], "image": out, "display": desc,
                                "on_start": image_call.append})
            print(text)
            if (not os.path.exists(out) or os.path.getsize(out) == 0
                    or os.stat(out).st_mtime_ns == before):
                error = "没有生成新的图片文件：%s" % out
                if image_call:
                    path = os.path.join(CALLS_DIR, image_call[0] + ".json")
                    rec = read_json(path)
                    if rec:
                        rec.update(status="fail", error=error)
                        write_json(path, rec)
                eprint("[hub] " + error)
                return 1
            return 0
        if args.cmd == "agents":
            return cmd_agents(cfg, args)
        if args.cmd == "quota":
            for name, q in fetch_quota(cfg)["agents"].items():
                if q.get("balance"):
                    print("%-7s 余额 %s%s" % (name, q["balance"], "" if q.get("available") else "（余额不足）"))
                elif q.get("windows"):
                    print("%-7s %s" % (name, "   ".join("%s 剩 %d%%%s" % (
                        w["label"], round(w["remaining"]),
                        time.strftime("（%m-%d %H:%M 重置）", time.localtime(w["resets"])) if w.get("resets") else "")
                        for w in q["windows"])))
                else:
                    print("%-7s %s" % (name, q.get("note", "")))
            return 0
        if args.cmd == "ui":
            return cmd_ui(cfg, args)
        if args.cmd == "log":
            return cmd_log(args)
        ap.print_help()
        return 0
    except BackendError as e:
        eprint("[hub] 失败：%s" % e)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
