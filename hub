STOP_MSG = "已手动停止"
DEAD_MSG = "已中断（进程不在了）"


def pid_alive(pid):
    try:
        if int(pid) <= 1:
            return False
        os.kill(int(pid), 0)
        return True
    except (OSError, TypeError, ValueError):
        return False


class _RecordCache:
    """按文件版本缓存解析结果。shared=True 仅供读数据的调用方使用。"""

    def __init__(self, limit):
        self.limit = limit
        self.records = OrderedDict()
        self.lock = threading.Lock()

    def read(self, path, st=None, *, shared=False):
        with self.lock:
            try:
                st = st or os.stat(path)
            except OSError:
                self.records.pop(path, None)
                return None
            sig = (st.st_dev, st.st_ino, st.st_mtime_ns, st.st_ctime_ns, st.st_size)
            cached = self.records.get(path)
            if cached is None or cached[0] != sig:
                cached = (sig, read_json(path))
                self.records[path] = cached
                if len(self.records) > self.limit:
                    self.records.popitem(last=False)
            self.records.move_to_end(path)
            return cached[1] if shared else copy.deepcopy(cached[1])


_call_records = _RecordCache(1024)  # 最近 400 次调用，加上项目里的旧任务和当前详情
_run_records = _RecordCache(64)
_model_records = _RecordCache(2)


def _load_call(path, st=None, *, shared=False):
    try:
        st = st or os.stat(path)
    except OSError:
        return None
    c = _call_records.read(path, st, shared=shared)
    if not isinstance(c, dict) or "id" not in c:
        return None
    if c.get("status") == "running" and not pid_alive(c.get("pid")):
        pid = c.get("pid")
        c = _call_records.read(path)  # 进程退出前可能刚写好最终结果，不能用扫描时的旧状态覆盖
        if not isinstance(c, dict) or "id" not in c:
            return None
        if c.get("status") != "running" or c.get("pid") != pid:
            return c
        c.update(status="fail", error=DEAD_MSG, end=c.get("end") or st.st_mtime)
        write_json(path, c)  # 落盘，免得日后 PID 被别的进程复用时“复活”
    return c


def _load_run(path, *, shared=False):
    r = _run_records.read(path, shared=shared)
    if not isinstance(r, dict):
        return None
    if r.get("status") in RUN_ACTIVE and not pid_alive(r.get("pid")):
        pid = r.get("pid")
        r = _run_records.read(path)
        if not isinstance(r, dict):
            return None
        if r.get("status") not in RUN_ACTIVE or r.get("pid") != pid:
            return r
        r.update(status="failed", error=r.get("error") or DEAD_MSG, end=r.get("end") or r.get("start"))
        _fail_tasks(r)
        write_json(path, r)
        write_board_md(os.path.dirname(path), r)
    return r


def load_calls(limit=400, *, shared=False):
    try:
        paths = []
        with os.scandir(CALLS_DIR) as entries:
            for entry in entries:
                if entry.name.endswith(".json"):
                    try:
                        paths.append((entry.path, entry.stat()))
                    except OSError:  # 另一个进程可能刚删掉/替换了记录
                        continue
    except OSError:
        return []
    key = lambda item: item[1].st_mtime
    paths = (heapq.nlargest(limit, paths, key=key) if limit is not None and limit >= 0
             else sorted(paths, key=key, reverse=True)[:limit])
    out = []
    for p, st in paths:
        c = _load_call(p, st, shared=shared)
        if c is not None:
            out.append(c)
    out.sort(key=lambda c: c.get("start") or 0, reverse=True)
    return out


def load_runs(limit=40, *, shared=False):
    try:
        ids = sorted(os.listdir(RUNS_DIR), reverse=True)
    except OSError:
        return []
    out = []
    for rid in ids:
        r = _load_run(os.path.join(RUNS_DIR, rid, "run.json"), shared=shared)
        if r is None:
            continue
        out.append(r)
        if len(out) >= limit:
            break
    return out


def _preview(s, n=200):
    return (s or "").strip()[:n]


def check_specs(cfg, names=None):
    """对每个后端做一次真实的小调用。返回 {后端: {ok, msg}}。"""
    names = names or list(cfg["agents"])

    def check(spec):
        kind, _, mdl = spec.partition(":")
        t0 = time.time()
        if kind not in BACKENDS:
            return spec, {"ok": False, "msg": "未知后端"}
        try:
            BACKENDS[kind](cfg, mdl, "只回复两个字：收到", tempfile.gettempdir(), False, 120)
            return spec, {"ok": True, "msg": "%.0fs" % (time.time() - t0)}
        except BackendError as e:
            return spec, {"ok": False, "msg": str(e).replace("\n", " ")[:160]}

    specs = []
    for n in names:
        for sp in cfg["agents"][n]:
            if sp not in specs:
                specs.append(sp)
    with ThreadPoolExecutor(max_workers=6) as pool:
        return dict(pool.map(check, specs))


def call_preferred(c):
    """旧记录从失败尝试恢复当时的首选，不能拿今天的设置判断历史。"""
    attempts = c.get("attempts") or []
    return c.get("preferred_backend") or (attempts[0].get("backend") if attempts else c.get("backend"))


def record_version(path):
    try:
        st = os.stat(path)
        return "%x:%x:%x:%x" % (st.st_ino, st.st_mtime_ns, st.st_ctime_ns, st.st_size)
    except OSError:
        return ""


def ui_call_summary(c, compact=True):
    keys = ("id", "parent", "run", "kind", "agent", "backend", "status", "start", "end", "secs", "write",
            "cwd", "error", "follows", "submission_id", "side", "fork", "resumed", "images", "handoff")
    preferred = call_preferred(c)
    if compact:
        d = {k: c[k] for k in keys + ("pressure",) if c.get(k) is not None}
        if c.get("display") and not (c.get("parent") or c.get("run") or c.get("kind") == "side"):
            d["display"] = c["display"]
        elif c.get("kind") == "image" and c.get("title") and not (c.get("run") or c.get("parent")):
            d["title"] = c["title"]
        else:
            d["prompt_preview"] = _preview(c.get("display") or c.get("prompt"))
        if c.get("chat"):
            d["chat"] = {k: c["chat"][k] for k in ("mode", "write", "pressure") if k in c["chat"]}
        if c.get("dispatch"):
            di = c["dispatch"]
            d["dispatch"] = {"run": di.get("run"), "mode": di.get("mode"), "goal": (di.get("goal") or "")[:80]}
        if preferred and preferred != c.get("backend"):
            d["preferred_backend"] = preferred
        d["rev"] = record_version(os.path.join(CALLS_DIR, c["id"] + ".json"))
    else:
        d = {k: c.get(k) for k in keys + ("task", "title", "display", "chat", "dispatch")}
        d.update(preferred_backend=preferred, prompt_preview=_preview(c.get("display") or c.get("prompt")),
                 answer_preview=_preview(c.get("answer")), has_image=bool(c.get("image") and os.path.isfile(c["image"])),
                 live=live_len(c["id"]) if c.get("status") == "running" else 0)
    if _top_level("call", c):
        d["root"] = group_root("call:" + c["id"])
    return d


def ui_run_summary(r, compact=True):
    keys = ("id", "status", "start", "end", "cwd", "error", "write", "follows", "submission_id",
            "parent_call", "pressure", "fork", "images", "planner", "synthesizer")
    task_keys = ("id", "agent", "title", "status", "skip_reason", "kind", "plan_spec", "spec", "backend", "call_id")
    tasks = r.get("tasks") or []
    if compact:
        d = {k: r[k] for k in keys if r.get(k) is not None}
        d["display"] = r.get("display") or r.get("goal")
        d["rev"] = record_version(os.path.join(RUNS_DIR, r.get("id") or "", "run.json"))
        d["tasks"] = [{k: t[k] for k in task_keys if t.get(k) is not None} for t in tasks]
