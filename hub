def resume_plan(agent, ext, meta, web):
    """追问时能不能直接续接上一轮的原生会话（各家都会缓存会话前文，命中率更高，也不用重发上文）。
    只在「接着上一轮、同一位、同一个模型、上一轮成功（或派过团队，结果补进这一句）、那个会话还没被别的分支接过」时续接；旁问只接旁问；
    分叉、只带一条上文、换人换模型时都不续接，照旧把上文写进提示词新开会话。"""
    f = ext.get("follows") or {}
    if ext.get("fork") or ext.get("scope", "full") != "full" or f.get("type") != "call" \
            or not re.fullmatch(r"c_[0-9a-f]+", str(f.get("id") or "")):
        return None
    tpath = os.path.join(CALLS_DIR, f["id"] + ".json")
    t = read_json(tpath) or {}
    ses = t.get("session") if isinstance(t.get("session"), dict) else {}
    if (t.get("status") != "ok" and not t.get("dispatch")) or t.get("agent") != agent or t.get("kind") not in ("ask", "chat", "side") \
            or t.get("session_continued_by") or not _SID.match(str(ses.get("id") or "")):
        return None
    if (meta.get("kind") == "side") != (t.get("kind") == "side"):  # 旁问另开自己的线，不去抢主对话的会话
        return None
    text = meta.get("resume_prompt") or ext.get("display")
    if not text:
        return None
    if t.get("dispatch") and t.get("status") != "running":  # 上一轮派了活（还在做的话，后台情况另外写在这句话里）：把团队交回的结果补给它，再接着说，不必重读全部前文
        res = (t.get("answer") or "").split("\n\n---\n\n", 1)[-1].strip()
        if t.get("status") != "ok":
            res = "（没有全部完成：%s）\n%s" % (t.get("error") or "", res)
        text = "（上一轮团队任务已结束，以下结果用户已看到：）\n%s\n\n%s" % (res[:12000], text)
    imgs = [p for p in (attachment_path(n) for n in ext.get("images") or []) if p]
    return {"from": f["id"], "path": tpath, "sid": str(ses["id"]), "backend": t.get("backend"),
            "prompt": text + image_note(imgs) + (WEB_NOTE if web else "")}


def ask(cfg, agent, prompt, cwd=None, write=False, timeout=None, model=None, quiet=False, note=True, meta=None,
        spec=None, effort=None, web=False, tier=None):
    """调用某个角色。tier="think" 表示动脑的活，改用这位成员的「动脑模型」。返回 (回答文本, 实际使用的后端描述)。全部后备都失败则抛 BackendError。"""
    if agent not in cfg["agents"] and agent in (cfg.get("_disabled_agents") or []):
        raise BackendError(disabled_reason(cfg, agent))
    if agent not in cfg["agents"]:
        raise BackendError("未知 agent：%s（可选：%s）" % (agent, ", ".join(cfg["agents"])))
    if hub_depth() >= MAX_DEPTH:
        raise BackendError("agent 互相调用已达 %d 层上限，请自己完成这个任务。" % MAX_DEPTH)
    if os.environ.get("HUB_FULL") == "1":  # 面板上打开了「允许改文件」：这次的所有调用（对接人、会审、旁问、任务）都放开
        write = True
    if write and os.environ.get("HUB_READONLY") == "1":
        raise BackendError("上级任务是只读的（例如会审），不能在里面再让队友改文件。")
    if _stopping.is_set():
        raise BackendError(STOP_MSG)
    cwd = os.path.abspath(cwd or os.getcwd())
    if not ensure_cwd(cwd):
        raise BackendError("工作目录不存在，也没法自动建：%s" % cwd)
    timeout = timeout or cfg["timeout"]
    chain = list(cfg["agents"][agent])
    if not chain:
        raise BackendError("%s 没有配置任何后端" % agent)
    if model:
        chain[0] = chain[0].split(":")[0] + ":" + model
    think_eff = ""
    if tier in TIERS and not spec and not model:  # 动脑/审美/文案的活：那一档的模型排第一，失败了再按原来的顺序换备用
        chain, think_eff = tier_chain(cfg, agent, tier)
    if spec:  # 旁问里指定的模型排第一，失败了再按这位成员原来的顺序换备用
        chain = [spec] + [x for x in chain if x != spec]
    # 只有当对方还能再找队友时才告诉它可以求助，免得它试了碰壁
    full_prompt = prompt + (team_note(cfg, agent) if note and hub_depth() + 1 < MAX_DEPTH else "")
    if web:
        full_prompt += WEB_NOTE
    if (meta or {}).get("kind", "ask") in ("ask", "side") and not (meta or {}).get("run"):  # 用户直接问某位成员：同样照这个写法回
        full_prompt += "\n\n" + USER_STYLE
    errors, failed_specs, continuation = [], set(), ""
    meta = meta or {}
    cid = "c_" + uuid.uuid4().hex[:10]
    rec = {"id": cid, "parent": os.environ.get("HUB_PARENT") or None,
           "run": meta.get("run") or os.environ.get("HUB_RUN") or None,
           "task": meta.get("task"), "kind": meta.get("kind") or "ask", "title": meta.get("title"),
           "agent": agent, "backend": chain[0], "preferred_backend": chain[0], "status": "running", "start": time.time(), "end": None,
           "secs": None, "write": bool(write), "cwd": cwd, "prompt": prompt, "answer": None,
           "error": None, "attempts": [], "pid": os.getpid(), "tier": tier if tier in TIERS else "work",
           "image": meta.get("image"), "follows": None, "display": None, "chat": meta.get("chat")}
    if web or spec or effort is not None:
        rec["side"] = {"web": bool(web), "effort": effort or "", "spec": spec or ""}
    images = [n for n in (top_meta().get("images") or []) if attachment_path(n)][:MAX_IMAGES]
    if images and not rec["parent"]:
        rec["images"] = images
    if rec["kind"] in ("ask", "image", "chat", "side") and not rec["parent"]:
        ext = top_meta()
        rec["follows"], rec["display"] = ext.get("follows"), ext.get("display") or meta.get("display")
        if ext.get("fork"):
            rec["fork"] = True
        rec["submission_id"] = ext.get("submission_id")
    cpath = os.path.join(CALLS_DIR, cid + ".json")
    keepable = (bool(cfg.get("keep_sessions", True)) and not rec["parent"] and rec["kind"] in ("ask", "chat", "side")
                and bool(os.environ.get("HUB_META")) and hub_depth() == 0)  # 只给面板里的对话留着；命令行、队员互相求助的一次性提问不留
    resume = resume_plan(agent, top_meta(), meta, web) if not rec["parent"] and rec["kind"] in ("ask", "chat", "side") else None
    write_json(cpath, rec)
    previous = (getattr(_ctx, "call_id", None), getattr(_ctx, "run_id", None), getattr(_ctx, "write", True))
    _ctx.call_id = cid
    _ctx.run_id = rec["run"]
    _ctx.write = bool(write)

    def finish(**kw):
        rec.update(kw)
        rec["end"] = time.time()
        rec["secs"] = round(rec["end"] - rec["start"], 1)
        write_json(cpath, rec)

    try:
        with _record_guard(lambda: rec, finish, "fail"):
            if meta.get("on_start"):
                meta["on_start"](cid)
            for i, spec_i in enumerate(chain):
                if _stopping.is_set():
                    break
                if spec_i in failed_specs:
                    rec["attempts"].append({"backend": spec_i, "skipped": True,
                                            "reason": "备用和刚才的是同一个模型，不再重跑"})
                    write_json(cpath, rec)
                    continue
                kind, _, mdl = spec_i.partition(":")
                fn = BACKENDS.get(kind)
                if not fn:
                    failed_specs.add(spec_i)
                    errors.append((spec_i, "未知后端（找不到）"))
                    rec["attempts"].append({"backend": spec_i, "error": "未知后端", "reason": "配置里写了不认识的模型：%s" % spec_i})
                    continue
                t0 = time.time()
                rec["backend"] = spec_i
                write_json(cpath, rec)
                _ctx.tokens = None
                _ctx.session = None
                _ctx.partial = None
                try:
                    eff = agent_effort(cfg, agent, spec_i)
                    if think_eff and i == 0 and think_eff in effort_levels(spec_i):
                        eff = think_eff
                    if effort is not None and i == 0 and spec:  # 旁问里单独选的档位只用在指定的那个模型上
                        eff = effort if effort in effort_levels(spec_i) else ""
                    run_cfg = dict(cfg, _effort=eff, _web=bool(web), _images=[attachment_path(n) for n in images],
                                   _keep=keepable, _keep_title=rec.get("display") or rec.get("title") or "")
                    text = None
                    if resume and resume["backend"] == spec_i:
                        t = read_json(resume["path"]) or {}
                        t["session_continued_by"] = cid  # 先占住：这个会话之后只沿这条线续，别的分支另开新会话
                        write_json(resume["path"], t)
                        try:
                            text = fn(dict(run_cfg, _resume=resume["sid"]), mdl, resume["prompt"], cwd, write, timeout)
                            rec["resumed"] = resume["from"]
                        except (BackendError, OSError) as e:
                            if _stopping.is_set() or str(e).startswith(WATCHDOG_PREFIXES):
                                raise
                            rec["attempts"].append({"backend": spec_i, "error": str(e)[:800], "resume_failed": True,
                                                    "reason": "续接上一轮的会话没成功（%s），改为带上前文重新问" % explain_error(str(e))[0]})
                            write_json(cpath, rec)
                            _ctx.tokens = _ctx.session = _ctx.partial = None
                            if not quiet:
                                eprint("[hub] 续接上一轮会话没成功，改为带上前文重新问…")
                        resume = None
                    if text is None:
                        text = fn(run_cfg, mdl, full_prompt + continuation, cwd, write, timeout)
                    dt = time.time() - t0
                    log_call({"ts": time.strftime("%F %T"), "agent": agent, "backend": spec_i, "ok": True,
                              "secs": round(dt, 1), "write": write, "cwd": cwd,
                              "prompt": prompt[:200], "answer_chars": len(text)})
                    if i > 0 and not quiet:
                        eprint("[hub] 注意：%s 的首选模型没成功，这次由备用的 %s 完成。" % (agent, spec_label(spec_i)))
                    if meta.get("defer"):  # 调用方还要接着处理（例如对接人派活），先别标「完成」
                        finish(status="running", tokens=getattr(_ctx, "tokens", None), session=getattr(_ctx, "session", None))
                        rec["end"] = rec["secs"] = None
                        write_json(cpath, rec)
                    else:
                        finish(status="ok", answer=text, tokens=getattr(_ctx, "tokens", None),
                               session=getattr(_ctx, "session", None))
                    return text, spec_i
                except (BackendError, OSError) as e:
                    failed_specs.add(spec_i)
                    errors.append((spec_i, str(e)))
                    att = {"backend": spec_i, "error": str(e)[:800], "reason": "%s：%s" % (spec_label(spec_i), explain_error(str(e))[0])}
                    if getattr(_ctx, "partial", None):
                        att["partial"] = _ctx.partial
                        rec["partial"] = _ctx.partial  # 超时等情况下已经写出来的部分，标「未完成」给人看
                        if str(e).startswith(WATCHDOG_PREFIXES):
                            continuation = "\n\n（前一位做到一半被停下了，以下是它已经写出的部分，请在此基础上接着做完，不要从头再来：）\n" + _ctx.partial[:6000]
                    rec["attempts"].append(att)
                    log_call({"ts": time.strftime("%F %T"), "agent": agent, "backend": spec_i, "ok": False,
                              "secs": round(time.time() - t0, 1), "error": str(e)[:500], "prompt": prompt[:200]})
                    if str(e).startswith(DENIED_PREFIX):  # 权限问题换模型也一样，不浪费额度再试
                        break
                    if not quiet:
                        nxt = next((x for x in chain[i + 1:] if x not in failed_specs), None)
                        eprint("[hub] %s 没成功（%s）%s" % (spec_label(spec_i), explain_error(str(e))[0],
                                                         "，换 %s 再试…" % spec_label(nxt) if nxt else "。"))
            msg = failure_text(agent, errors)
            finish(status="fail", error=msg, error_detail="\n\n".join("[%s] %s" % (sp, raw) for sp, raw in errors))
            raise BackendError(msg)
    finally:
        _ctx.call_id, _ctx.run_id, _ctx.write = previous


