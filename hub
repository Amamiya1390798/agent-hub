def agy_denied_text(data):
    """Gemini 在只读模式下想做没被允许的事（读工作目录以外的文件、运行命令等），没人能当场批准，它就交了空白回答。
    从它自己的对话记录里找出被拒的是哪一步，给人看得懂的说明。"""
    names = {"read_file": "读文件", "command": "运行命令", "write_file": "写文件", "edit_file": "改文件"}
    acts = "、".join(sorted(set(names.get(a.get("action"), a.get("display_name") or a.get("action") or "?")
                                for a in data.get("denied_actions") or [] if isinstance(a, dict))))
    detail = ""
    cid = str(data.get("conversation_id") or "")
    if re.fullmatch(r"[0-9a-f-]{36}", cid):
        path = os.path.join(HOME, ".gemini", "antigravity-cli", "brain", cid, ".system_generated", "logs", "transcript.jsonl")
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                for line in f:
                    m = re.search(r'permission check failed for ([a-z_]+) \\?"?([^"\\]{1,200})', line)
                    if m:
                        detail = "%s %s" % (names.get(m.group(1), m.group(1)), m.group(2))
        except OSError:
            pass
    return "%s：Gemini 在只读模式下想%s，没被允许，任务停下了%s" % (
        DENIED_PREFIX, acts or "做一件需要权限的事", "（被拒的是：%s）" % detail if detail else "")


KEEP_DIR = os.path.join(HUB_HOME, "keep")  # 常驻的 Gemini 会话：开着不关，下一句话直接接着说，省掉每次开机和重读前文
_keep_processes = {}  # 本进程启动的会话，保留句柄以便退出时回收
_active_keeps = set()


def _keep_paths(kid):
    return {k: os.path.join(KEEP_DIR, kid + ext) for k, ext in (("meta", ".json"), ("fifo", ".in"), ("log", ".log"), ("lock", ".lock"))}


def _keep_alive(meta):
    p = _keep_processes.get(meta.get("id"))
    if p is not None and p.pid == meta.get("pid"):
        return p.poll() is None  # poll 也会回收本进程的僵尸子进程
    return pid_alive(meta.get("pid"))


def keep_list():
    """所有还开着的常驻会话；进程已经没了的顺手清掉。"""
    out = []
    if not os.path.isdir(KEEP_DIR):
        return out
    for n in sorted(os.listdir(KEEP_DIR)):
        if not n.endswith(".json"):
            continue
        d = read_json(os.path.join(KEEP_DIR, n))
        if not isinstance(d, dict) or not d.get("id"):
            continue
        if not _keep_alive(d):
            keep_close(d["id"])
            continue
        out.append(d)
    return out


def keep_close(kid, kill=True):
    if not re.fullmatch(r"k_[0-9a-f]{10}", str(kid or "")):
        return False
    ps = _keep_paths(kid)
    d = read_json(ps["meta"]) or {}
    p = _keep_processes.get(kid)
    if p is not None and not d.get("pid"):
        d = dict(d, id=kid, pid=p.pid)
    if kill and d.get("pid"):
        owned = p is not None and p.pid == d["pid"]
        cmdline = ""
        if not owned and _keep_alive(d):
            try:
                cmdline = subprocess.check_output(["ps", "-o", "command=", "-p", str(d["pid"])], text=True)
            except (OSError, subprocess.CalledProcessError):
                pass
        if owned or "agy" in cmdline:  # 自己握着句柄，或确认仍是原来的 Gemini 进程
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(int(d["pid"]), sig)
                except OSError:
                    pass
                for _ in range(20):
                    if not _keep_alive(d):
                        break
                    time.sleep(0.1)
                # 即使组长退出也继续 SIGKILL，避免留下继承 FIFO/日志的子孙。
    if p is not None:
        p.poll()
        if p.returncode is not None:
            _keep_processes.pop(kid, None)
    for k in ("meta", "fifo", "log", "lock"):
        try:
            os.unlink(ps[k])
        except OSError:
            pass
    return True


def _keep_spawn(exe, model, cwd, write, sid, title):
    if _stopping.is_set():
        raise BackendError(STOP_MSG)
    os.makedirs(KEEP_DIR, exist_ok=True)
    kid = "k_" + uuid.uuid4().hex[:10]
    ps = _keep_paths(kid)
    os.mkfifo(ps["fifo"], 0o600)
    cmd = [exe, "--input-format", "stream-json", "--output-format", "stream-json", "--add-dir", ATTACH_DIR]
    if model:
        cmd += ["--model", model]
    if sid:
        cmd += ["--conversation", sid]
    cmd += agy_perm_args(write) + ["-p="]
    try:
        fin = os.open(ps["fifo"], os.O_RDWR)  # 自己也握着写端：中间没人说话时它不会读到结尾而退出
        try:
            with open(ps["log"], "ab") as logf:
                p = subprocess.Popen(cmd, cwd=cwd, env=clean_env(), stdin=fin, stdout=logf, stderr=subprocess.STDOUT,
                                     start_new_session=True, close_fds=True)
        finally:
            os.close(fin)
    except BaseException:
        keep_close(kid, kill=False)
        raise
    _keep_processes[kid] = p
    meta = {"id": kid, "pid": p.pid, "model": model, "write": bool(write), "cwd": cwd, "conv": sid or "",
            "title": title or "", "start": time.time(), "last": time.time(), "turns": 0}
    write_json(ps["meta"], meta)
    return meta


def keep_turn(exe, model, prompt, cwd, write, timeout, sid, title, on_line, watch=None):
    """在常驻会话里说一句话，等这一轮的结果。返回 False 表示这次用不了常驻（交给原来的一次性方式）。"""
    import fcntl
    watch = watch or Watchdog({}, timeout)
    if _stopping.is_set():
        raise BackendError(STOP_MSG)
    meta = None
    keeps = keep_list() if sid else []
    if sid:
        meta = next((d for d in keeps if d.get("conv") == sid and d.get("model") == model
                     and d.get("write") == bool(write) and d.get("cwd") == cwd), None)
    if not meta:
        for d in keeps:  # 同一个会话换了权限/目录：旧的那个用不上了，关掉
            if sid and d.get("conv") == sid:
                keep_close(d["id"])
        meta = _keep_spawn(exe, model, cwd, write, sid, title)
        meta["fresh"] = True
    ps = _keep_paths(meta["id"])
    try:
        lockf = open(ps["lock"], "w")
    except OSError:
        if meta.get("fresh"):
            keep_close(meta["id"])
        raise
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lockf.close()
        if meta.get("fresh"):
            keep_close(meta["id"])
        return False  # 同一个会话正在回答别的话
    _active_keeps.add(meta["id"])

    def check_deadline():
        if _stopping.is_set():
            raise BackendError(STOP_MSG)
        return watch.check()

    try:
        check_deadline()
        pos = 0 if meta.pop("fresh", False) else (os.path.getsize(ps["log"]) if os.path.exists(ps["log"]) else 0)
        try:
            fd = os.open(ps["fifo"], os.O_WRONLY | os.O_NONBLOCK)
        except OSError:
            if not _keep_alive(meta) and not meta.get("turns"):
                keep_close(meta["id"])
                return False
            raise
        try:
            data = (json.dumps({"event": "user", "message": {"content": prompt}}, ensure_ascii=False) + "\n").encode("utf-8")
            while data:
                check_deadline()
                try:
                    data = data[os.write(fd, data):]
                except BlockingIOError:
                    time.sleep(min(0.05, check_deadline()))
                except BrokenPipeError:
                    if not meta.get("turns") and not _keep_alive(meta):
                        keep_close(meta["id"])
                        return False
                    raise
        finally:
            os.close(fd)
        meta.update(last=time.time(), busy=True)
        write_json(ps["meta"], meta)
        buf = b""
        with open(ps["log"], "rb") as f:
            f.seek(pos)
            while True:
                check_deadline()
                chunk = f.readline()
                if chunk:
                    buf += chunk
                    if not buf.endswith(b"\n"):
                        continue
                    line, buf = buf.decode("utf-8", "replace"), b""
                    watch.touch()
                    on_line(line)
                    check_deadline()
                    try:
                        ev = json.loads(line)
                    except ValueError:
                        ev = None
                    if isinstance(ev, dict) and ev.get("event") == "result" and isinstance(ev.get("result"), dict):
                        res = ev["result"]
                        meta.update(last=time.time(), busy=False, turns=meta.get("turns", 0) + 1,
                                    conv=res.get("conversation_id") or meta.get("conv"))
                        write_json(ps["meta"], meta)
                        return True
                    continue
                if not _keep_alive(meta):
                    f.seek(0)
                    error = _tail(f.read().decode("utf-8", "replace"))
                    keep_close(meta["id"])
                    if not meta.get("turns"):  # 一开机就退出（比如这个版本不支持常驻）：改回一次性的方式
                        return False
                    raise BackendError("常驻的 Gemini 会话意外退出了：%s" % error)
                time.sleep(min(0.15, check_deadline()))
    except BaseException:
        keep_close(meta["id"])
        raise
    finally:
        _active_keeps.discard(meta["id"])
        try:
            fcntl.flock(lockf, fcntl.LOCK_UN)
        except OSError:
            pass
        lockf.close()


def agy_perm_args(write):
    if write:
        return ["--mode", "accept-edits", "--dangerously-skip-permissions"]
    # 只读：允许读任何位置的文件（和其他成员的只读一样），但不能写、不能运行命令。否则读工作目录外的文件会被拒、交白卷
    return ["--settings", json.dumps({"permissions": {"allow": ["read_file(/)"]}})]


def backend_agy(cfg, model, prompt, cwd, write, timeout):
    exe = find_bin(cfg, "agy")
    if not exe:
        raise BackendError("未安装 agy（Antigravity CLI）")
    tmp = None
    if len(prompt.encode("utf-8")) > 60000:  # 太长就落盘到工作目录，让它自己读
        try:
            fd, tmp = tempfile.mkstemp(suffix=".md", prefix=".hub-prompt-", dir=cwd)
        except OSError:  # 工作目录不可写就放到系统临时目录
            fd, tmp = tempfile.mkstemp(suffix=".md", prefix="hub-prompt-")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(prompt)
        prompt = "完整任务说明在文件 %s 中，请先完整阅读该文件，再严格按其中要求完成任务（不要修改或删除该文件）。" % tmp
    watch = Watchdog(cfg, timeout)
    cmd = [exe, "--print=" + prompt, "--output-format", "stream-json", "--print-timeout", "%ds" % watch.hard_timeout]
    if model:
        cmd += ["--model", model]
    if cfg.get("_resume"):  # 续接上一轮的会话，只发这一轮的话
        cmd += ["--conversation", cfg["_resume"]]
    if cfg.get("_images"):  # 让它能打开放图片的目录
        cmd += ["--add-dir", ATTACH_DIR]
    cmd += agy_perm_args(write)
    live = Live()
    box = {"data": None, "step": None, "tok": {"in": 0, "out": 0, "cache": 0}}

    def on_line(line):
        line = line.strip()
        if not line.startswith("{"):
            return
        try:
            ev = json.loads(line)
        except ValueError:
            return
        if ev.get("event") == "result" and isinstance(ev.get("result"), dict):
            box["data"] = ev["result"]
            return
        su = ev.get("step_update")
        if not isinstance(su, dict):
            return
        u = su.get("usage")
        if isinstance(u, dict):
            box["tok"]["in"] += int(u.get("input_tokens") or 0)
            box["tok"]["out"] += int(u.get("output_tokens") or 0)
            box["tok"]["cache"] += int(u.get("cache_read_tokens") or 0)
        if su.get("step_type") == "agent_response" and su.get("text_delta"):
            if box["step"] is not None and box["step"] != su.get("step_index") and live.text:
                live.add("\n\n")
            box["step"] = su.get("step_index")
            live.add(su["text_delta"])
        elif su.get("step_type") == "tool" and su.get("state") == "ACTIVE":
            params = (su.get("tool_info") or {}).get("parameters") or {}
            arg = next((str(v) for v in params.values() if isinstance(v, (str, int, float)) and str(v).strip()), "")
            name = su.get("tool_name") or "tool"
            watch.tool(name, params)
            live.step("%s %s" % (name, arg))

    rc, out, err = 0, "", ""
    try:
        kept = cfg.get("_keep") and keep_turn(exe, model, prompt, cwd, write, timeout, cfg.get("_resume"), cfg.get("_keep_title"), on_line, watch=watch)
        if not kept:
            rc, out, err = _run(cmd, cwd, clean_env(), watch.hard_timeout + 30, on_line=on_line, watch=watch)
    finally:
        live.close()
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    data = box["data"]
    if not isinstance(data, dict):
        raise BackendError("agy 没有给出结果 rc=%s：%s" % (rc, _tail(err or out)))
    if data.get("status") == "SUCCESS" and not (data.get("response") or "").strip() and data.get("denied_actions"):
        raise BackendError(agy_denied_text(data))
    if data.get("status") != "SUCCESS" or not (data.get("response") or "").strip():
        raise BackendError("agy 状态 %s：%s" % (data.get("status"), _tail(json.dumps(data, ensure_ascii=False))))
    _ctx.tokens = box["tok"]
    if data.get("conversation_id"):
        _ctx.session = {"id": data["conversation_id"], "app": "Antigravity 命令行",
                        "resume": "cd %s && agy --conversation %s" % (shq(cwd), shq(data["conversation_id"]))}
    return data["response"].strip()


def backend_codex(cfg, model, prompt, cwd, write, timeout):
    exe = find_bin(cfg, "codex")
    if not exe:
        raise BackendError("未找到 codex CLI")
    fd, outfile = tempfile.mkstemp(suffix=".txt", prefix="hub-codex-")
    os.close(fd)
    sandbox = ("danger-full-access" if cfg.get("gpt_full_access") else "workspace-write") if write else "read-only"
    if cfg.get("_resume"):  # 续接上一轮的会话；resume 不认 -s/-C，用配置项指定沙箱，目录靠进程的当前目录
        cmd = [exe, "exec", "resume", "--skip-git-repo-check", "-c", 'sandbox_mode="%s"' % sandbox, "-o", outfile]
    else:
        cmd = [exe, "exec", "--skip-git-repo-check", "-C", cwd, "-s", sandbox, "-o", outfile]
    if model:
        cmd += ["-m", model]
    for img in cfg.get("_images") or []:  # GPT 直接收图
        cmd += ["--image=" + img]
    if cfg.get("_effort") and _EFFORT_ID.match(cfg["_effort"]):
        cmd += ["-c", 'model_reasoning_effort="%s"' % cfg["_effort"]]
    if cfg.get("_web"):  # 打开 GPT 自带的实时网页搜索
        cmd += ["-c", 'web_search="live"']
    cmd += ["--json"] + ([cfg["_resume"]] if cfg.get("_resume") else []) + ["-"]
    live = Live()
    watch = Watchdog(cfg, timeout)
    box = {}

    def on_line(line):  # 事件流只用于实时显示；最终回答仍读 -o 文件
        try:
            ev = json.loads(line)
        except ValueError:
            return
        if isinstance(ev, dict) and (ev.get("thread_id") or ev.get("session_id")) and not box.get("sid"):
            box["sid"] = str(ev.get("thread_id") or ev.get("session_id"))
        item = ev.get("item") if isinstance(ev, dict) else None
        if not isinstance(item, dict):
            return
        typ, kind = str(ev.get("type") or ""), str(item.get("type") or item.get("item_type") or "")
        if kind == "agent_message" and typ.endswith("completed") and item.get("text"):
            live.add(str(item["text"]) + "\n\n")
        elif kind == "command_execution" and typ.endswith("started"):
            watch.tool(kind, item.get("command") or "")
            live.step(str(item.get("command") or "运行命令"))
        elif kind not in ("agent_message", "reasoning", "command_execution") and typ.endswith("started"):
            if kind in ("mcp_tool_call", "tool_call"):
                watch.tool("%s:%s" % (item.get("server") or "", item.get("tool") or item.get("name") or kind),
                           item.get("arguments") or item.get("input") or {})
            live.step(kind)

    try:
        try:
            rc, out, err = _run(cmd, cwd, clean_env(), watch.hard_timeout, stdin_text=prompt, on_line=on_line, watch=watch)
        finally:
            live.close()
        with open(outfile, encoding="utf-8", errors="replace") as f:
            answer = f.read().strip()
    finally:
        try:
            os.unlink(outfile)
        except OSError:
            pass
    if rc != 0 or not answer:
        raise BackendError("codex rc=%s：%s" % (rc, _tail(err or out)))
    if box.get("sid"):
        _ctx.session = {"id": box["sid"], "app": "Codex 命令行",
                        "resume": "cd %s && %s resume %s" % (shq(cwd), shq(exe), shq(box["sid"]))}
    return answer


def backend_dsh(cfg, model, prompt, cwd, write, timeout):
    exe = find_bin(cfg, "dsh")
    if not exe:
        raise BackendError("未安装 dsh")
    env = clean_env({"DSH_PERMISSION_MODE": "danger-full-access" if write else "read-only"})
    cmd = [exe, "--patch", DSH_PATCH, "--profile", "headless", "--json"] + \
        (["--session-id", cfg["_resume"]] if cfg.get("_resume") else []) + ["-"]
    live = Live()
    watch = Watchdog(cfg, timeout)

    def on_line(line):
        try:
            ev = json.loads(line)
        except ValueError:
            return
        if not isinstance(ev, dict):
            return
        typ = str(ev.get("type") or "")
        if typ == "text" and isinstance(ev.get("text"), str):
            live.add(ev["text"])
        elif "tool" in typ:
            live.step("%s %s" % (ev.get("name") or ev.get("tool") or typ,
                                  json.dumps(ev.get("input") or ev.get("args") or "", ensure_ascii=False)[:120]))

    try:
        rc, out, err = _run(cmd, cwd, env, watch.hard_timeout, stdin_text=prompt, on_line=on_line, watch=watch)
    finally:
        live.close()
    final, tok, sid = None, {"in": 0, "out": 0, "cache": 0}, None
    for line in out.splitlines():
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if not isinstance(ev, dict):
            continue
        if ev.get("type") == "session" and ev.get("sessionId"):
            sid = str(ev["sessionId"])
        if ev.get("type") == "final" and isinstance(ev.get("text"), str):
            final = ev["text"]
        u = ev.get("usage")
        if isinstance(u, dict):
            tok["in"] += int(u.get("inputTokens") or 0)
            tok["out"] += int(u.get("outputTokens") or 0)
            tok["cache"] += int(u.get("cacheReadTokens") or 0)
    if rc != 0 or not (final or "").strip():
        raise BackendError("dsh rc=%s：%s" % (rc, _tail(err or out)))
    _ctx.tokens = tok
    if sid:
        _ctx.session = {"id": sid, "app": "DeepSeek Harness 命令行",
                        "resume": "cd %s && dsh --patch %s tui --resume %s" % (shq(cwd), shq(DSH_PATCH), shq(sid))}
    return final.strip()


def backend_claude(cfg, model, prompt, cwd, write, timeout):
    exe = find_bin(cfg, "claude")
    if not exe:
        raise BackendError("未找到 claude CLI")
    cmd = [exe, "-p", "--model", model or "opus",
           "--permission-mode", "bypassPermissions" if write else "plan"]  # 允许改文件=无人值守：命令、本机软件都放行（和 Gemini 一致）；acceptEdits 只放行改文件，命令会被拦
    if cfg.get("_effort") in CLAUDE_EFFORTS:
        cmd += ["--effort", cfg["_effort"]]
    if cfg.get("_web"):  # 只读模式下也放行 Claude 自带的网页搜索和读网页
        cmd += ["--allowedTools", "WebSearch", "WebFetch"]
    if cfg.get("_resume"):
        cmd += ["--resume", cfg["_resume"]]
    if cfg.get("_images"):
        cmd += ["--add-dir", ATTACH_DIR]
    cmd += ["--output-format", "json"]  # 拿到会话编号，下次追问能续接
    watch = Watchdog(cfg, timeout, streaming=False)
    rc, out, err = _run(cmd, cwd, clean_env(), watch.hard_timeout, stdin_text=prompt, watch=watch)
    text = out.strip()
    try:
        d = json.loads(text)
    except ValueError:
        d = None
    if isinstance(d, dict) and "result" in d:
        if d.get("is_error"):
            raise BackendError("claude 出错：%s" % _tail(str(d.get("result") or d.get("subtype") or text)))
        text = str(d.get("result") or "").strip()
        u = d.get("usage") if isinstance(d.get("usage"), dict) else {}
        _ctx.tokens = {"in": int(u.get("input_tokens") or 0), "out": int(u.get("output_tokens") or 0),
                       "cache": int(u.get("cache_read_input_tokens") or 0)}
        if d.get("session_id"):
            _ctx.session = {"id": str(d["session_id"]), "app": "Claude Code",
                            "resume": "cd %s && %s --resume %s" % (shq(cwd), shq(exe), shq(str(d["session_id"])))}
    not_logged = len(text) < 200 and ("Not logged in" in text or "Please run /login" in text)
    if rc != 0 or not text or not_logged:
        hint = "（未登录：请在终端运行一次 claude 并执行 /login）" if not_logged else ""
        raise BackendError("claude rc=%s%s：%s" % (rc, hint, _tail((err + "\n" + text).strip())))
    return text


