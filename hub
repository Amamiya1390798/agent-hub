def think_setting(cfg, agent, tier="think"):
    """这位成员做某类活（动脑/审美/文案）时用的 (模型, 思考等级)；模型为空=跟干活用的一样。停用的模型不算。"""
    th = cfg.get(tier) if tier in TIERS and isinstance(cfg.get(tier), dict) else {}
    d = th.get(agent) if isinstance(th.get(agent), dict) else {}
    sp = d.get("spec") if isinstance(d.get("spec"), str) else ""
    if sp in (cfg.get("disabled_models") or []):
        sp = ""
    eff = d.get("effort") if isinstance(d.get("effort"), str) else ""
    return sp, eff


def tier_chain(cfg, agent, tier=None):
    """这位成员做这类活时的模型顺序和首选档位：专门设的模型排第一，后面接原来的备用链。"""
    chain = list(cfg["agents"].get(agent) or [])
    eff = ""
    if tier in TIERS:
        tsp, eff = think_setting(cfg, agent, tier)
        if tsp:
            chain = [tsp] + [x for x in chain if x != tsp]
    return chain, eff


