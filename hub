QUOTA_SKIP_PCT = 15
MIN_TIMEOUT = 900  # 给被派活的一方的合理时限（秒）


def quota_guard_on():
    """设置里「额度低时自动跳过」是否打开（默认打开）。直接读配置文件，改完立即生效。"""
    raw = read_json(CONFIG_PATH)
    return not (isinstance(raw, dict) and raw.get("quota_guard") is False)


def quota_skip(name, now=None):
    """会审选人：5 小时额度低于 15% 就跳过（用户关掉「自动跳过」时照样参加）。数据过期/未知不当成 0。返回 (跳过原因或 None, 给人看的额度说明)。"""
    now = now or time.time()
    q = ((read_json(QUOTA_PATH) or {}).get("agents") or {}).get(name) or {}
    if now - (q.get("ts") or 0) > 6 * 3600:
        return None, "额度未知"
    fresh = []  # 所有还没过重置时间的窗口（5 小时、本周……），任一低于 15% 都跳过
    for w in q.get("windows") or []:
        if not isinstance(w, dict) or (w.get("resets") and w["resets"] < now):
            continue
        try:
            fresh.append((str(w.get("label") or ""), float(w.get("remaining"))))
        except (TypeError, ValueError):
            continue
    if not fresh:
        return None, "额度未知"
    fresh.sort(key=lambda x: 0 if x[0] == "5 小时" else 1)
    for label, pct in fresh:
        if pct < QUOTA_SKIP_PCT:
            if not quota_guard_on():
                return None, "%s剩 %d%%（已设为额度低也照样干活）" % (label, int(pct))
            return "%s额度只剩 %d%%，低于 %d%%，这次自动跳过" % (label, int(pct), QUOTA_SKIP_PCT), "%s剩 %d%%" % (label, int(pct))
    return None, "剩 %d%%" % int(fresh[0][1])


def timeout_warning(secs):
    if secs and secs < MIN_TIMEOUT:
        return ("时限只有 %d 分钟，少于 15 分钟。读代码、审查、写长文的活常常需要 5～15 分钟，"
                "时间太短对方容易什么都交不出来。" % max(1, round(secs / 60)))
    return None


def extract_json(text):
    dec = json.JSONDecoder()
    for m in re.finditer(r"\{", text):
        try:
            obj, _ = dec.raw_decode(text[m.start():])
        except ValueError:
            continue
        if isinstance(obj, dict) and "tasks" in obj:
            return obj
    raise ValueError("规划输出里没有合法的 JSON 方案")


def make_plan(cfg, goal, cwd, write, planner, max_tasks, run_id=None, title=None, inject=""):
    roster = "\n".join("- %s：%s%s%s" % (k, v, quota_text(k), tier_roster(cfg, k)) for k, v in cfg["profiles"].items() if k in cfg["agents"])
    prompt = PLAN_PROMPT.format(
        quota_rule=("标注剩余额度低于 15% 的成员不要派活；" if quota_guard_on() else "用户设置了额度低也照样派活，不必因为额度低避开谁；"),
        roster=roster, models=model_menu(cfg), max_tasks=max_tasks, cwd=cwd, goal=goal, timeout_min=max(1, round(cfg["timeout"] / 60)),
        write_hint="" if write else "（本次运行为只读模式，所有任务 write 都填 false，成果以文字形式交回）")
    if inject.strip():  # 高压模式：用户自己写的话放在排工说明前面
        prompt = "【用户给排工者的特别要求，请先读并照办】\n" + inject.strip() + "\n\n――――――――\n\n" + prompt
    last = None
    for attempt in range(2):
        text, spec = ask(cfg, planner, prompt, cwd=cwd, note=False,
                         meta={"run": run_id, "kind": "plan", "title": "排工：" + (title or goal)[:40]})
        try:
            plan = extract_json(text)
            tasks = (plan.get("tasks") or [])[:max_tasks]
            if not tasks:
                raise ValueError("任务列表为空")
            ids = set()
            for i, t in enumerate(tasks):
                if not isinstance(t, dict):
                    raise ValueError("任务格式不对")
                tid = re.sub(r"[^A-Za-z0-9_-]", "_", str(t.get("id") or "t%d" % (i + 1)))
                if tid in ids:
                    raise ValueError("任务 id 重复：%s" % tid)
                t["id"] = tid
                if t.get("agent") not in cfg["agents"]:
                    t["agent"] = cfg["default_worker"]
                t["title"] = str(t.get("title") or tid)
                t["why"] = str(t.get("why") or "")[:200]
                try:
                    t["eta_min"] = max(1, min(600, int(t.get("eta_min"))))
                except (TypeError, ValueError):
                    t["eta_min"] = None
                deps = t.get("depends_on") or []
                if isinstance(deps, str):
                    deps = [deps]
                t["depends_on"] = [re.sub(r"[^A-Za-z0-9_-]", "_", str(d)) for d in deps]
                t["write"] = bool(t.get("write")) and write
                k = str(t.get("kind") or "").strip().lower()
                k = {"动脑": "think", "审美": "design", "文案": "copy"}.get(k, k)
                t["kind"] = k if k in TIERS else "work"
                want = str(t.get("spec") or "").strip()
                t["spec"] = None
                if want:  # 用户点名的模型：可用就照用，压过预设；不可用就按预设，并写在 why 里
                    ok = [o["spec"] for o in backend_choices(cfg) if not o.get("off")]
                    if want in ok:
                        t["spec"] = want
                    else:
                        t["why"] = (t["why"] + "（点名的模型 %s 现在用不了，按成员预设）" % want)[:300]
                t["plan_spec"] = t["spec"] or (tier_chain(cfg, t["agent"], t["kind"])[0] or [None])[0]
                if not t.get("prompt"):
                    raise ValueError("任务 %s 缺少 prompt" % tid)
                t["prompt"] = str(t["prompt"])
                ids.add(tid)
            for t in tasks:
                if any(d not in ids or d == t["id"] for d in t["depends_on"]):
                    raise ValueError("任务依赖不存在或依赖自身")
            resolved = set()
            while len(resolved) < len(tasks):
                ready = {t["id"] for t in tasks if t["id"] not in resolved
                         and all(d in resolved for d in t["depends_on"])}
                if not ready:
                    raise ValueError("任务之间存在循环依赖")
                resolved.update(ready)
            plan["tasks"] = tasks
            plan["planner_backend"] = spec
            return plan
        except (ValueError, TypeError, AttributeError) as e:
            last = e
            prompt += "\n\n（上次输出不是合法 JSON：%s。这次只输出 JSON。）" % e
    raise BackendError("规划失败：%s" % last)


# ---- 共享进度板：每位成员开工前看到整体目标、分工、别人已完成的摘要；做完写回自己的进度和遗留

BOARD_STATUS = {"pending": "待开始", "running": "正在做", "ok": "已完成", "fail": "没完成", "skipped": "跳过"}


def parse_report(text):
    """从回答末尾取「【进度】」「【遗留】」两行；没写就用开头一段当进度。"""
    prog = left = None
    for line in (text or "").splitlines()[::-1][:30]:
        m = re.match(r"\s*[*#>\-\s]*【(进度|遗留)】[*\s]*[:：]?[*\s]*(.*)", line)
        if m:
            if m.group(1) == "进度" and prog is None:
                prog = m.group(2).strip()[:300]
            elif m.group(1) == "遗留" and left is None:
                left = m.group(2).strip()[:300]
    prog = (prog or "").rstrip("*` ").strip()
    left = (left or "").rstrip("*` ").strip()
    if not prog:
        prog = re.sub(r"\s+", " ", strip_report(text or "").strip())[:120]
    if left in ("", "无", "没有", "无。", "没有。"):
        left = None
    return prog, left


def strip_report(text):
    """直接交给用户的结果里去掉末尾写给进度板的【进度】【遗留】两行。"""
    lines = (text or "").rstrip().splitlines()
    while lines and (re.match(r"\s*[*#>\-\s]*【(进度|遗留)】", lines[-1]) or not lines[-1].strip()):
        lines.pop()
    return "\n".join(lines)


def run_notes(rid):
    """用户在团队干活途中补充的话（对接人转告的），按时间顺序。"""
    out = []
    try:
        with open(os.path.join(RUNS_DIR, str(rid), "notes.jsonl"), encoding="utf-8") as f:
            for line in f:
                try:
                    out.append(json.loads(line)["text"])
                except (ValueError, KeyError, TypeError):
                    pass
    except OSError:
        pass
    return out


def add_run_note(rid, text):
    with open(os.path.join(RUNS_DIR, str(rid), "notes.jsonl"), "a", encoding="utf-8") as f:
        f.write(json.dumps({"t": time.time(), "text": text[:4000]}, ensure_ascii=False) + "\n")


def busy_runs_in_line(depth=8):
    """这条对话线上，对接人之前派出去、现在还在做的项目组。"""
    out, f = [], top_meta().get("follows") or {}
    for _ in range(depth):
        if f.get("type") != "call" or not re.fullmatch(r"c_[0-9a-f]+", str(f.get("id") or "")):
            break
        t = read_json(os.path.join(CALLS_DIR, f["id"] + ".json")) or {}
        rid = (t.get("dispatch") or {}).get("run")
        if rid:
            r = read_json(os.path.join(RUNS_DIR, str(rid), "run.json")) or {}
            if r.get("status") in ("planning", "running", "synthesizing") and pid_alive(r.get("pid")):
                ts = r.get("tasks") or []
                out.append({"id": rid, "goal": (r.get("display") or r.get("goal") or "")[:300],
                            "done": sum(1 for x in ts if x.get("status") == "ok"), "total": len(ts)})
        f = t.get("follows") or {}
    return out


def board_text(state, me, share_results=True, footer=True):
    goal = state.get("display") or state["goal"]  # 追问时 goal 前面带着历史背景，看板上只写这次的要求
    lines = ["===== 共享进度板（项目看板，全队都能看到）=====", "整体目标：%s" % goal[:2000]]
    if state.get("summary"):
        lines.append("方案：%s" % state["summary"])
    lines.append("分工：")
    for t in state["tasks"]:
        st = BOARD_STATUS.get(t.get("status"), t.get("status") or "")
        bits = ["- %s [%s] %s —— %s" % (t["id"], t["agent"], t["title"], st)]
        if t.get("eta_min"):
            bits.append("预计 %s 分钟" % t["eta_min"])
        if t.get("depends_on"):
            bits.append("接在 %s 之后" % "、".join(t["depends_on"]))
        if share_results and t["id"] != me and t.get("progress"):
            bits.append("进度：%s" % t["progress"][:200])
        if share_results and t["id"] != me and t.get("leftover"):
            bits.append("遗留：%s" % t["leftover"][:200])
        lines.append("；".join(bits))
    notes = run_notes(state.get("id"))
    if notes:
        lines.append("用户补充（优先于上文；有冲突时以最新要求为准）：")
        lines += ["- " + n for n in notes]
    if not footer:
        return "\n".join(lines)
    cap = max(1, round(state.get("timeout", 900) / 60))
    eta = next((t.get("eta_min") for t in state["tasks"] if t["id"] == me), None)
    if not share_results:
        lines.append("你负责：%s。（这是会审：其他人同时独立作答，你看不到他们的答案。）问题里提到的文件夹、文件，"
                     "必须先亲自打开看过再下结论，开头一句写明看了哪些；没法看就直说，不要凭印象答。"
                     "看完关键材料、意见成形就交，不用逐个穷尽检查。一般 %d 分钟内能交；没有一刀切的时限，但连续几分钟没有任何进展、或反复做同一件事，会被当作卡住停下。" % (me, cap))
    else:
        lines.append("你负责：%s。任务里提到的文件、文件夹要先亲自打开看过再动手或下结论。%s确实要更久可以接着做，只要一直在推进；连续几分钟没有任何进展、或反复做同一件事，会被当作卡住停下。做到够用就交，别为了穷尽而反复检查。"
                     % (me, ("预计 %s 分钟能做完；" % eta) if eta else ("一般 %d 分钟内能做完；" % cap)))
    lines.append("简洁交付结果和必要说明，末尾单独写两行：\n【进度】一句话说明完成情况\n【遗留】未完成事项或提醒；没有则写 无")
    return "\n".join(lines)


def write_board_md(run_dir, state):
    try:
        with open(os.path.join(run_dir, "board.md"), "w", encoding="utf-8") as f:
            f.write("# 共享进度板（项目看板）\n\n" + board_text(state, "-", True, footer=False) + "\n")
    except OSError:
        pass


def ensure_cwd(cwd):
    """工作目录不存在时自动建好：默认的 workspace 一律建；用户填的目录只在家目录里才建（防止手滑建到系统目录）。
    建不了返回 False。"""
    cwd = os.path.abspath(os.path.expanduser(cwd))
    if os.path.isdir(cwd):
        return True
    if os.path.exists(cwd):
        return False  # 同名的是个文件
    home = os.path.realpath(HOME)
    real = os.path.realpath(cwd)
    if not (os.path.abspath(cwd) == os.path.abspath(UI_WORKSPACE) or real.startswith(home + os.sep)):
        return False
    try:
        os.makedirs(cwd, exist_ok=True)
    except OSError:
        return False
    return os.path.isdir(cwd)


def _open_run(cfg, goal, cwd, write, **fields):
    cwd = os.path.abspath(cwd or os.getcwd())
    if not ensure_cwd(cwd):
        raise BackendError("工作目录不存在，也没法自动建：%s" % cwd)
    os.makedirs(RUNS_DIR, exist_ok=True)
    run_id = time.strftime("%Y%m%d-%H%M%S")
    while True:
        run_dir = os.path.join(RUNS_DIR, run_id)
        try:
            os.makedirs(run_dir)
            break
        except FileExistsError:
            run_id += "x"
    state = {"id": run_id, "mode": "run", "goal": goal, "status": "planning", "summary": "", "start": time.time(),
             "end": None, "cwd": cwd, "planner": None, "synthesizer": None, "tasks": [], "final": None,
             "error": None, "pid": os.getpid(), "write": bool(write), "timeout": cfg["timeout"],
             "follows": top_meta().get("follows"), "display": top_meta().get("display"),
             "submission_id": top_meta().get("submission_id"), "fork": bool(top_meta().get("fork")) or None,
             "images": [n for n in (top_meta().get("images") or []) if attachment_path(n)] or None}
    state.update(fields)
    slock = threading.RLock()

    def save(**kw):
        with slock:
            state.update(kw)
            write_json(os.path.join(run_dir, "run.json"), state)
            write_board_md(run_dir, state)
    save.lock = slock  # 执行任务时所有对 state 的改动都用同一把锁

    warn = timeout_warning(cfg["timeout"])
    if warn:
        eprint("[hub] 提醒：" + warn + "可以在设置里调大「一般多久交」。")
        state["timeout_warning"] = warn
    save()
    return run_id, run_dir, state, save


def _exec_tasks(cfg, run_id, run_dir, state, save, max_parallel, share_results=True):
    """按依赖并行执行 state["tasks"]（状态为 pending 的），返回 {任务 id: 结果}。"""
    cwd = state["cwd"]
    tasks = {t["id"]: t for t in state["tasks"]}
    results, done, running = {}, set(), {}
    for t in state["tasks"]:
        if t.get("status") == "skipped":
            results[t["id"]] = {"ok": False, "skipped": True, "text": t.get("answer") or "", "backend": "-", "secs": 0}
            done.add(t["id"])

    def do(t):
        bad = [d for d in t["depends_on"] if d in results and not results[d]["ok"]]
        if bad:
            return {"ok": False, "skipped": True, "text": "【已跳过】前置任务 %s 失败。" % ",".join(bad),
                    "backend": "-", "secs": 0}
        p = t["prompt"]
        deps = [d for d in t["depends_on"] if d in results]
        if deps:
            p += "\n\n===== 前置任务的结果（供参考）=====\n" + "\n\n".join(
                "【%s %s】\n%s" % (d, tasks[d]["title"], results[d]["text"]) for d in deps)
        if t["write"]:
            p += "\n\n（工作目录：%s，可以在其中创建/修改文件；完成后简要说明改动了哪些文件。）" % cwd
        with lock:
            p += "\n\n" + board_text(state, t["id"], share_results)

        def started(cid):
            with lock:
                t["call_id"] = cid
                save()

        t0 = time.time()
        try:
            text, spec = ask(cfg, t["agent"], p, cwd=cwd, write=t["write"], quiet=True, note=share_results, spec=t.get("spec"),
                             tier=t.get("kind") if t.get("kind") in TIERS else ("think" if not share_results else None), meta={"run": run_id, "task": t["id"], "kind": "task", "title": t["title"],
                                   "on_start": started})
            return {"ok": True, "text": text, "backend": spec, "secs": round(time.time() - t0, 1)}
        except BackendError as e:
            crec = read_json(os.path.join(CALLS_DIR, "%s.json" % t.get("call_id"))) or {} if t.get("call_id") else {}
            with lock:  # 技术细节和超时前写出的部分回答也留在任务上，面板能看
                t["error_detail"], t["partial"] = crec.get("error_detail"), crec.get("partial")
            return {"ok": False, "text": "【任务失败】%s" % e, "backend": "-", "secs": round(time.time() - t0, 1)}

    lock = save.lock
    with ThreadPoolExecutor(max_workers=max_parallel) as pool:
        while len(done) < len(tasks):
            for tid, t in tasks.items():
                if (len(running) < max_parallel and tid not in done and tid not in running
                        and all(d in done for d in t["depends_on"])):
                    eprint("[hub] ▶ %s [%s] %s" % (tid, t["agent"], t["title"]))
                    with lock:
                        t["status"] = "running"
                        t["started"] = time.time()
                        save()
                    running[tid] = pool.submit(do, t)
            save()
            if not running:
                save(status="failed", end=time.time(), error="任务依赖无法执行")
                raise BackendError("任务依赖无法执行")
            fut = next(as_completed(list(running.values())))
            tid = [k for k, v in running.items() if v is fut][0]
            del running[tid]
            r = fut.result()
            results[tid] = r
            done.add(tid)
            prog, left = parse_report(r["text"]) if r["ok"] else (r["text"][:200], None)
            with lock:
                tasks[tid].update(status="ok" if r["ok"] else ("skipped" if r.get("skipped") else "fail"),
                                  backend=r["backend"], secs=r["secs"], answer=r["text"], progress=prog,
                                  leftover=left, preferred_backend=call_preferred(read_json(os.path.join(
                                      CALLS_DIR, str(tasks[tid].get("call_id")) + ".json")) or {}))
            save()
            with open(os.path.join(run_dir, "%s.md" % tid), "w", encoding="utf-8") as f:
                f.write("# %s [%s -> %s]\n\n%s\n" % (tasks[tid]["title"], tasks[tid]["agent"], r["backend"], r["text"]))
            eprint("[hub] %s %s 用时 %ss（%s）" % ("✔" if r["ok"] else "✘", tid, r["secs"], r["backend"]))
    return results


def _sub_fields(goal, parent_call):
    """由联络人派出的活：挂在那一轮对话下面，不再自己算一条追问。"""
    return {"parent_call": parent_call, "follows": None, "display": goal, "submission_id": None} if parent_call else {}


def run_goal(cfg, goal, cwd, write, planner, synthesizer, max_parallel, max_tasks, dry, on_open=None, parent_call=None,
             pressure=False):
    max_parallel, max_tasks = max(1, int(max_parallel)), max(1, int(max_tasks))
    inject = str(cfg.get("pressure_prompt") or "") if pressure else ""
    run_id, run_dir, state, save = _open_run(cfg, goal, cwd, write, planner=planner, synthesizer=synthesizer,
                                             pressure=bool(pressure), pressure_prompt=inject or None,
                                             **_sub_fields(goal, parent_call))
    with _record_guard(lambda: state, save, "failed"):
        if on_open:
            on_open(run_id)
        cwd = state["cwd"]
        eprint("[hub] 排工中（%s）…" % planner)
        try:
            plan = make_plan(cfg, goal, cwd, write, planner, max_tasks, run_id, title=state.get("display"), inject=inject)
        except BackendError as e:
            save(status="failed", end=time.time(), error=str(e))
            raise
        write_json(os.path.join(run_dir, "plan.json"), dict(plan, goal=goal, cwd=cwd))
        if dry:
            save(status="done", end=time.time(), tasks=plan["tasks"],
                 summary="（只出方案）" + str(plan.get("summary", "")))
            print(json.dumps(plan, ensure_ascii=False, indent=2))
            return 0
        eprint("[hub] 方案：%s" % plan.get("summary", ""))
        for t in plan["tasks"]:
            eprint("   - %s [%s]%s %s%s" % (t["id"], t["agent"], "✎" if t["write"] else "", t["title"],
                                             ("  ⇐ " + ",".join(t["depends_on"])) if t["depends_on"] else ""))
            t.update(status="pending", backend=None, secs=None, call_id=None, answer=None)
        save(status="running", summary=str(plan.get("summary", "")), tasks=plan["tasks"])
        results = _exec_tasks(cfg, run_id, run_dir, state, save, max_parallel)
        tasks = {t["id"]: t for t in state["tasks"]}

        ok_count = sum(1 for r in results.values() if r["ok"])
        synth_ok = True
        if len(tasks) == 1:
            final = strip_report(list(results.values())[0]["text"])
        else:
            blob = "\n\n".join("### %s %s（%s）\n%s" % (tid, tasks[tid]["title"], tasks[tid]["agent"], results[tid]["text"])
                               for tid in tasks)
            try:
                eprint("[hub] 汇总中（%s）…" % synthesizer)
                save(status="synthesizing")
                final, _ = ask(cfg, synthesizer, SYNTH_PROMPT.format(goal=goal + "".join("\n（用户中途补充：%s）" % n for n in run_notes(run_id)), results=blob), cwd=cwd, note=False,
                               quiet=True, meta={"run": run_id, "kind": "synth", "title": "汇总：" + (state.get("display") or goal)[:40]})
            except BackendError as e:
                synth_ok = False
                final = "（汇总失败：%s）\n\n%s" % (e, blob)
        with open(os.path.join(run_dir, "final.md"), "w", encoding="utf-8") as f:
            f.write(final + "\n")
        all_ok = ok_count == len(tasks) and synth_ok
        save(status="done" if all_ok else "failed", end=time.time(), final=final,
             error=None if all_ok else ("汇总失败" if not synth_ok else "%d 个任务没有完成" % (len(tasks) - ok_count)))
        print(final)
        eprint("[hub] 完成 %d/%d 个任务。过程记录：%s" % (ok_count, len(tasks), run_dir))
        return 0 if all_ok else 1


def council_members(cfg, members=None):
    names = members if members is not None else cfg.get("council_agents") or []
    if not isinstance(names, (list, tuple)):
        names = []
    out = []
    for n in names:
        if isinstance(n, str) and n in cfg["agents"] and n not in out:
            out.append(n)
    return out


def run_council(cfg, question, cwd, members=None, synthesizer=None, on_open=None, parent_call=None):
    """会审：每位成员同时独立回答同一问题（只读），再由一位比较共同点和分歧。"""
    explicit = members is not None
    members = council_members(cfg, members)
    fill_note = ""
    if not explicit and len(members) < 2:  # 会审名单里能用的不到两位（比如有人被停用了）：一个人没法比较，自动补上其他在岗成员
        named = [n for n in cfg["agents"] if n not in members and re.search(r"(?<![a-z])%s(?![a-z])" % re.escape(n), question, re.I)]
        rest = [n for n in cfg["agents"] if n not in members and n not in named]
        added = (named + rest)[:max(0, 3 - len(members))]
        if added:
            fill_note = "会审名单里能用的只有 %s，自动补上了 %s" % ("、".join(members) or "无人", "、".join(added))
            members += added
            eprint("[hub] " + fill_note)
    if not members:
        raise BackendError("会审没有可选的成员，请在设置里勾选参加会审的成员")
    tasks, skipped = [], []
    for i, name in enumerate(members):
        reason, qnote = quota_skip(name)
        t = {"id": "m%d" % (i + 1), "agent": name, "title": "%s 的独立意见" % name, "depends_on": [],
             "write": False, "prompt": COUNCIL_PROMPT.format(question=question), "why": "会审成员（%s）" % qnote,
             "eta_min": None, "status": "pending", "backend": None, "secs": None, "call_id": None, "answer": None,
             "kind": "think", "plan_spec": (tier_chain(cfg, name, "think")[0] or [None])[0]}
        if reason:
            t.update(status="skipped", answer="【已跳过】" + reason, skip_reason=reason)
            skipped.append({"agent": name, "reason": reason})
        tasks.append(t)
    active = [t for t in tasks if t["status"] == "pending"]
    synth = synthesizer or cfg["synthesizer"]
    if synth not in cfg["agents"] or quota_skip(synth)[0]:
        synth = active[0]["agent"] if active else None
    run_id, run_dir, state, save = _open_run(
        cfg, question, cwd, False, mode="council", planner=None, synthesizer=synth, participants=members,
        skipped=skipped, status="running", tasks=tasks, **_sub_fields(question, parent_call),
        summary="会审：%s 各自独立作答，%s比较共同点和分歧%s" % ("、".join(t["agent"] for t in active) or "无人",
                                                     (synth + " ") if synth else "", "（%s）" % fill_note if fill_note else ""))
    with _record_guard(lambda: state, save, "failed"):
        if on_open:
            on_open(run_id)
        if not active:
            msg = "没有成员可以参加这次会审（%s）" % "；".join("%s：%s" % (s["agent"], s["reason"]) for s in skipped)
            save(status="failed", end=time.time(), error=msg, final=msg)
            raise BackendError(msg)
        eprint("[hub] 会审：%s 同时作答%s" % ("、".join(t["agent"] for t in active),
                                         "；跳过 " + "、".join(s["agent"] for s in skipped) if skipped else ""))
        results = _exec_tasks(cfg, run_id, run_dir, state, save, max_parallel=len(active), share_results=False)
        ok = [t for t in tasks if results.get(t["id"], {}).get("ok")]
        failed = [t for t in active if t not in ok]
        absent = ["%s：%s" % (t["agent"], (t.get("skip_reason") or (t.get("answer") or "")[:200])) for t in tasks if t not in ok]
        by_backend = {}
        for t in ok:
            by_backend.setdefault(t.get("backend"), []).append(t["agent"])
        same = ["%s 实际都由同一个模型 %s 作答，不算不同模型的独立意见" % ("、".join(v), k)
                for k, v in by_backend.items() if len(v) > 1]
        notes = absent and ["缺席或失败：" + "；".join(absent)] or []
        notes += same + ([fill_note] if fill_note else [])
        synth_ok = True
        if not ok:
            final = "会审没有得到任何回答。\n\n" + "\n".join(absent)
        elif len(ok) == 1:
            final = ("**注意：仅 %s 一位给出了回答，没有形成多方会审。**\n\n" % ok[0]["agent"] + strip_report(ok[0]["answer"]) +
                     ("\n\n---\n" + "\n".join(notes) if notes else ""))
        else:
            if any(t["agent"] == synth for t in failed):  # 综合者刚才自己都没答上来，换一位已答复的成员
                synth = ok[0]["agent"]
                notes.append("原定的综合者没有答复，改由 %s 综合" % synth)
                save(synthesizer=synth)
            blob = "\n\n".join("### %s（实际模型 %s）\n%s" % (t["agent"], t.get("backend"), t["answer"]) for t in ok)
            note = ("\n额外说明：" + "；".join(notes)) if notes else ""
            try:
                eprint("[hub] 比较意见中（%s）…" % synth)
                save(status="synthesizing")
                final, _ = ask(cfg, synth, COUNCIL_SYNTH_PROMPT.format(question=question, results=blob, note=note),
                               cwd=state["cwd"], note=False, quiet=True, tier="think",
                               meta={"run": run_id, "kind": "synth", "title": "会审综合：" + (state.get("display") or question)[:40]})
                if same:
                    final = "> 注意：" + "；".join(same) + "\n\n" + final
            except BackendError as e:
                synth_ok = False
                final = "（综合失败：%s）\n\n%s" % (e, blob)
        with open(os.path.join(run_dir, "final.md"), "w", encoding="utf-8") as f:
            f.write(final + "\n")
        all_ok = not failed and synth_ok and len(ok) >= 2  # 因额度跳过的成员已注明，不算失败
        if all_ok:
            err = ("跳过了 " + "、".join(s["agent"] for s in skipped)) if skipped else None
        elif not ok:
            err = "没有成员给出回答"
        elif not synth_ok:
            err = "综合失败"
        elif failed:
            err = "%d 位没有答复" % len(failed) + ("，仅一位答复，未形成多方会审" if len(ok) == 1 else "")
        else:
            err = "仅一位参加，未形成多方会审"
        save(status="done" if all_ok else "failed", end=time.time(), final=final, error=err, same_backend=same)
        print(final)
        eprint("[hub] 会审结束：%d/%d 位答复。过程记录：%s" % (len(ok), len(tasks), run_dir))
        return 0 if all_ok else 1


# ---------------------------------------------------------------- 主联络窗口：用户只跟一位「联络人」说话


DISPATCH_RE = re.compile(r"\s*【派活】\s*(?P<how>自动分工|会审)\s*(?:[（(](?P<who>[^）)]{1,60})[）)])?\s*[:：]\s*(?P<goal>\S[\s\S]*)")

CHAT_PROMPT = USER_STYLE + """

你负责在 Hub 对接用户，团队成员有：{team}。用户只与你交谈。

简单的事自己做，不必派活：闲聊、翻译、小问答、解释，以及几分钟内能做完的小动手活，比如看一两个文件、跑几条命令核查、打开一个网页看看、改一处小地方。{perm_note}
只有要大量查阅、改很多文件、几块工作并行，或预计要十几分钟以上的活，才交给团队。

