FOLDERS_PATH = os.path.join(HUB_HOME, "folders.json")
_folders_lock = threading.Lock()


def load_folders():
    """左栏的文件夹：{"folders": [{id, name}], "of": {项目组键: 文件夹 id}}。"""
    d = read_json(FOLDERS_PATH)
    d = d if isinstance(d, dict) else {}
    fs = [f for f in d.get("folders") or [] if isinstance(f, dict) and isinstance(f.get("id"), str) and isinstance(f.get("name"), str)]
    ids = set(f["id"] for f in fs)
    of = {k: v for k, v in (d.get("of") or {}).items() if isinstance(k, str) and v in ids}
    return {"folders": fs, "of": of}


def folder_op(body):
    """建 / 改名 / 删文件夹，或把项目组放进某个文件夹（folder 为空=拿出来）。删文件夹不删里面的记录。"""
    op = body.get("op")

    def clean(n):
        if not isinstance(n, str) or not n.strip() or len(n) > 40:
            raise ValueError("文件夹名字要 1～40 个字")
        return re.sub(r"[\x00-\x1f\x7f]", "", n).strip()
    with _folders_lock:
        d = load_folders()
        ids = set(f["id"] for f in d["folders"])
        if op == "create":
            fid = "f_" + uuid.uuid4().hex[:8]
            d["folders"].append({"id": fid, "name": clean(body.get("name"))})
            keys = body.get("keys") or []
        elif op in ("rename", "delete"):
            fid = body.get("id")
            if fid not in ids:
                raise ValueError("没有这个文件夹")
            if op == "rename":
                next(f for f in d["folders"] if f["id"] == fid)["name"] = clean(body.get("name"))
            else:
                d["folders"] = [f for f in d["folders"] if f["id"] != fid]
                d["of"] = {k: v for k, v in d["of"].items() if v != fid}
            keys = []
        elif op == "move":
            fid = body.get("folder") or ""
            if fid and fid not in ids:
                raise ValueError("没有这个文件夹")
            keys = body.get("keys") or []
        else:
            raise ValueError("不认识的操作")
        if not isinstance(keys, list) or len(keys) > 500:
            raise ValueError("记录不对")
        for k in keys:
            if not isinstance(k, str) or not _ARCHIVE_KEY.match(k):
                raise ValueError("记录不对")
            if fid:
                d["of"][k] = fid
            else:
                d["of"].pop(k, None)
        write_json(FOLDERS_PATH, d)
        return fid


def clean_title(t):
    t = (t or "").strip().splitlines()[0] if (t or "").strip() else ""
    t = re.sub(r"[\x00-\x1f\x7f]", "", t).strip(" \t\"'“”‘’「」『』《》【】。，、：:；;！!？?.#*`")
    return t[:24]


def set_name(key, name, auto=False):
    if not isinstance(key, str) or not _ARCHIVE_KEY.match(key):
        raise ValueError("记录不对")
    if not isinstance(name, str) or len(name) > 60:
        raise ValueError("名字最多 60 个字")
    name = re.sub(r"[\x00-\x1f\x7f]", "", name).strip()
    with _names_lock:
        d = load_names_raw()
        cur = d["names"].get(key) if isinstance(d["names"].get(key), dict) else None
        if auto and cur and not cur.get("auto"):
            return  # 自动起名不覆盖你手动改的
        if name:
            d["names"][key] = {"name": name, "auto": bool(auto), "ts": time.time()}
        else:
            d["names"].pop(key, None)
        d.setdefault("since", time.time())
        write_json(NAMES_PATH, d)


def title_candidates(calls, runs):
    """还没名字、已经做完、是一个项目组开头的记录（新对话或分叉；旁问、画图、团队内部调用不算），最新的在前。"""
    d = load_names_raw()
    since = d.get("since")
    if since is None:  # 第一次：只给以后的新项目组起名，旧的要在设置里点「给已有的起名」
        set_name_since(time.time())
        return []
    archived = set(load_archived())
    out = []
    for kind, recs in (("call", calls), ("run", runs)):
        for r in recs:
            key = "%s:%s" % (kind, r.get("id"))
            if key in d["names"] or d["failed"].get(key, 0) >= 2 or key in archived:
                continue
            if r.get("status") in ("running", "planning", "synthesizing", None) or (r.get("start") or 0) < since:
                continue
            if (r.get("follows") and not r.get("fork")) or r.get("parent_call"):
                continue
            if kind == "call" and (r.get("parent") or r.get("run") or r.get("kind") not in ("ask", "chat")):
                continue
            out.append((r.get("start") or 0, key))
    return [k for _, k in sorted(out, reverse=True)]


def set_name_since(ts):
