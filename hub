def hub_depth():
    try:
        return int(os.environ.get("HUB_DEPTH") or 0)
    except ValueError:
        return 0


def clean_env(extra=None):
    """子进程环境：去掉当前 Claude 会话注入的变量，避免子 agent 误继承；并传递嵌套层数。"""
    env = {k: v for k, v in os.environ.items()
           if not (k.startswith("CLAUDE") or k.startswith("ANTHROPIC_"))}
    env["HUB_DEPTH"] = str(hub_depth() + 1)
    env.pop("HUB_META", None)
    if getattr(_ctx, "call_id", None):
        env["HUB_PARENT"] = _ctx.call_id
    if getattr(_ctx, "run_id", None):
        env["HUB_RUN"] = _ctx.run_id
    parts = [os.path.join(HOME, ".local/bin")] + env.get("PATH", "").split(os.pathsep)
    # 从 Hub.app 启动时 PATH 很短：补上常见目录，不然 npm 装的命令行（#!/usr/bin/env node）找不到 node
    parts += [os.path.join(HOME, d) for d in BIN_DIRS] + list(SYS_BIN_DIRS) + (_SHELL_PATH.get("v") or "").split(os.pathsep)
    env["PATH"] = os.pathsep.join(dict.fromkeys(filter(None, parts)))
    if os.environ.get("HUB_READONLY") == "1" or not getattr(_ctx, "write", True):
        env["HUB_READONLY"] = "1"  # 只读任务里队友再调 hub 也只能只读（会审等不能被绕成可写）
    if extra:
        env.update(extra)
    return env


class BackendError(Exception):
    pass


_children = set()  # 正在运行的子进程，收到停止信号时一并结束
_stopping = threading.Event()  # 收到停止信号后不再启动任何新进程（包括后备模型）


def _kill_tree(p, sig=signal.SIGTERM):
    try:
        os.killpg(p.pid, sig)
    except OSError:
        try:
            p.send_signal(sig)
        except OSError:
            pass


def _on_stop(signum, frame):
    _stopping.set()
    for kid in list(_active_keeps):
        keep_close(kid)  # 空闲会话继续常驻，正在回答的会话必须一并停止
    deadline = time.time() + 3
    seen = set()
    while time.time() < deadline:
        procs = list(_children)  # 每轮重新取：别的线程可能刚刚启动了进程
        for p in procs:
            if p not in seen:
                _kill_tree(p)
                seen.add(p)
        if not any(p.poll() is None for p in procs):
            break
        time.sleep(0.1)
    for p in list(_children) + list(seen):
        _kill_tree(p, signal.SIGKILL)
        try:
            p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            pass
    os._exit(130 if signum == signal.SIGINT else 143)


class Live(object):
    """把进行中的输出实时写到 calls/<id>.live，供面板显示。"""

    def __init__(self):
        cid = getattr(_ctx, "call_id", None)
        self.path = os.path.join(CALLS_DIR, cid + ".live") if cid else None
        self.text, self.steps, self.last = "", [], 0.0
        self.lock = threading.RLock()
        self.timer = None
        self.closed = False

    def add(self, delta):
        self.text += delta
        self.flush()

    def step(self, line):
        line = " ".join(str(line).split())[:200]
        if line and (not self.steps or self.steps[-1] != line):
            self.steps.append(line)
            self.steps = self.steps[-40:]
            self.flush(True)

    def flush(self, force=False):
        with self.lock:
            if self.closed or not self.path:
                return
            if force or time.time() - self.last > 0.6:
                self.last = time.time()
                write_json(self.path, {"text": self.text[-20000:], "steps": self.steps})
            elif self.timer is None or not self.timer.is_alive():
                self.timer = threading.Timer(0.6, lambda: self.flush(True))
                self.timer.daemon = True
                self.timer.start()

    def close(self):
        with self.lock:
            if self.text.strip():
                _ctx.partial = self.text[-20000:]  # 失败或超时时，已经写出来的部分回答留给记录
            self.closed = True
            if self.timer:
                self.timer.cancel()
            if self.path:
                try:
                    os.unlink(self.path)
                except OSError:
                    pass


WATCHDOG_PREFIXES = ("卡住了（", "空转（", "超时（到总上限 ")


SPIN_RUN = 12     # 同一个工具、同样的参数接连调用这么多次（中间没做别的）才算空转
SPIN_TOTAL = 30   # 两次改文件之间，同一个调用累计这么多次也算（防止两三件事来回绕圈）
_EDIT_TOOL = re.compile(r"edit|write|replace|patch|create_file|insert", re.I)


class Watchdog(object):
    """软时限后允许继续干活；只因没动静、反复调用同一工具或到总上限而停。
    改文件的工具不算空转：Antigravity 报上来的只有文件路径，看不出每次改的内容不同，分块改同一个大文件是正常干活。
    「动静」除了输出，也看 paths 里的文件（如 agy 自己的日志）有没有更新：模型长时间思考或内部重试时不往外报进度，但还活着。"""

    def __init__(self, cfg, timeout, streaming=True):
        self.hard_timeout = max(timeout, cfg.get("hard_timeout", DEFAULT_CONFIG["hard_timeout"]))
        self.idle_timeout = cfg.get("idle_timeout", DEFAULT_CONFIG["idle_timeout"])
        self.streaming = streaming
        self.start = self.last = time.monotonic()
        self.tools, self.error = {}, None
        self.run_key, self.run_len = None, 0
        self.paths, self._mtimes, self._polled = [], {}, 0.0
        self.lock = threading.Lock()

    def touch(self):
        with self.lock:
            self.last = time.monotonic()

    def tool(self, name, params):
        arg = json.dumps(params, ensure_ascii=False, sort_keys=True)
        key = (name, arg)
        with self.lock:
            if key == self.run_key:
                self.run_len += 1
            else:
                self.run_key, self.run_len = key, 1
            if _EDIT_TOOL.search(name or ""):  # 改了文件就是有进展：之后再跑同样的测试、读同样的文件都正常
                self.tools.clear()
                return
            self.tools[key] = self.tools.get(key, 0) + 1
            if (self.run_len >= SPIN_RUN or self.tools[key] >= SPIN_TOTAL) and not self.error:
                detail = " ".join((name + " " + arg).split())[:160]
                self.error = "空转（反复做同一件事：%s）" % detail

    def _poll_paths(self, now):
        """每隔几秒看一眼日志之类的文件，有更新就算有动静。"""
        if not self.paths or now - self._polled < 2:
            return
        self._polled = now
        for p in self.paths:
            try:
                m = os.stat(p).st_mtime_ns
            except OSError:
                continue
            if self._mtimes.get(p) not in (None, m):
                self.last = now
            self._mtimes[p] = m

    def check(self):
        """检查后返回下一段最多等多久；流式回调只记状态，由调用线程停进程。"""
        with self.lock:
            now = time.monotonic()
            self._poll_paths(now)
            hard_left = self.start + self.hard_timeout - now
            idle_left = self.last + self.idle_timeout - now
            if self.error:
                raise BackendError(self.error)
            if hard_left <= 0:
                raise BackendError("超时（到总上限 %d 分钟）" % max(1, round(self.hard_timeout / 60)))
            if self.streaming and idle_left <= 0:
                raise BackendError("卡住了（%d 分钟没有任何动静）" % max(1, round(self.idle_timeout / 60)))
            return min(0.2, hard_left, idle_left) if self.streaming else min(0.2, hard_left)


def _run(cmd, cwd, env, timeout, stdin_text=None, on_line=None, watch=None):
    if _stopping.is_set():
        raise BackendError("已手动停止")
    try:
        p = subprocess.Popen(cmd, cwd=cwd, env=env, text=True, errors="replace",
                             stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    except OSError as e:
        raise BackendError("无法启动 %s：%s" % (os.path.basename(cmd[0]), e))
    _children.add(p)
    outs, errs = [], []

    def pump(stream, chunks, callback=None):
        try:
            for line in stream:
                chunks.append(line)
                if watch:
                    watch.touch()
                if callback:
                    try:
                        callback(line)
                    except Exception:
                        pass
        finally:
            stream.close()

    def feed():
        try:
            with p.stdin:
                p.stdin.write(stdin_text)
        except (OSError, ValueError):
            pass

    ths = [threading.Thread(target=pump, args=(p.stdout, outs, on_line), daemon=True),
           threading.Thread(target=pump, args=(p.stderr, errs), daemon=True)]
    if stdin_text is not None:
        ths.append(threading.Thread(target=feed, daemon=True))
    deadline = time.monotonic() + timeout

    def wait_time():
        if _stopping.is_set():
            raise BackendError(STOP_MSG)
        interval = watch.check() if watch else 0.2
        left = deadline - time.monotonic()
        if left <= 0:
            raise subprocess.TimeoutExpired(cmd, timeout)
        return min(interval, left)

    try:
        if _stopping.is_set():
            raise BackendError(STOP_MSG)
        for t in ths:
            t.start()
        while True:
            interval = wait_time()
            try:
                p.wait(timeout=interval)
                break
            except subprocess.TimeoutExpired:
                pass
        for t in ths:
            while t.is_alive():
                t.join(wait_time())
        if watch:
            watch.check()
    except BaseException as e:
        _kill_tree(p)
        try:
            p.wait(timeout=1)
        except subprocess.TimeoutExpired:
            pass
        # 组长退出不等于子孙退出；继承输出管道的子进程也必须回收。
        _kill_tree(p, signal.SIGKILL)
        p.wait()
        for t in ths:
            if t.ident is not None:
                t.join(2)
        if isinstance(e, subprocess.TimeoutExpired):
            raise BackendError("超时（%ss）" % timeout)
        raise
    finally:
        for stream, t in zip((p.stdout, p.stderr, p.stdin), ths):
            if stream is not None and not t.is_alive():
                stream.close()
        _children.discard(p)
    return p.returncode, "".join(outs), "".join(errs)


def is_agy_claude(spec):
    """agy:claude-… —— 通过 Antigravity 用的 Claude 模型（额度和 Gemini 分开算）。"""
    return (spec or "").startswith("agy:claude-")


def spec_label(spec):
    """后端写法 → 给人看的名字，例如 agy:gemini-4-carbon-medium → Gemini Carbon·中等。"""
    kind, _, mdl = (spec or "").partition(":")
    m = mdl.lower()
    if kind == "agy":
        lv = re.match(r"^(.*?)-(xhigh|high|medium|low|max)$", m)
        base, level = (lv.group(1), {"xhigh": "超高", "high": "高", "medium": "中等", "low": "低", "max": "最高"}[lv.group(2)]) if lv else (m, "")
        if base.startswith("claude-"):
            ver = re.match(r"^claude-([a-z]+)-(\d+)-(\d+)$", base)
            name = ("Claude %s %s.%s" % (ver.group(1).capitalize(), ver.group(2), ver.group(3))) if ver else ("Claude " + base[7:])
            return name + ("·" + level if level else "") + "（Antigravity）"
        fam = next((w.capitalize() for w in ("carbon", "argon", "hydrogen", "flash", "orchestrator") if w in base), "")
        name = ("Gemini " + fam) if fam else ("Gemini " + mdl if mdl else "Gemini")
        return name + ("·" + level if level else "")
    if kind == "codex":
        return "GPT" + ("（%s）" % mdl if mdl else "")
    if kind == "dsh":
        return "DeepSeek"
    if kind == "claude":
        return "Claude" + (" " + mdl.capitalize() if mdl else "")
    return spec or "未知模型"


