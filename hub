            out = [(str(x.get("effort")), str(x.get("description") or "")) for x in m.get("supported_reasoning_levels") or []
                   if isinstance(x, dict) and _EFFORT_ID.match(str(x.get("effort") or ""))]
            if out:
                return out
    return [(e, "") for e in CODEX_EFFORTS_FALLBACK]


def effort_levels(spec):
    """这个后端/模型能选的思考档位名单；空列表=不能单独调（Gemini 的档位写在模型名里，DeepSeek 不支持）。"""
    kind, _, mdl = (spec or "").partition(":")
    if kind == "codex":
        return [e for e, _ in codex_model_efforts(mdl)]
    if kind == "claude":
        return list(CLAUDE_EFFORTS)
    return []


def agent_effort(cfg, agent, spec):
    """这位成员用这个模型时的思考档位；""=不指定。卡片上设过（哪怕设成默认）就以卡片为准，否则 GPT 沿用旧的 codex_effort。
    模型不支持这一档（比如换成了备用模型）就不传，让它用自己的默认。"""
    eff = cfg.get("effort") if isinstance(cfg.get("effort"), dict) else {}
    kind = (spec or "").partition(":")[0]
    if agent in eff:
        e = eff.get(agent) or ""
    else:
        e = (cfg.get("codex_effort") or "") if kind == "codex" else ""
    return e if e and e in effort_levels(spec) else ""


