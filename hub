def active_cfg(cfg):
    """去掉停用的成员和模型后的配置。所有真正干活的命令都用它，于是排工、会审、自动对接、备用模型都只看得到启用的。"""
    dis_a = set(x for x in cfg.get("disabled_agents") or [] if isinstance(x, str))
    dis_m = set(x for x in cfg.get("disabled_models") or [] if isinstance(x, str))
    if not dis_a and not dis_m:
        return cfg
    c = dict(cfg)
    agents = {}
    for n, chain in cfg["agents"].items():
        ch = [x for x in chain if x not in dis_m]
        if n not in dis_a and ch:
            agents[n] = ch
    c["agents"] = agents
    c["_disabled_agents"] = [n for n in cfg["agents"] if n not in agents]
    pref = [x for x in ("gemini", "gpt", "ds", "claude") if x in agents] + [x for x in agents if x not in ("gemini", "gpt", "ds", "claude")]
    for k in ("planner", "synthesizer", "default_worker"):
        if c.get(k) not in agents and pref:
            c[k] = pref[0]
    if c.get("auto_title") and c["auto_title"] not in agents:  # 选的起名人停用了：换一位启用的接手（""=用户关了起名，不补）
        c["auto_title"] = next((x for x in ("ds", "gemini", "gpt", "claude") if x in agents), next(iter(agents), ""))
    c["council_agents"] = [x for x in cfg.get("council_agents") or [] if x in agents]
    return c


