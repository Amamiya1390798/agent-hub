def cmd_ui(cfg, args):
    url = "http://127.0.0.1:%d/" % args.port
    me = os.path.abspath(sys.argv[0])
    if args.stop:
        pid = (read_json(UI_PID) or {}).get("pid")
        try:
            cmdline = subprocess.check_output(["ps", "-o", "command=", "-p", str(pid)], text=True) if pid else ""
        except (OSError, subprocess.CalledProcessError):
            cmdline = ""
        if pid and pid_alive(pid) and "ui --serve" in cmdline:
            os.kill(int(pid), signal.SIGTERM)
            eprint("[hub] 面板服务已停止。")
        else:
            eprint("[hub] 面板服务没有在运行。")
        return 0
    if not args.serve:
        if not port_open(args.port):
            logf = open(os.path.join(HUB_HOME, "ui-server.log"), "a", encoding="utf-8")
            env = {k: v for k, v in os.environ.items() if not k.startswith("HUB_") or k == "HUB_HOME"}
            subprocess.Popen([sys.executable, me, "ui", "--serve", "--port", str(args.port)],
                             stdin=subprocess.DEVNULL, stdout=logf, stderr=logf, env=env,
                             cwd=HOME, start_new_session=True)
            for _ in range(50):
                if port_open(args.port):
                    break
                time.sleep(0.1)
            else:
                eprint("[hub] 面板服务没能启动，详见 %s" % os.path.join(HUB_HOME, "ui-server.log"))
                return 1
        if args.no_window:
            return 0
        if not args.browser and os.path.isdir(NATIVE_APP) and args.port == 8765:  # 有独立应用就用它（自带程序坞图标）
            subprocess.call(["open", "-a", NATIVE_APP])
            return 0
        if open_windows(args.port) > 0:  # 已经有窗口了：只把它调到前面，不再新开
            eprint("[hub] 面板窗口已经开着，已切到前台：%s" % url)
            app = None if args.browser else panel_app()
            if app:
                subprocess.call(["open", "-a", app])
            return 0
        eprint("[hub] 面板：%s （在后台运行；停止用 hub ui --stop）" % url)
        open_panel(url, args.browser)
        return 0
    return serve_ui(args.port, me)


