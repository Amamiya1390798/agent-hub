    return [k for k in keys if isinstance(k, str) and _ARCHIVE_KEY.match(k)] if isinstance(keys, list) else []


def set_archived(keys, on):
    if not isinstance(keys, list) or not keys or len(keys) > 500 or not isinstance(on, bool):
        raise ValueError("归档请求格式不对")
    for k in keys:
        if not isinstance(k, str) or not _ARCHIVE_KEY.match(k):
            raise ValueError("归档请求格式不对")
    with _archive_lock:
        cur = load_archived()
        if on:
            cur = cur + [k for k in keys if k not in cur]
        else:
            drop = set(keys)
            cur = [k for k in cur if k not in drop]
        write_json(ARCHIVE_PATH, {"keys": cur[-5000:]})


def stop_record(kind, rid):
    r = ui_record(kind, rid)
    if not r:
        return "没有这条记录"
    pid = r.get("pid")
    if r.get("status") not in ("running", "planning", "synthesizing") or not pid_alive(pid):
        return "它已经不在运行了"
    if int(pid) == os.getpid():
        return "不能停止面板自己"
    try:
        cmdline = subprocess.check_output(["ps", "-o", "command=", "-p", str(pid)], text=True)
    except (OSError, subprocess.CalledProcessError):
        cmdline = ""
    if not re.search(r"(^|/)hub (run|ask|image|council|chat)\b", cmdline):
        return "进程对不上，为安全起见没有停止"
    try:
        os.kill(int(pid), signal.SIGTERM)
    except OSError as e:
        return "停止失败：%s" % e
    for _ in range(50):
        if not pid_alive(pid):
            break
        time.sleep(0.1)
    else:
        try:
            os.kill(int(pid), signal.SIGKILL)
        except OSError:
            pass
        time.sleep(0.3)
    now = time.time()
    if kind == "run":
        p = os.path.join(RUNS_DIR, rid, "run.json")
        d = read_json(p)
        if d:
            _fail_tasks(d)
            d.update(status="failed", error=STOP_MSG, end=now)
            write_json(p, d)
            write_board_md(os.path.join(RUNS_DIR, rid), d)
    else:  # 停止对话时，它派出的项目组（同一个进程）也标成「已停止」
        try:
            names = os.listdir(RUNS_DIR)
        except OSError:
            names = []
        for name in names:
            p = os.path.join(RUNS_DIR, name, "run.json")
            d = read_json(p)
            if (isinstance(d, dict) and d.get("pid") == pid
                    and (d.get("status") in ("planning", "running", "synthesizing") or d.get("error") == DEAD_MSG)):
                _fail_tasks(d)
                d.update(status="failed", error=STOP_MSG, end=now)
                write_json(p, d)
                write_board_md(os.path.join(RUNS_DIR, name), d)
    for c in load_calls():
        if c.get("pid") == pid and c.get("status") == "fail" and c.get("error") == DEAD_MSG:
            d = read_json(os.path.join(CALLS_DIR, c["id"] + ".json"))
            if d and d.get("status") == "fail" and d.get("error") == DEAD_MSG:
                d.update(status="fail", error=STOP_MSG, end=now, secs=round(now - (d.get("start") or now), 1))
                write_json(os.path.join(CALLS_DIR, c["id"] + ".json"), d)
    return None


